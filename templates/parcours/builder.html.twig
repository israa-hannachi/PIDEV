{% extends 'naja7ni/base.html.twig' %}

{% block title %}Naja7ni - Mon parcours{% endblock %}

{% block body %}
    <div
        data-controller="parcours-builder"
        data-parcours-builder-save-url-value="{{ path('app_parcours_save') }}"
        data-parcours-builder-token-value="{{ csrf_token }}"
        data-parcours-builder-state-value='{{ (state ?? {})|json_encode|e('html_attr') }}'
    >
        {% set _g = app.session.get('gamification')|default({}) %}
        {% set _xp = _g.xp|default(0) %}
        {% set _badges = _g.badges|default([]) %}

        <div class="mb-6">
            <div class="p-5 rounded-2xl border border-border bg-white shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-sm text-muted-foreground">XP</div>
                        <div class="text-2xl font-bold">{{ _xp }}</div>
                    </div>
                    <div class="text-right">
                        <div class="text-sm text-muted-foreground">Badges</div>
                        <div class="text-sm font-semibold">{{ _badges|length }}</div>
                    </div>
                </div>

                {% if _badges is iterable and _badges|length > 0 %}
                    <div class="mt-3 flex flex-wrap gap-2">
                        {% for b in _badges %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full bg-accent/15 border border-accent/30 text-xs font-semibold">
                                {{ b|replace({'_': ' '})|title }}
                            </span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <form method="post" action="{{ path('app_parcours_save') }}" data-parcours-builder-target="form" data-action="submit->parcours-builder#prepareSubmit">
            <input type="hidden" name="_token" value="{{ csrf_token }}">
            <input type="hidden" name="moduleOrder" value="" data-parcours-builder-target="moduleOrderField">
            <input type="hidden" name="coursOrder" value="" data-parcours-builder-target="coursOrderField">
            <input type="hidden" name="coursMeta" value="" data-parcours-builder-target="coursMetaField">

        <div class="mb-8 flex items-start justify-between gap-6">
            <div>
                <div class="flex items-center gap-4 mb-2">
                    <div class="w-12 h-12 bg-accent/20 text-accent rounded-xl flex items-center justify-center">
                        <i data-lucide="route" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold">Mon parcours</h1>
                        <p class="text-sm text-muted-foreground">Glisse-dépose les modules et réorganise les cours pour créer ta roadmap personnalisée.</p>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <button
                    type="submit"
                    class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary text-white font-semibold shadow hover:shadow-md transition"
                >
                    <i data-lucide="save" class="w-4 h-4"></i>
                    Sauvegarder
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6"
    >
        <div class="lg:col-span-2">
            <div class="bg-white rounded-2xl shadow-sm border border-border p-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-lg font-bold">Modules</h2>
                    <span class="text-xs text-muted-foreground">Drag & Drop</span>
                </div>

                <div data-parcours-builder-target="modules" class="space-y-4">
                    {% for module in modules %}
                        <div class="rounded-2xl border border-border bg-muted/10" data-parcours-module="1" data-module-id="{{ module.id }}" data-module-titre="{{ module.titre }}">
                            <div class="px-5 py-4 flex items-center justify-between gap-4">
                                <div class="flex items-center gap-3">
                                    <span class="parcours-handle-module cursor-grab inline-flex items-center justify-center w-9 h-9 rounded-xl bg-secondary/10 text-secondary">
                                        <i data-lucide="grip-vertical" class="w-5 h-5"></i>
                                    </span>
                                    <div>
                                        <div class="font-semibold">{{ module.titre }}</div>
                                        <div class="text-xs text-muted-foreground">{{ module.cours|length }} cours</div>
                                    </div>
                                </div>
                                <a href="{{ path('app_module_show', {'id': module.id}) }}" class="text-sm font-semibold text-primary hover:underline">Voir</a>
                            </div>

                            <div class="px-5 pb-5">
                                <div class="text-xs font-semibold text-muted-foreground mb-2">Cours</div>
                                <div data-parcours-builder-target="coursList" data-module-id="{{ module.id }}" class="space-y-2">
                                    {% for cour in module.cours %}
                                        {% set _meta = (state.coursMeta[cour.id] ?? {}) %}
                                        {% set _statut = _meta.statut|default('todo') %}
                                        {% set _objectif = _meta.objectif|default('') %}
                                        {% set _notes = _meta.notes|default('') %}
                                        <div class="flex items-center justify-between gap-4 p-3 rounded-xl bg-white border border-border" data-parcours-cours="1" data-cours-id="{{ cour.id }}" data-cours-titre="{{ cour.titre }}">
                                            <div class="flex-1 min-w-0">
                                                <div class="flex items-center gap-2">
                                                <span class="parcours-handle-cours cursor-grab text-muted-foreground">
                                                    <i data-lucide="grip" class="w-4 h-4"></i>
                                                </span>
                                                <span class="text-sm font-semibold">{{ cour.titre }}</span>
                                            </div>

                                                <div class="mt-3 grid grid-cols-1 md:grid-cols-3 gap-3">
                                                    <div>
                                                        <label class="block text-xs font-semibold text-muted-foreground mb-1">Statut</label>
                                                        <select data-parcours-builder-target="statut" data-cours-id="{{ cour.id }}" class="w-full px-3 py-2 rounded-xl bg-input-background border border-border text-sm">
                                                            <option value="todo" {{ _statut == 'todo' ? 'selected' : '' }}>À faire</option>
                                                            <option value="doing" {{ _statut == 'doing' ? 'selected' : '' }}>En cours</option>
                                                            <option value="done" {{ _statut == 'done' ? 'selected' : '' }}>Terminé</option>
                                                        </select>
                                                    </div>
                                                    <div class="md:col-span-2">
                                                        <label class="block text-xs font-semibold text-muted-foreground mb-1">Objectif</label>
                                                        <input data-parcours-builder-target="objectif" data-cours-id="{{ cour.id }}" value="{{ _objectif }}" class="w-full px-3 py-2 rounded-xl bg-input-background border border-border text-sm" placeholder="Ex: Comprendre les bases..." />
                                                    </div>
                                                </div>

                                                <div class="mt-3">
                                                    <label class="block text-xs font-semibold text-muted-foreground mb-1">Notes</label>
                                                    <textarea data-parcours-builder-target="notes" data-cours-id="{{ cour.id }}" rows="2" class="w-full px-3 py-2 rounded-xl bg-input-background border border-border text-sm" placeholder="Tes notes...">{{ _notes }}</textarea>
                                                </div>
                                            </div>
                                            <a href="{{ path('app_cours_show', {'id': cour.id}) }}" class="text-sm text-primary font-semibold hover:underline">Voir</a>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <div>
            <div class="bg-white rounded-2xl shadow-sm border border-border p-6">
                <h2 class="text-lg font-bold mb-4">Roadmap</h2>

                <div data-parcours-builder-target="roadmap" class="space-y-3">
                    <div class="p-4 rounded-xl border border-border bg-muted/10 text-sm text-muted-foreground">
                        Sauvegarde ton ordre pour générer une roadmap.
                    </div>
                </div>
            </div>
        </div>
        </div>
        </form>
    </div>
{% endblock %}
