{% extends 'base.html.twig' %}

{% block title %}<title>NAJA7NI || Email Queue</title>{% endblock %}

{% block body %}
    {% include 'partials/_sidebar.html.twig' %}
    {% include 'partials/_header.html.twig' %}

    <main class="nxl-container">
        <div class="nxl-content">
            <div class="page-header">
                <div class="page-header-left d-flex align-items-center">
                    <div class="page-header-title"><h5 class="m-b-10">Email Queue</h5></div>
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('mailing_dashboard') }}">Mailing</a></li>
                        <li class="breadcrumb-item">Queue</li>
                    </ul>
                </div>
            </div>

            <div class="main-content">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger">{{ message }}</div>
                {% endfor %}

                <div class="card stretch stretch-full mb-3">
                    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="btn-group">
                            <a href="{{ path('mailing_queue') }}" class="btn btn-light {{ status is not defined or not status ? 'active' : '' }}">All</a>
                            <a href="{{ path('mailing_queue', {status: 'pending'}) }}" class="btn btn-light {{ status == 'pending' ? 'active' : '' }}">Pending</a>
                            <a href="{{ path('mailing_queue', {status: 'sent'}) }}" class="btn btn-light {{ status == 'sent' ? 'active' : '' }}">Sent</a>
                            <a href="{{ path('mailing_queue', {status: 'failed'}) }}" class="btn btn-light {{ status == 'failed' ? 'active' : '' }}">Failed</a>
                        </div>
                        <form method="post" action="{{ path('mailing_send_pending') }}" class="d-flex gap-2">
                            <input type="number" min="1" name="limit" value="50" class="form-control" style="width: 100px;">
                            <button type="submit" class="btn btn-primary">Send Pending</button>
                        </form>
                    </div>
                </div>

                <div class="card stretch stretch-full">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Email</th>
                                        <th>Subject</th>
                                        <th>Status</th>
                                        <th>Attempts</th>
                                        <th>Error</th>
                                        <th>Created</th>
                                        <th>Sent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for item in emails %}
                                    <tr>
                                        <td>{{ item.recipientEmail }}</td>
                                        <td>{{ item.subject }}</td>
                                        <td>
                                            {% if item.status == 'sent' %}
                                                <span class="badge bg-soft-success text-success">sent</span>
                                            {% elseif item.status == 'failed' %}
                                                <span class="badge bg-soft-danger text-danger">failed</span>
                                            {% else %}
                                                <span class="badge bg-soft-warning text-warning">pending</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ item.attempts }}</td>
                                        <td>{{ item.errorMessage ?: '-' }}</td>
                                        <td>{{ item.createdAt ? item.createdAt|date('Y-m-d H:i') : '-' }}</td>
                                        <td>{{ item.sentAt ? item.sentAt|date('Y-m-d H:i') : '-' }}</td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">No queued emails found.</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
