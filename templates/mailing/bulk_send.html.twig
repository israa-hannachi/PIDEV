{% extends 'base.html.twig' %}

{% block title %}<title>NAJA7NI || Bulk Email Send</title>{% endblock %}

{% block body %}
    {% include 'partials/_sidebar.html.twig' %}
    {% include 'partials/_header.html.twig' %}

    <main class="nxl-container">
        <div class="nxl-content">
            <div class="page-header">
                <div class="page-header-left d-flex align-items-center">
                    <div class="page-header-title"><h5 class="m-b-10">Bulk Email Send</h5></div>
                    <ul class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('mailing_dashboard') }}">Mailing</a></li>
                        <li class="breadcrumb-item">Bulk Send</li>
                    </ul>
                </div>
            </div>

            <div class="main-content">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger">{{ message }}</div>
                {% endfor %}

                <div class="card stretch stretch-full">
                    <div class="card-header">
                        <h5 class="card-title mb-0">Queue Bulk Emails From Template</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" action="{{ path('mailing_bulk_send') }}">
                            <div class="mb-3">
                                <label class="form-label">Template</label>
                                <select name="template_name" class="form-select" required>
                                    <option value="">Select template</option>
                                    {% for template in templates %}
                                        <option value="{{ template.name }}" {{ old.template_name == template.name ? 'selected' : '' }}>{{ template.name }} - {{ template.subject }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Recipients</label>
                                <textarea name="recipients" rows="8" class="form-control" placeholder="email@example.com, Full Name&#10;user2@example.com, User Two" required>{{ old.recipients }}</textarea>
                                <small class="text-muted">One recipient per line: <strong>email, name</strong> (name optional).</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Login URL (optional)</label>
                                <input type="url" name="login_url" class="form-control" placeholder="https://example.com/login" value="{{ old.login_url }}">
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Queue Emails</button>
                                <a href="{{ path('mailing_queue') }}" class="btn btn-light">View Queue</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>
{% endblock %}
