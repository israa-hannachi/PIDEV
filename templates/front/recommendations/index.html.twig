{% extends 'front/events/base_front.html.twig' %}

{% block title %}Recommandé pour vous - Naja7ni{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-12">
    <div class="flex items-center gap-4 mb-10">
        <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary shadow-sm">
            <i data-lucide="sparkles" class="w-7 h-7"></i>
        </div>
        <div>
            <h1 class="text-3xl font-extrabold text-foreground" style="font-family: 'Clash Display', sans-serif;">Recommandé Pour Vous</h1>
            <p class="text-muted-foreground text-sm font-medium">Événements sélectionnés par notre IA selon votre profil.</p>
        </div>
    </div>

    {% if recommendations %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {% for rec in recommendations %}
                {% set event = rec.event %}
                <div class="bg-white rounded-3xl border border-border overflow-hidden group hover:shadow-2xl hover:shadow-primary/10 transition-all duration-500 hover:-translate-y-2">
                    <div class="relative h-48 overflow-hidden">
                        {% if event.image %}
                            <img src="{{ asset(event.image) }}" alt="{{ event.titre }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                        {% else %}
                            <div class="w-full h-full bg-muted flex items-center justify-center text-muted-foreground/30">
                                <i data-lucide="image" class="w-12 h-12"></i>
                            </div>
                        {% endif %}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        <div class="absolute top-4 right-4">
                            <span class="px-3 py-1.5 bg-white/95 backdrop-blur shadow-sm rounded-xl text-[10px] font-bold text-primary border border-primary/10">
                                {{ event.categorie }}
                            </span>
                        </div>
                        <div class="absolute bottom-4 left-4">
                            <div class="flex items-center gap-2">
                                <div class="px-3 py-1 bg-primary text-white text-[10px] font-bold rounded-lg shadow-lg shadow-primary/20">
                                    {{ rec.matchScore }}% Match
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="p-6">
                        <h3 class="text-lg font-bold text-foreground mb-3 line-clamp-1 group-hover:text-primary transition-colors">{{ event.titre }}</h3>
                        <p class="text-xs text-muted-foreground line-clamp-2 mb-6 leading-relaxed">{{ event.description }}</p>
                        
                        <div class="space-y-3 mb-6">
                            <div class="flex items-center gap-3 text-muted-foreground">
                                <i data-lucide="calendar" class="w-4 h-4 text-primary/60"></i>
                                <span class="text-[11px] font-semibold">{{ event.dateDebut|date('d M, Y') }}</span>
                            </div>
                            <div class="flex items-center gap-3 text-muted-foreground">
                                <i data-lucide="map-pin" class="w-4 h-4 text-primary/60"></i>
                                <span class="text-[11px] font-semibold line-clamp-1">{{ event.lieu }}</span>
                            </div>
                            
                            <div class="pt-3 border-t border-dashed border-border mt-3">
                                <p class="text-[10px] font-bold text-indigo-600 uppercase tracking-wider mb-1">Pourquoi ce choix ?</p>
                                <p class="text-[10px] text-muted-foreground italic leading-tight">{{ rec.explanations[0] }}</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <a href="{{ path('app_front_event_show', {id: event.id}) }}" class="flex-1 py-3 bg-muted group-hover:bg-primary group-hover:text-white text-foreground text-center rounded-2xl text-xs font-bold transition-all active:scale-95 shadow-lg shadow-transparent group-hover:shadow-primary/20">
                                Voir Détails
                            </a>
                            <button onclick="notInterested({{ event.id }}, this)" class="p-3 bg-muted rounded-2xl hover:bg-red-50 hover:text-red-500 transition-all active:scale-90" title="Pas intéressé">
                                <i data-lucide="user-x" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-24 bg-muted/20 rounded-[40px] border-2 border-dashed border-border">
            <div class="w-20 h-20 bg-muted rounded-full flex items-center justify-center mx-auto mb-6 text-muted-foreground/40">
                <i data-lucide="sparkles" class="w-10 h-10"></i>
            </div>
            <h3 class="text-xl font-bold text-foreground mb-2">Pas de recommandations pour le moment</h3>
            <p class="text-muted-foreground mb-8 max-w-md mx-auto">Explorez des événements et participez pour aider notre IA à mieux comprendre vos préférences.</p>
            <a href="{{ path('app_front_events') }}" class="px-8 py-4 bg-primary text-white rounded-2xl font-bold shadow-xl shadow-primary/20 hover:scale-105 transition-all inline-block">
                Découvrir les événements
            </a>
        </div>
    {% endif %}
</div>

<script>
function notInterested(id, btn) {
    if (!confirm('Masquer cet événement des recommandations ?')) return;
    
    fetch(`/api/not-interested/${id}`, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    }).then(res => res.json()).then(data => {
        if (data.success) {
            const card = btn.closest('.group');
            card.style.opacity = '0';
            card.style.transform = 'scale(0.9)';
            setTimeout(() => card.remove(), 500);
        }
    });
}
</script>
{% endblock %}
