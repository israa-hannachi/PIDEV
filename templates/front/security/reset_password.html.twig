{% extends 'base_auth.html.twig' %}

{% block title %}Reset Password - naja7ni{% endblock %}

{% block body %}
<main>
	<section class="p-0 d-flex align-items-center position-relative overflow-hidden">
	
		<div class="container-fluid">
			<div class="row">
				<!-- left -->
				<div class="col-12 col-lg-6 d-md-flex align-items-center justify-content-center bg-primary bg-opacity-10 vh-lg-100">
					<div class="p-3 p-lg-5">
						<!-- Title -->
						<div class="text-center">
							<h2 class="fw-bold">Almost There!</h2>
							<p class="mb-0 h6 fw-light">Enter the code we sent to your email</p>
						</div>
						<!-- SVG Image -->
						<img src="{{ asset("assets/images/element/02.svg") }}" class="mt-5" alt="">
					</div>
				</div>

				<!-- Right -->
				<div class="col-12 col-lg-6 m-auto">
					<div class="row my-5">
						<div class="col-sm-10 col-xl-8 m-auto">
							<!-- Title -->
							<span class="mb-0 fs-1">🔐</span>
							<h1 class="fs-2">Reset Your Password</h1>
							<p class="lead mb-4">Check your email for the reset code (valid for 15 minutes).</p>

							<!-- Flash Messages -->
							{% for message in app.flashes('success') %}
								<div class="alert alert-success alert-dismissible fade show" role="alert">
									{{ message }}
									<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
								</div>
							{% endfor %}
							{% for message in app.flashes('error') %}
								<div class="alert alert-danger alert-dismissible fade show" role="alert">
									{{ message }}
									<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
								</div>
							{% endfor %}

							<!-- Form START -->
							{{ form_start(form) }}
								<input type="hidden" name="email" value="{{ email }}">
								
								<!-- Reset Code -->
								<div class="mb-4">
									{{ form_label(form.code, 'Reset Code', {'label_attr': {'class': 'form-label'}}) }}
									<div class="input-group input-group-lg">
										<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="fas fa-key"></i></span>
										{{ form_widget(form.code, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1', 'placeholder': 'Enter 6-digit code', 'maxlength': '6'}}) }}
									</div>
									{{ form_errors(form.code) }}
									<small class="text-muted">Check your email for the 6-digit code</small>
								</div>

								<!-- New Password -->
								<div class="mb-4">
									{{ form_label(form.password.first, null, {'label_attr': {'class': 'form-label'}}) }}
									<div class="input-group input-group-lg">
										<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="fas fa-lock"></i></span>
										{{ form_widget(form.password.first, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1'}}) }}
									</div>
									{{ form_errors(form.password.first) }}
								</div>

								<!-- Confirm Password -->
								<div class="mb-4">
									{{ form_label(form.password.second, null, {'label_attr': {'class': 'form-label'}}) }}
									<div class="input-group input-group-lg">
										<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="fas fa-lock"></i></span>
										{{ form_widget(form.password.second, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1'}}) }}
									</div>
									{{ form_errors(form.password.second) }}
								</div>

								<!-- Button -->
								<div class="align-items-center mt-0">
									<div class="d-grid">
										{{ form_widget(form.submit) }}
									</div>
								</div>
							{{ form_end(form) }}
							<!-- Form END -->

							<!-- Back to forgot password -->
							<div class="mt-4 text-center">
								<span>Didn't receive the code? <a href="{{ path('front_forgot_password') }}">Request a new one</a></span>
							</div>
						</div>
					</div> <!-- Row END -->
				</div>
			</div> <!-- Row END -->
		</div>
	</section>
</main>
{% endblock %}
