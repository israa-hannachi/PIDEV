{% extends 'base_auth.html.twig' %}

{% block title %}Forgot Password - naja7ni{% endblock %}

{% block body %}
<main>
	<section class="p-0 d-flex align-items-center position-relative overflow-hidden">
	
		<div class="container-fluid">
			<div class="row">
				<!-- left -->
				<div class="col-12 col-lg-6 d-md-flex align-items-center justify-content-center bg-primary bg-opacity-10 vh-lg-100">
					<div class="p-3 p-lg-5">
						<!-- Title -->
						<div class="text-center">
							<h2 class="fw-bold">Reset Your Password</h2>
							<p class="mb-0 h6 fw-light">We'll send you a code to reset your password</p>
						</div>
						<!-- SVG Image -->
						<img src="{{ asset("assets/images/element/02.svg") }}" class="mt-5" alt="">
					</div>
				</div>

				<!-- Right -->
				<div class="col-12 col-lg-6 m-auto">
					<div class="row my-5">
						<div class="col-sm-10 col-xl-8 m-auto">
							<!-- Title -->
							<span class="mb-0 fs-1">🔒</span>
							<h1 class="fs-2">Forgot Password</h1>
							<p class="lead mb-4">Enter your email address and we'll send you a code to reset your password.</p>

							<!-- Flash Messages -->
							{% for message in app.flashes('success') %}
								<div class="alert alert-success alert-dismissible fade show" role="alert">
									{{ message }}
									<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
								</div>
							{% endfor %}
							{% for message in app.flashes('error') %}
								<div class="alert alert-danger alert-dismissible fade show" role="alert">
									{{ message }}
									<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
								</div>
							{% endfor %}

							<!-- Form START -->
							{{ form_start(form) }}
								<!-- Email -->
								<div class="mb-4">
									{{ form_label(form.email, 'Email Address', {'label_attr': {'class': 'form-label'}}) }}
									<div class="input-group input-group-lg">
										<span class="input-group-text bg-light rounded-start border-0 text-secondary px-3"><i class="bi bi-envelope-fill"></i></span>
										{{ form_widget(form.email, {'attr': {'class': 'form-control border-0 bg-light rounded-end ps-1', 'placeholder': 'Enter your email address'}}) }}
									</div>
									{{ form_errors(form.email) }}
								</div>

								<!-- Button -->
								<div class="align-items-center mt-0">
									<div class="d-grid">
										{{ form_widget(form.submit) }}
									</div>
								</div>
							{{ form_end(form) }}
							<!-- Form END -->

							<!-- Back to login -->
							<div class="mt-4 text-center">
								<span>Remember your password? <a href="{{ path('front_login') }}">Back to login</a></span>
							</div>
						</div>
					</div> <!-- Row END -->
				</div>
			</div> <!-- Row END -->
		</div>
	</section>
</main>
{% endblock %}
