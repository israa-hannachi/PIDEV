{% extends 'front/events/base_front.html.twig' %}

{% block title %}Naja7ni - Accueil{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Clash+Display:wght@400;500;600;700&family=Satoshi:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0FB5A9;
            --secondary: #04B6D5;
            --accent: #B3D54C;
            --muted: #718096;
            --background: #f7fffe;
            --card: #ffffff;
            --border: rgba(15, 181, 169, 0.1);
        }

        body { font-family: 'Satoshi', sans-serif; background: var(--background); color: #4a5568; }

        /* ── Hero Banner ── */
        .hero-banner {
            position: relative;
            background: var(--ink);
            border-radius: 2rem;
            padding: 6rem 4rem;
            overflow: hidden;
            color: #fff;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 60vh;
        }
        .hero-banner .blob {
            position: absolute;
            width: 400px; height: 400px;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.2;
        }
        .blob-1 { background: var(--primary); top: -100px; left: -100px; }
        .blob-2 { background: var(--accent); bottom: -120px; right: 100px; }

        .hero-title {
            font-family: 'Clash Display', sans-serif;
            font-size: clamp(3rem, 8vw, 5rem);
            font-weight: 700;
            line-height: 1;
            letter-spacing: -3px;
            margin-bottom: 1.5rem;
            max-width: 800px;
        }
        .hero-title span { color: var(--background); }
        .hero-subtitle { color: rgba(255,255,255,0.6); font-size: 1.25rem; max-width: 600px; line-height: 1.6; margin-bottom: 2.5rem; }

        .btn-primary-custom {
            background: #fff;
            color: var(--primary);
            padding: 1rem 2.5rem;
            border-radius: 100px;
            font-weight: 700;
            text-decoration: none;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 10px 30px rgba(15, 181, 169, 0.2);
        }
        .btn-primary-custom:hover { transform: translateY(-3px); box-shadow: 0 15px 40px rgba(15, 181, 169, 0.3); }

        /* ── Sponsors Section ── */
        .sponsors-section { margin-top: 6rem; padding-bottom: 4rem; }
        .section-tag {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--primary);
            background: rgba(232, 68, 31, 0.08);
            padding: 4px 12px;
            border-radius: 100px;
            margin-bottom: 1rem;
        }
        .section-title { font-family: 'Clash Display', sans-serif; font-size: 2.5rem; font-weight: 700; margin-bottom: 3rem; }
        
        .sponsors-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 2rem;
            align-items: center;
        }
        .sponsor-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 1.5rem;
            padding: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: filter 0.3s, transform 0.3s;
            filter: grayscale(1);
            opacity: 0.6;
            height: 120px;
        }
        .sponsor-card:hover { filter: grayscale(0); opacity: 1; transform: scale(1.05); }
        .sponsor-card img { max-width: 100%; max-height: 100%; object-fit: contain; }

        /* ── AI Recommendations ── */
        .reco-section { margin-top: 4rem; }
        .reco-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
        .reco-card {
            background: var(--card);
            border: 1.5px solid rgba(15, 181, 169, 0.1);
            border-radius: 2.5rem;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            box-shadow: 0 10px 30px -5px rgba(0,0,0,0.02);
        }
        .reco-card:hover { 
            transform: translateY(-10px); 
            box-shadow: 0 40px 80px -20px rgba(15, 181, 169, 0.2);
            border-color: var(--primary);
        }
        .reco-card-body { padding: 2.5rem; }
        .reco-title { font-family: 'Clash Display', sans-serif; font-size: 1.5rem; font-weight: 700; margin-bottom: 0.75rem; color: #1a202c; }
        
        @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .fade-in { animation: fadeInUp 0.6s ease both; }
    </style>
{% endblock %}

{% block body %}
<div class="fade-in max-w-5xl mx-auto py-12">
    {# ── Clean Hero (Minimal) ── #}
    <section class="text-center py-20 px-8 rounded-[3rem] bg-gradient-to-br from-sidebar to-white border border-sidebar-border mb-16 shadow-sm">
        <h1 class="hero-title text-ink mb-6">Explorez, Apprenez<br>et <span class="text-primary italic">Réussissez</span>.</h1>
        <p class="hero-subtitle mx-auto text-lg text-muted-foreground mb-10 max-w-2xl">
            Découvrez une nouvelle façon d'apprendre et de collaborer. Naja7ni vous connecte aux meilleurs événements et opportunités.
        </p>
        <div class="flex items-center justify-center gap-4">
            <a href="{{ path('app_front_events') }}" class="px-8 py-4 bg-ink text-white rounded-2xl font-bold hover:bg-primary transition-all shadow-xl shadow-ink/10 active:scale-95">
                Explorer les événements
            </a>
            <a href="{{ path('app_front_categories') }}" class="px-8 py-4 bg-white text-ink border border-border rounded-2xl font-bold hover:bg-muted transition-all active:scale-95">
                Parcourir les catégories
            </a>
        </div>
    </section>

    {# ── AI Recommendations (If visible) ── #}
    {% if recommendations is defined and recommendations|length > 0 %}
    <section class="mb-16 reco-section">
        <div class="flex items-center justify-between mb-8 px-4">
            <div>
                <h2 class="text-2xl font-bold text-ink flex items-center gap-2">
                    <i data-lucide="sparkles" class="w-6 h-6 text-primary"></i>
                    Recommandé pour vous
                </h2>
                <p class="text-sm text-muted-foreground mt-1">Basé sur votre profil et votre activité</p>
            </div>
            <span class="px-4 py-1.5 bg-primary/10 text-primary rounded-full text-xs font-bold uppercase tracking-wider hidden md:inline-block">AI Powered</span>
        </div>
        <div class="reco-grid">
            {% for item in recommendations %}
                <div id="reco-card-{{ item.event.id }}" class="reco-card relative group">
                    <div class="h-40 bg-muted relative overflow-hidden">
                        {% if item.event.image %}
                            <img src="{{ asset(item.event.image) }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" alt="{{ item.event.titre }}">
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center bg-primary/5">
                                <i data-lucide="image" class="w-12 h-12 text-primary/20"></i>
                            </div>
                        {% endif %}
                        <div class="absolute top-4 right-4 bg-white/90 backdrop-blur text-ink px-3 py-1 rounded-full text-[10px] font-black shadow-sm">
                            {{ item.score }}% MATCH
                        </div>
                    </div>
                    
                    <div class="reco-card-body flex-1 flex flex-col">
                        <span class="text-[10px] font-bold text-primary uppercase tracking-[0.2em] mb-2 block">{{ item.event.categorie }}</span>
                        <h3 class="reco-title group-hover:text-primary transition-colors line-clamp-2" title="{{ item.event.titre }}">{{ item.event.titre }}</h3>
                        
                        <div class="flex items-center gap-2 text-xs text-muted-foreground mb-4">
                            <i data-lucide="calendar" class="w-3 h-3"></i>
                            <span>{{ item.event.dateDebut ? item.event.dateDebut|date('d/m/Y') : 'À définir' }}</span>
                        </div>
                        
                        <div class="p-3 bg-indigo-50/50 rounded-xl border border-indigo-100/50 mb-6 flex-1">
                            <p class="text-xs text-indigo-900/80 italic font-medium">« {{ item.explanation }} »</p>
                        </div>
                        
                        <div class="flex flex-col gap-2 mt-auto">
                            {% if user_registered_event_ids is defined and item.event.id in user_registered_event_ids|keys %}
                                {% set registrationData = user_registered_event_ids[item.event.id] %}
                                {% if registrationData.status == 'en_attente' %}
                                    <a href="{{ path('app_front_payment_retry', {id: registrationData.id}) }}" class="w-full py-3 bg-amber-600 text-white text-center rounded-xl font-bold shadow-lg shadow-amber-600/20 active:scale-95 transition-all flex items-center justify-center gap-2">
                                        <i data-lucide="credit-card" class="w-4 h-4"></i>
                                        Payer (API) {{ item.event.prix }} DT
                                    </a>
                                {% endif %}
                            {% endif %}
                            
                            <div class="flex items-center gap-2">
                                <a href="{{ path('app_front_event_show', {id: item.event.id}) }}" class="flex-1 px-4 py-3 bg-ink text-white text-center rounded-xl text-sm font-bold hover:bg-primary transition-all shadow-md hover:shadow-primary/30 active:scale-95">
                                    Voir les détails
                                </a>
                                <button onclick="dismissRecommendation({{ item.event.id }})" class="p-3 bg-red-50 text-red-500 rounded-xl hover:bg-red-100 transition-colors" title="Pas intéressé">
                                    <i data-lucide="thumbs-down" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ── Collaborative Filtering Recommendations ── #}
    {% if collab_recommendations is defined and collab_recommendations|length > 0 %}
    <section class="mb-24 reco-section bg-gradient-to-r from-accent/5 to-transparent p-8 rounded-[3rem] border border-accent/10">
        <div class="flex items-center justify-between mb-8 px-4">
            <div>
                <h2 class="text-2xl font-bold text-ink flex items-center gap-2">
                    <i data-lucide="users" class="w-6 h-6 text-accent"></i>
                    Les participants comme vous ont aimé
                </h2>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {% for item in collab_recommendations %}
                <div id="collab-card-{{ item.event.id }}" class="bg-white border border-border rounded-3xl p-6 transition-all hover:border-accent hover:shadow-xl group">
                    <h3 class="text-lg font-bold text-ink mb-2 line-clamp-1 group-hover:text-accent transition-colors">{{ item.event.titre }}</h3>
                    <p class="text-xs text-muted-foreground mb-4 flex items-center gap-1">
                        <i data-lucide="map-pin" class="w-3 h-3"></i> {{ item.event.lieu }}
                    </p>
                    <div class="flex justify-between items-center">
                        <span class="text-sm font-bold text-ink">{{ item.event.prix > 0 ? item.event.prix ~ ' DT' : 'Gratuit' }}</span>
                        <div class="flex gap-2">
                            <a href="{{ path('app_front_event_show', {id: item.event.id}) }}" class="px-3 py-1.5 bg-accent/20 text-accent-foreground rounded-lg text-xs font-bold hover:bg-accent hover:text-white transition-colors">
                                Découvrir
                            </a>
                            <button onclick="dismissRecommendation({{ item.event.id }})" class="p-1.5 text-muted-foreground hover:text-red-500 transition-colors" title="Pas intéressé">
                                <i data-lucide="thumbs-down" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ── Sponsors Section (Bottom) ── #}
    <section class="mt-32 pt-16 border-t border-border">
        <div class="text-center mb-12">
            <h2 class="text-sm font-bold text-muted-foreground uppercase tracking-[0.3em] mb-4">Nos Partenaires</h2>
            <p class="text-2xl font-bold text-ink">Ils soutiennent la réussite de nos membres</p>
        </div>
        
        <div class="flex flex-wrap items-center justify-center gap-12 opacity-50 grayscale hover:grayscale-0 transition-all duration-700">
            {% for sponsor in sponsors %}
                <div class="h-12 flex items-center justify-center">
                    {% if sponsor.logo %}
                        <img src="{{ asset(sponsor.logo) }}" alt="{{ sponsor.nom }}" class="h-full object-contain filter drop-shadow-sm transition-transform hover:scale-110">
                    {% else %}
                        <span class="font-bold text-lg text-ink">{{ sponsor.nom }}</span>
                    {% endif %}
                </div>
            {% endfor %}
            {% if sponsors|length == 0 %}
                <div class="text-center text-muted-foreground text-sm italic py-8">Bientôt de nouveaux partenaires !</div>
            {% endif %}
        </div>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        if (typeof lucide !== 'undefined') lucide.createIcons();
    });

    function dismissRecommendation(eventId) {
        if (!confirm('Voulez-vous vraiment masquer cet événement de vos recommandations ?')) {
            return;
        }

        // Hide cards UI first for responsiveness
        const recoCard = document.getElementById('reco-card-' + eventId);
        const collabCard = document.getElementById('collab-card-' + eventId);
        
        if (recoCard) {
            recoCard.style.opacity = '0';
            recoCard.style.transform = 'scale(0.9)';
            setTimeout(() => recoCard.remove(), 400);
        }
        
        if (collabCard) {
            collabCard.style.opacity = '0';
            collabCard.style.transform = 'scale(0.9)';
            setTimeout(() => collabCard.remove(), 400);
        }

        // Send AJAX request to log the 'not_interested' interaction
        fetch('{{ path('app_front_event_log_interaction') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: JSON.stringify({
                eventId: eventId,
                type: 'not_interested'
            })
        })
        .then(response => {
            if (!response.ok) {
                console.error('Failed to log interaction');
            }
        })
        .catch(error => console.error('Error:', error));
    }
</script>
{% endblock %}
