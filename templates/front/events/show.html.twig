{% extends 'front/events/base_front.html.twig' %}

{% block title %}{{ event.titre }} - Naja7ni{% endblock %}

{% block body %}
<!-- Breadcrumbs -->
<nav class="flex mb-8" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="{{ path('app_front_home') }}" class="inline-flex items-center text-sm font-medium text-muted-foreground hover:text-primary transition-colors">
                <i data-lucide="home" class="w-4 h-4 mr-2"></i>
                Événements
            </a>
        </li>
        <li aria-current="page">
            <div class="flex items-center">
                <i data-lucide="chevron-right" class="w-4 h-4 text-muted-foreground"></i>
                <span class="ml-1 text-sm font-bold text-foreground md:ml-2">{{ event.titre|length > 30 ? event.titre|slice(0, 30) ~ '...' : event.titre }}</span>
            </div>
        </li>
    </ol>
</nav>

{% for registration_id in app.flashes('registration_id') %}
    {% set success_messages = app.flashes('success') %}
    <div class="mb-8 p-6 bg-green-50 border border-green-100 rounded-3xl flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-green-500/10 text-green-600 flex items-center justify-center flex-shrink-0">
                <i data-lucide="check-circle" class="w-6 h-6"></i>
            </div>
            <div>
                <h4 class="font-bold text-green-900">
                    {% if success_messages|length > 0 %}
                        {{ success_messages[0] }}
                    {% else %}
                        Votre inscription est réussie !
                    {% endif %}
                </h4>
                <p class="text-xs text-green-700">Bienvenue à l'événement. Votre place est réservée.</p>
            </div>
        </div>
        <a href="{{ path('app_front_registration_ticket', {id: registration_id}) }}" class="flex items-center gap-2 px-6 py-3 bg-green-600 text-white rounded-2xl font-bold hover:bg-green-700 transition-all shadow-lg shadow-green-600/20 active:scale-95">
            <i data-lucide="download" class="w-5 h-5"></i>
            Télécharger mon Ticket (PDF)
        </a>
    </div>
{% endfor %}

{% for paymee_token in app.flashes('paymee_token') %}
    <div id="paymee-modal-trigger" data-token="{{ paymee_token }}" class="hidden"></div>
{% endfor %}

{% for reg_id in app.flashes('registration_id_payment') %}
    <div id="paymee-registration-id" data-reg-id="{{ reg_id }}" class="hidden"></div>
{% endfor %}

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-8 space-y-8">
        <div class="bg-white rounded-2xl shadow-sm border border-border overflow-hidden">
            {% if event.image %}
                <img src="{{ asset(event.image) }}" alt="{{ event.titre }}" class="w-full h-96 object-cover transition-transform duration-700 hover:scale-105">
            {% endif %}
            
            <div class="p-8">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-sm font-bold text-primary bg-primary/5 px-3 py-1.5 rounded-lg inline-block">{{ event.categorie }}</span>
                    <button onclick="toggleAIChat()" class="ai-pulse flex items-center gap-1.5 px-4 py-2 bg-indigo-600 text-white rounded-xl text-[11px] font-bold shadow-xl shadow-indigo-600/30 hover:scale-105 transition-all">
                        <i data-lucide="brain-circuit" class="w-4 h-4"></i>
                        INTELLIGENCE IA
                    </button>
                </div>
                <h1 class="text-4xl font-extrabold text-foreground mb-8">{{ event.titre }}</h1>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10 pb-8 border-b border-border">
                    <div class="flex items-center gap-4">
                        <div class="p-4 bg-primary/5 rounded-2xl text-primary">
                            <i data-lucide="calendar" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-wider">Date & Heure</p>
                            <p class="font-bold text-foreground text-sm">{{ event.dateDebut|date('d F, Y @ H:i') }}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="p-4 bg-primary/5 rounded-2xl text-primary">
                            <i data-lucide="map-pin" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-wider">Lieu</p>
                            <p class="font-bold text-foreground text-sm line-clamp-1">{{ event.lieu }}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="p-4 bg-primary/5 rounded-2xl text-primary">
                            <i data-lucide="ticket" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-wider">Prix</p>
                            <p class="font-bold text-foreground text-sm">{{ event.prix > 0 ? event.prix ~ ' DT' : 'Gratuit' }}</p>
                        </div>
                    </div>
                </div>

                <div class="prose prose-slate max-w-none mb-10">
                    <h3 class="text-2xl font-bold mb-4">À propos de cet événement</h3>
                    <p class="text-muted-foreground leading-relaxed whitespace-pre-line">{{ event.description }}</p>
                </div>

                <!-- Rating Section -->
                <div class="border-t border-border pt-8 mb-10">
                    <h3 class="text-2xl font-bold mb-6 flex items-center gap-2">
                        <i data-lucide="star" class="w-6 h-6 text-yellow-400 fill-yellow-400"></i>
                        Avis et Notes
                    </h3>
                    
                    <div class="bg-muted/30 rounded-2xl p-6 mb-8 flex items-center gap-8">
                        <div class="text-center">
                            <span class="block text-4xl font-extrabold text-foreground">
                                {% set avgRating = 0 %}
                                {% set totalRatings = event.ratings|length %}
                                {% if totalRatings > 0 %}
                                    {% set sum = 0 %}
                                    {% for rating in event.ratings %}
                                        {% set sum = sum + rating.stars %}
                                    {% endfor %}
                                    {% set avgRating = sum / totalRatings %}
                                {% endif %}
                                {{ avgRating|number_format(1) }}
                            </span>
                            <div class="flex gap-1 justify-center my-1 text-yellow-400">
                                {% for i in 1..5 %}
                                    <i data-lucide="star" class="w-4 h-4 {{ i <= avgRating|round ? 'fill-yellow-400' : 'text-gray-300' }}"></i>
                                {% endfor %}
                            </div>
                            <span class="text-xs text-muted-foreground font-medium">{{ totalRatings }} avis</span>
                        </div>
                        <div class="flex-1 border-l border-border pl-8">
                            <p class="text-sm text-foreground font-bold mb-2">Partagez votre expérience</p>
                            <p class="text-xs text-muted-foreground mb-4">Aidez les autres à choisir leurs événements.</p>
                            <button onclick="document.getElementById('ratingForm').classList.toggle('hidden')" class="px-4 py-2 bg-white border border-border rounded-xl text-sm font-semibold hover:bg-muted transition-all">
                                Écrire un avis
                            </button>
                        </div>
                    </div>

                    <!-- Hidden Rating Form -->
                    <div id="ratingForm" class="hidden bg-white border border-border rounded-2xl p-6 mb-8 shadow-sm">
                        <h4 class="font-bold text-lg mb-4">Noter cet événement</h4>
                        <form action="{{ path('app_front_event_rate', {id: event.id}) }}" method="post" class="space-y-4">
                            <div>
                                <label class="block text-sm font-bold mb-2">Votre note</label>
                                <div class="flex gap-2">
                                    {% for i in 1..5 %}
                                        <label class="cursor-pointer hover:scale-110 transition-transform">
                                            <input type="radio" name="rating[stars]" value="{{ i }}" class="sr-only peer" required>
                                            <i data-lucide="star" class="w-8 h-8 text-gray-300 peer-checked:text-yellow-400 peer-checked:fill-yellow-400 hover:text-yellow-400 hover:fill-yellow-400 transition-all"></i>
                                        </label>
                                    {% endfor %}
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-bold mb-2">Votre avis</label>
                                <textarea name="rating[comment]" rows="3" class="w-full px-4 py-3 border border-border rounded-xl focus:ring-2 focus:ring-primary focus:border-transparent transition-all" placeholder="Qu'avez-vous pensé de l'événement ?"></textarea>
                            </div>
                            <button type="submit" class="px-6 py-3 bg-primary text-white rounded-xl font-bold shadow-md hover:bg-primary/90 transition-all">Publier mon avis</button>
                        </form>
                    </div>

                    <!-- Reviews List -->
                    <div class="space-y-4">
                        {% for rating in event.ratings %}
                            <div class="bg-white border border-border rounded-xl p-4">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center text-primary font-bold text-xs">U</div>
                                        <span class="text-sm font-bold">Utilisateur</span>
                                    </div>
                                    <span class="text-xs text-muted-foreground">{{ rating.createdAt|date('d M Y') }}</span>
                                </div>
                                <div class="flex gap-1 text-yellow-400 mb-2">
                                    {% for i in 1..5 %}
                                        <i data-lucide="star" class="w-3 h-3 {{ i <= rating.stars ? 'fill-yellow-400' : 'text-gray-300' }}"></i>
                                    {% endfor %}
                                </div>
                                <p class="text-sm text-muted-foreground">{{ rating.comment }}</p>
                            </div>
                        {% else %}
                            <div class="text-center py-8 text-muted-foreground bg-muted/20 rounded-xl">
                                Soyez le premier à donner votre avis !
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Event Location Map -->
                <div class="space-y-4">
                    <h3 class="text-2xl font-bold mb-4 flex items-center gap-2">
                        <i data-lucide="map" class="w-6 h-6"></i>
                        Emplacement
                    </h3>
                    
                    {% if event.latitude and event.longitude %}
                        <div id="eventMap" class="w-full h-80 rounded-2xl border border-border"></div>
                        <div class="flex items-center gap-2 text-sm text-muted-foreground bg-muted/30 p-4 rounded-xl">
                            <i data-lucide="info" class="w-4 h-4"></i>
                            <span>Coordonnées: {{ event.latitude|round(4) }}, {{ event.longitude|round(4) }}</span>
                        </div>
                    {% else %}
                        <div class="w-full h-40 rounded-2xl border border-border bg-muted/20 flex flex-col items-center justify-center text-muted-foreground">
                            <i data-lucide="map-off" class="w-10 h-10 mb-2 opacity-50"></i>
                            <span class="font-medium">Carte non disponible</span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar / Registration -->
    <div class="lg:col-span-4 space-y-6">
        <div id="registrationForm" class="bg-white rounded-2xl shadow-sm border border-border p-8 sticky top-8" style="{{ form.vars.submitted and not form.vars.valid ? 'display: block;' : 'display: none;' }}">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-xl font-bold text-foreground flex items-center gap-2" style="font-family: 'Clash Display', sans-serif;">
                        <i data-lucide="user-plus" class="w-5 h-5" style="color: var(--primary);"></i>
                        Inscription
                    </h3>
                    <button onclick="hideRegistrationForm()" class="text-muted-foreground hover:text-foreground transition-colors">
                        <i data-lucide="x" class="w-5 h-5"></i>
                    </button>
                </div>

                <!-- Paymee API Secure Button-styled Badge -->
                <button type="button" class="w-full mb-6 p-4 bg-emerald-600 text-white rounded-2xl flex items-center justify-between shadow-lg shadow-emerald-600-20 group/btn transition-all hover:scale-[1.02] border-0 outline-none">
                    <div class="flex items-center gap-3 text-left">
                        <div class="w-10 h-10 bg-white-20 rounded-xl flex items-center justify-center">
                            <i data-lucide="shield-check" class="w-5 h-5 text-white"></i>
                        </div>
                        <div>
                            <p class="text-[11px] font-black uppercase tracking-tight">PAIEMENT SÉCURISÉ API</p>
                            <p class="text-[10px] opacity-80 font-medium">Certifié par Paymee Gateway</p>
                        </div>
                    </div>
                    <i data-lucide="lock" class="w-4 h-4 opacity-40"></i>
                </button>

            {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
                <div class="space-y-4">
                    <div>
                        {{ form_label(form.visitorName, null, {'label_attr': {'class': 'block text-xs font-bold text-muted-foreground uppercase tracking-wider mb-2'}}) }}
                        {{ form_widget(form.visitorName, {'attr': {'class': 'w-full px-4 py-3 bg-muted/30 border border-border rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm', 'placeholder': 'Votre nom complet'}}) }}
                        {{ form_errors(form.visitorName, {'attr': {'class': 'text-red-500 text-[10px] mt-1'}}) }}
                    </div>
                    <div>
                        {{ form_label(form.visitorEmail, null, {'label_attr': {'class': 'block text-xs font-bold text-muted-foreground uppercase tracking-wider mb-2'}}) }}
                        {{ form_widget(form.visitorEmail, {'attr': {'class': 'w-full px-4 py-3 bg-muted/30 border border-border rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm', 'placeholder': 'votre@email.com'}}) }}
                        {{ form_errors(form.visitorEmail, {'attr': {'class': 'text-red-500 text-[10px] mt-1'}}) }}
                    </div>
                    <div>
                        {{ form_label(form.notes, null, {'label_attr': {'class': 'block text-xs font-bold text-muted-foreground uppercase tracking-wider mb-2'}}) }}
                        {{ form_widget(form.notes, {'attr': {'class': 'w-full px-4 py-3 bg-muted/30 border border-border rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm', 'placeholder': 'Notes ou demandes spéciales (optionnel)', 'rows': 2}}) }}
                    </div>
                    <div>
                        {{ form_label(form.paymentMethod, null, {'label_attr': {'class': 'block text-xs font-bold text-muted-foreground uppercase tracking-wider mb-2'}}) }}
                        {{ form_widget(form.paymentMethod, {'attr': {'class': 'w-full px-4 py-3 bg-muted/30 border border-border rounded-xl focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all text-sm'}}) }}
                        {{ form_errors(form.paymentMethod, {'attr': {'class': 'text-red-500 text-[10px] mt-1'}}) }}
                    </div>
                </div>

                <button type="submit" class="w-full py-4 text-white rounded-2xl font-bold shadow-lg transition-all active:scale-95 mt-4" style="background: var(--primary); box-shadow: 0 10px 25px rgba(15, 181, 169, 0.2);">
                    Confirmer l'inscription
                    {% if event.prix > 0 %} - {{ event.prix }} DT{% endif %}
                </button>
            {{ form_end(form) }}

            <p class="text-center text-[10px] text-muted-foreground mt-4 px-2 leading-tight">
                En cliquant sur confirmer, vous acceptez nos conditions générales d'utilisation.
            </p>
        </div>
        <div id="ai-analyst" class="bg-gradient-to-br from-slate-900 to-indigo-950 rounded-3xl p-8 border border-white/10 shadow-2xl relative overflow-hidden group" style="{{ form.vars.submitted and not form.vars.valid ? 'display: none;' : '' }}">
            <!-- Animated Background Glow -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-primary/20 blur-[80px] rounded-full group-hover:bg-primary/30 transition-all duration-700"></div>
            
            <div class="relative z-10">
                <div class="flex items-center justify-between mb-6">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-primary to-secondary flex items-center justify-center text-white shadow-lg animate-pulse">
                            <i data-lucide="sparkles" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h4 class="font-black text-white tracking-tight text-lg">Analyste IA <span class="text-[10px] bg-white/10 px-2 py-0.5 rounded-full ml-2 text-primary tracking-widest uppercase">Premium v1.5</span></h4>
                            {% if recommendation %}
                                <div class="flex items-center gap-2 mt-1">
                                    <div class="h-1.5 w-32 bg-white/10 rounded-full overflow-hidden">
                                        <div class="h-full bg-gradient-to-r from-primary to-secondary" style="width: {{ recommendation.matchScore }}%"></div>
                                    </div>
                                    <span class="text-[10px] font-black text-primary uppercase">{{ recommendation.matchScore }}% Compatibilité</span>
                                </div>
                            {% else %}
                                <div class="flex items-center gap-2 mt-1">
                                    <span class="relative flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
                                    </span>
                                    <span class="text-[10px] font-bold text-white/50 uppercase tracking-widest">Analyse Cognitive en cours...</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                
                <div class="space-y-4 mb-6">
                    {% if not app.user %}
                        <div class="p-6 border-2 border-dashed border-white/20 rounded-3xl text-center bg-white/5 backdrop-blur-sm">
                            <div class="w-12 h-12 bg-primary/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
                                <i data-lucide="user-plus" class="w-6 h-6 text-primary"></i>
                            </div>
                            <h5 class="text-white font-bold mb-2">Analyse Réservée</h5>
                            <p class="text-[11px] text-white/50 leading-relaxed mb-4">Connectez-vous pour voir comment cet événement s'aligne avec votre profil professionnel.</p>
                            <a href="{{ path('app_login') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-xl text-[10px] font-black uppercase tracking-widest hover:scale-105 transition-all">
                                Se connecter
                                <i data-lucide="arrow-right" class="w-3 h-3"></i>
                            </a>
                        </div>
                    {% elseif recommendation %}
                        <div class="p-4 bg-white/5 border border-white/10 rounded-2xl backdrop-blur-sm">
                            <p class="text-[11px] font-bold text-white/40 uppercase mb-3 tracking-widest flex items-center gap-2">
                                <i data-lucide="align-left" class="w-3 h-3"></i> Rapport d'Intelligence
                            </p>
                            <div class="space-y-3">
                                {% for explanation in recommendation.explanations %}
                                    <div class="flex gap-3 items-start group/item">
                                        <i data-lucide="check-circle-2" class="w-4 h-4 text-primary mt-0.5 shrink-0 transition-transform group-hover/item:scale-110"></i>
                                        <p class="text-[13px] text-white/80 leading-relaxed font-medium">{{ explanation }}</p>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <div class="p-8 border-2 border-dashed border-white/10 rounded-3xl text-center">
                            <i data-lucide="loader-2" class="w-8 h-8 text-white/20 animate-spin mx-auto mb-4"></i>
                            <p class="text-sm text-white/40 font-medium max-w-[200px] mx-auto italic">Traitement des métadonnées et alignement avec vos intérêts...</p>
                        </div>
                    {% endif %}
                </div>
                
                <div class="flex items-center justify-between pt-4 border-t border-white/10">
                    <div class="flex items-center gap-2">
                        <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></div>
                        <span class="text-[10px] text-white/30 font-bold uppercase tracking-widest">IA Engine Active</span>
                    </div>
                    <p class="text-[9px] text-white/20 font-medium tracking-tighter">Naja7ni Neural Network Strategy</p>
                </div>
            </div>
        </div>
        <div id="registrationSummary" class="bg-white rounded-3xl shadow-xl border border-primary/10 p-8 sticky top-8 transition-all duration-500 overflow-hidden" style="{{ form.vars.submitted and not form.vars.valid ? 'display: none;' : '' }}">
                <div class="absolute top-0 right-0 w-32 h-32 bg-primary/5 -mr-16 -mt-16 rounded-full"></div>
                
                <h3 class="text-xl font-black text-ink mb-6 flex items-center gap-2 uppercase tracking-wide relative z-10" style="font-family: 'Clash Display', sans-serif;">
                    <i data-lucide="calendar-check" class="w-6 h-6 text-primary"></i>
                    Participation
                </h3>

                <div class="space-y-4 mb-8">
                    <div class="flex justify-between items-center bg-slate-50 p-3 rounded-xl border border-slate-100">
                        <span class="text-xs font-bold text-muted-foreground uppercase tracking-widest">Prix</span>
                        <span class="font-black text-ink">{{ event.prix > 0 ? event.prix ~ ' DT' : 'GRATUIT' }}</span>
                    </div>

                    <div class="space-y-2">
                        {% set progress = (event.inscrits / event.capacite * 100)|round %}
                        <div class="flex justify-between text-[10px] items-center font-bold px-1 uppercase tracking-wider">
                            <span class="text-muted-foreground">Places Disponibles</span>
                            <span class="text-primary">{{ event.capacite - event.inscrits }} / {{ event.capacite }}</span>
                        </div>
                        <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full bg-primary transition-all duration-1000" style="width: {{ progress }}%;"></div>
                        </div>
                    </div>
                </div>

                {% if userRegistration %}
                    <div class="space-y-4 mb-6 relative z-10">
                        <div class="p-4 bg-primary/5 rounded-2xl border border-primary/10">
                            <div class="flex justify-between items-center mb-3">
                                <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest">Statut</span>
                                <span class="px-3 py-1 bg-{{ (userRegistration.statut == 'confirmé' or userRegistration.statut == 'inscrit') ? 'emerald' : 'amber' }}-50 text-{{ (userRegistration.statut == 'confirmé' or userRegistration.statut == 'inscrit') ? 'emerald' : 'amber' }}-600 rounded-full text-[9px] font-black uppercase border border-{{ (userRegistration.statut == 'confirmé' or userRegistration.statut == 'inscrit') ? 'emerald' : 'amber' }}-100 tracking-tighter">
                                    {{ userRegistration.statut|upper }}
                                </span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-[10px] font-bold text-muted-foreground uppercase tracking-widest">Participant</span>
                                <span class="text-xs font-black text-ink">{{ userRegistration.visitorName }}</span>
                            </div>
                        </div>

                        {% if userRegistration.statut == 'confirmé' or userRegistration.statut == 'inscrit' %}
                            <div class="space-y-3 mt-4">
                                <a href="{{ path('app_front_registration_ticket', {id: userRegistration.id}) }}" target="_blank" class="flex flex-col items-center justify-center gap-1 w-full py-4 bg-emerald-600 text-white rounded-2xl hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-600/30 active:scale-95 group border border-emerald-500 relative overflow-hidden">
                                    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNCIgaGVpZ2h0PSI0IiBmaWxsPSIjZmZmIiBmaWxsLW9wYWNpdHk9IjAuMDUiLz4KPC9zdmc+')] opacity-50"></div>
                                    <div class="relative z-10 flex items-center gap-2">
                                        <i data-lucide="ticket" class="w-5 h-5 transition-transform group-hover:scale-110"></i>
                                        <span class="font-black text-sm tracking-wide">TÉLÉCHARGER LE TICKET</span>
                                    </div>
                                    <span class="relative z-10 text-[10px] font-medium text-emerald-100 opacity-90 uppercase tracking-widest">(Format PDF)</span>
                                </a>
                            </div>
                        {% elseif userRegistration.statut == 'en_attente' %}
                            <div class="space-y-3">
                                <a href="{{ path('app_front_payment_retry', {id: userRegistration.id}) }}" class="flex items-center justify-center gap-2 w-full py-4 bg-amber-500 text-white rounded-2xl font-black text-xs hover:bg-amber-600 transition-all shadow-lg shadow-amber-500/20 active:scale-95 group">
                                    <i data-lucide="credit-card" class="w-4 h-4 transition-transform group-hover:scale-110"></i>
                                    FINALISER LE PAIEMENT (API)
                                </a>
                                <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-start gap-2">
                                    <i data-lucide="info" class="w-3.5 h-3.5 text-slate-400 mt-0.5"></i>
                                    <p class="text-[9px] text-slate-500 leading-tight">Paiement via Paymee API. Vous resterez sur notre plateforme après validation.</p>
                                </div>
                            </div>
                        {% endif %}

                        <div class="pt-4 border-t border-dashed border-slate-100 mt-6">
                            <button onclick="document.getElementById('cancelForm').classList.toggle('hidden')" class="w-full py-3 border-2 border-red-50 text-red-400 hover:text-red-500 hover:bg-red-50 rounded-xl text-[10px] font-bold uppercase tracking-widest flex items-center justify-center gap-2 transition-all">
                                <i data-lucide="user-minus" class="w-3.5 h-3.5"></i>
                                Annuler ma participation
                            </button>
                            
                            <div id="cancelForm" class="hidden mt-4 p-5 bg-red-50 border border-red-100 rounded-2xl">
                                <div class="flex items-center gap-2 mb-4">
                                    <i data-lucide="shield-alert" class="w-4 h-4 text-red-600"></i>
                                    <p class="text-[10px] font-black text-red-900 uppercase">Sécurité Requise</p>
                                </div>
                                <form action="{{ path('app_front_registration_cancel', {id: userRegistration.id}) }}" method="post" class="space-y-3">
                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_registration_' ~ userRegistration.id) }}">
                                    <input type="text" name="visitorName" placeholder="Identité complète" class="w-full px-4 py-3 text-xs border border-red-200 rounded-xl focus:ring-2 focus:ring-red-500 transition-all" required>
                                    <input type="email" name="visitorEmail" placeholder="Email utilisé" class="w-full px-4 py-3 text-xs border border-red-200 rounded-xl focus:ring-2 focus:ring-red-500 transition-all" required>
                                    <button type="submit" class="w-full py-3 bg-red-600 text-white text-[10px] font-black rounded-xl hover:bg-red-700 transition-all shadow-md">
                                        CONFIRMER LA SUPPRESSION
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% elseif event.inscrits < event.capacite %}
                    <button onclick="showRegistrationForm()" class="block w-full py-4 text-white text-center rounded-2xl font-black text-sm shadow-xl transition-all active:scale-95 mb-6 group" style="background: var(--primary); box-shadow: 0 10px 25px rgba(15, 181, 169, 0.2);">
                        <span class="flex items-center justify-center gap-2">
                            JE M'INSCRIS MAINTENANT
                            <i data-lucide="arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1"></i>
                        </span>
                    </button>
                    
                    <div class="p-4 bg-slate-50 border border-slate-100 rounded-2xl flex items-center gap-4">
                        <div class="w-10 h-10 bg-white rounded-xl shadow-sm flex items-center justify-center text-slate-400">
                            <i data-lucide="credit-card" class="w-5 h-5"></i>
                        </div>
                        <div class="flex-1">
                            <p class="text-[11px] font-black text-slate-800 uppercase tracking-tight">API Payment Ready</p>
                            <p class="text-[10px] text-slate-500">Service Paymee 2.0</p>
                        </div>
                    </div>
                {% else %}
                    <button class="w-full py-4 bg-slate-100 text-slate-400 rounded-2xl font-bold cursor-not-allowed text-sm flex items-center justify-center gap-2" disabled>
                        <i data-lucide="slash" class="w-4 h-4"></i>
                        ÉVÉNEMENT COMPLET
                    </button>
                {% endif %}
                
                <p class="text-center text-[10px] text-slate-400 mt-6 font-medium">
                    <i data-lucide="lock" class="w-3 h-3 inline mr-1"></i>
                    Transactions sécurisées Naja7ni Platform
                </p>
            </div>

        </div>

</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css" />
    <script>
        function showRegistrationForm() {
            const form = document.getElementById('registrationForm');
            const summary = document.getElementById('registrationSummary');
            const ai = document.getElementById('ai-analyst');
            
            form.style.display = 'block';
            summary.style.display = 'none';
            if (ai) ai.style.display = 'none';
            
            form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            setTimeout(() => lucide.createIcons(), 100);
        }

        function hideRegistrationForm() {
            document.getElementById('registrationForm').style.display = 'none';
            document.getElementById('registrationSummary').style.display = 'block';
            const ai = document.getElementById('ai-analyst');
            if (ai) ai.style.display = 'block';
        }

        document.addEventListener('DOMContentLoaded', function() {
            lucide.createIcons();
            
            // Paymee Modal handling
            const paymeeTrigger = document.getElementById('paymee-modal-trigger');
            const paymeeRegId = document.getElementById('paymee-registration-id');
            
            if (paymeeTrigger) {
                const token = paymeeTrigger.dataset.token;
                const regId = paymeeRegId ? paymeeRegId.dataset.regId : '';
                
                Paymee.checkout(token, {
                    onSuccess: function(data) {
                        if (regId) {
                            window.location.href = "{{ path('app_front_payment_success', {id: 'REG_ID'}) }}".replace('REG_ID', regId);
                        } else {
                            window.location.href = "{{ path('app_front_events') }}";
                        }
                    },
                    onDismiss: function() {
                        // User closed the modal
                    }
                });
            }

            {% if event.latitude and event.longitude %}
                const lat = {{ event.latitude }};
                const lng = {{ event.longitude }};
                const eventMap = L.map('eventMap').setView([lat, lng], 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(eventMap);
                L.marker([lat, lng], {
                    icon: L.icon({
                        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png',
                        iconSize: [25, 41],
                        iconAnchor: [12, 41]
                    })
                }).addTo(eventMap)
                    .bindPopup(`<b>{{ event.titre|escape('js') }}</b><br>{{ event.lieu|escape('js') }}`)
                    .openPopup();
            {% endif %}
        });
    </script>
{% endblock %}
