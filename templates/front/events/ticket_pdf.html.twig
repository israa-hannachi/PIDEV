<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Ticket - {{ event.titre }}</title>
    <style>
        @page { margin: 0; }
        body { 
            font-family: 'Helvetica', sans-serif; 
            color: #334155; 
            margin: 0;
            padding: 20px;
            background-color: #f1f5f9;
        }
        .container {
            max-width: 700px;
            margin: 0 auto;
        }
        .ticket {
            background: white;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            border: 1px solid #e2e8f0;
        }
        .header {
            background: #0FB5A9;
            padding: 30px;
            text-align: center;
            color: white;
            position: relative;
        }
        .logo { 
            font-size: 14px; 
            font-weight: 800; 
            letter-spacing: 4px;
            margin-bottom: 15px;
            text-transform: uppercase;
            opacity: 0.9;
        }
        .event-title { 
            font-size: 28px; 
            font-weight: 800; 
            margin: 0;
            line-height: 1.1;
            text-transform: uppercase;
        }
        .body {
            padding: 40px;
            position: relative;
        }
        .grid {
            width: 100%;
            border-collapse: collapse;
        }
        .col {
            width: 50%;
            padding-bottom: 30px;
        }
        .label { 
            font-size: 11px; 
            color: #94a3b8; 
            text-transform: uppercase; 
            font-weight: 700; 
            margin-bottom: 8px; 
            letter-spacing: 1.5px;
        }
        .value { 
            font-size: 18px; 
            font-weight: 700; 
            color: #1e293b;
        }
        .qr-section {
            text-align: center;
            padding: 30px;
            background: #f8fafc;
            border-top: 2px dashed #e2e8f0;
        }
        .qr-image {
            width: 140px;
            height: 140px;
            background: white;
            padding: 10px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            display: inline-block;
        }
        .footer {
            text-align: center;
            font-size: 10px;
            color: #94a3b8;
            padding: 20px;
            background: white;
            border-top: 1px solid #f1f5f9;
        }
        .badge {
            background-color: #0FB5A9;
            color: white;
            padding: 8px 16px;
            border-radius: 50px;
            font-size: 12px;
            font-weight: 800;
            display: inline-block;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="ticket">
            <div class="header">
                <div class="logo">NAJA7NI PLATFORM</div>
                <h1 class="event-title">{{ event.titre }}</h1>
            </div>

            <div class="body">
                <div class="grid">
                    <div class="col">
                        <div class="label">Participant</div>
                        <div class="value">{{ registration.visitorName }}</div>
                        
                        <div class="label">Lieu</div>
                        <div class="value">{{ event.lieu }}</div>
                    </div>
                    <div class="col">
                        <div class="label">Date & Heure</div>
                        <div class="value">{{ event.dateDebut|date('d F, Y @ H:i') }}</div>
                        
                        <div class="label">Type de Billet</div>
                        <div class="value">Accès Standard</div>
                    </div>
                </div>

                <div style="margin-top: 10px;">
                    <span class="badge">INSCRIPTION CONFIRMÉE</span>
                </div>
            </div>

            <div class="qr-section">
                <div style="margin-bottom: 15px;">
                    {% if qr_code %}
                        <img src="{{ qr_code }}" class="qr-image" alt="QR Code Ticket">
                    {% else %}
                        <div class="qr-image" style="display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 10px;">QR CODE ERROR</div>
                    {% endif %}
                </div>
                <div class="label">SCANNER POUR VÉRIFIER L'ACCÈS</div>
                <div style="font-size: 11px; color: #64748b; margin-top: 5px; font-weight: bold;">TICKET #REG{{ registration.id|upper }}</div>
            </div>
            
            <div class="footer">
                Ce billet est personnel et non transférable. Présentez-le à l'accueil pour validation.<br>
                &copy; {{ "now"|date("Y") }} Naja7ni - Tous droits réservés.
            </div>
        </div>
    </div>
</body>
</html>
