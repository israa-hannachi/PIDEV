{% extends 'forum/Front/base_front.html.twig' %}

{% block title %}{{ categorie.titre }}{% endblock %}

{% block body %}
<div class="p-8 min-h-full">
    <div class="max-w-7xl mx-auto">

        <!-- Fil d'Ariane -->
        <nav class="flex mb-8 text-sm">
            <a href="{{ path('app_front_forum') }}" class="text-muted-foreground hover:text-primary transition-colors">
                Forums
            </a>
            <span class="mx-2 text-muted-foreground">›</span>
            <span class="text-foreground font-medium">{{ categorie.titre }}</span>
        </nav>

        <!-- En-tête de la catégorie -->
        <div class="bg-gradient-to-r from-primary to-secondary rounded-2xl p-8 mb-8 text-white">
            <div class="flex items-center gap-4 mb-4">
                <div class="w-16 h-16 bg-white/20 rounded-xl flex items-center justify-center">
                    <span class="text-3xl">{{ categorie.icone|default('📁') }}</span>
                </div>
                <div>
                    <h1 class="text-3xl font-bold mb-2">{{ categorie.titre }}</h1>
                    <p class="text-white/80">{{ categorie.description|default('') }}</p>
                </div>
            </div>
            <div class="flex items-center gap-6 text-sm">
                <span class="bg-white/20 px-3 py-1 rounded-full">
                    {{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}
                </span>
                <span class="bg-white/20 px-3 py-1 rounded-full">
                    {{ categorie.forums|reduce((total, f) => total + f.messages|length, 0) }} message{{ categorie.forums|reduce((total, f) => total + f.messages|length, 0) > 1 ? 's' : '' }}
                </span>
            </div>
        </div>

        <!-- Liste des forums dans cette catégorie -->
        <div class="bg-white rounded-2xl shadow-sm border border-border p-6">
            <h2 class="text-xl font-bold mb-6">Forums dans cette catégorie</h2>

            {% if categorie.forums|length > 0 %}
                <div class="space-y-4">
                    {% for forum in categorie.forums %}
                        <a href="{{ path('app_front_forum_show', {'id': forum.id}) }}"
                           class="block p-6 border border-border rounded-xl hover:border-primary/30 hover:bg-primary/5 transition-all group">
                            <div class="flex items-start justify-between">
                                <div class="flex-1">
                                    <h3 class="font-bold text-lg mb-2 group-hover:text-primary transition-colors">
                                        💬 {{ forum.titre }}
                                    </h3>
                                    <p class="text-muted-foreground mb-3">{{ forum.description }}</p>
                                    <div class="flex items-center gap-4 text-sm text-muted-foreground">
                                        <span>📅 {{ forum.dateCreation ? forum.dateCreation|date('d/m/Y') : '' }}</span>
                                        <span>👤 {{ forum.createdBy ?? 'Anonyme' }}</span>
                                        <span class="px-2 py-1 text-xs rounded-full
                                            {% if forum.etat|lower == 'actif' %}bg-green-100 text-green-700{% else %}bg-red-100 text-red-700{% endif %}">
                                            {{ forum.etat }}
                                        </span>
                                        <span class="bg-primary/10 text-primary px-2 py-1 text-xs rounded-full">
                                            {{ forum.messages|length }} message{{ forum.messages|length > 1 ? 's' : '' }}
                                        </span>
                                    </div>
                                </div>
                                <span class="text-primary font-medium ml-4">Voir →</span>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-12">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <span class="text-2xl">📂</span>
                    </div>
                    <h3 class="text-lg font-medium text-muted-foreground mb-2">Aucun forum dans cette catégorie</h3>
                    <p class="text-muted-foreground">Soyez le premier à créer un forum dans cette catégorie !</p>
                </div>
            {% endif %}
        </div>

        <!-- Bouton retour -->
        <div class="mt-8">
            <a href="{{ path('app_front_forum') }}" 
               class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-border rounded-lg hover:bg-gray-50 transition-colors">
                <i class="bi bi-arrow-left"></i>
                Retour aux forums
            </a>
        </div>

    </div>
</div>
{% endblock %}
