{% extends 'forum/Front/base_front.html.twig' %}

{% block title %}Forums{% endblock %}

{% block head %}
    <!-- Google Charts -->
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
{% endblock %}

{% block body %}
<div class="p-8 min-h-full">
    <div class="max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-3xl font-bold mb-2">Forums de Discussion</h1>
                <p class="text-muted-foreground">Échangez avec la communauté</p>
            </div>
        </div>

        <!-- Section "Votre Activité" -->
        <div class="mb-8">
            <h2 class="text-2xl font-bold mb-6 text-green-600">Votre Activité</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Carte "Vos Forums" -->
                <div class="bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="text-md font-semibold text-gray-700 mb-1">Vos Forums</h3>
                            <p class="text-2xl font-bold text-teal-600">{{ totalForums }}</p>
                        </div>
                        <div class="bg-teal-100 rounded-full p-2">
                            <i data-lucide="message-square" class="w-5 h-5 text-teal-600"></i>
                        </div>
                    </div>
                </div>
                
                <!-- Carte "Messages" -->
                <div class="bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="text-md font-semibold text-gray-700 mb-1">Messages</h3>
                            <p class="text-2xl font-bold text-teal-600">{{ totalMessages }}</p>
                        </div>
                        <div class="bg-teal-100 rounded-full p-2">
                            <i data-lucide="mail" class="w-5 h-5 text-teal-600"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search Bar -->
        <div class="mb-8">
            <form method="GET" action="{{ path('app_front_forum') }}" class="relative">
                <input type="text" 
                       name="search" 
                       value="{{ searchQuery|default('') }}"
                       placeholder="Rechercher dans les forums..." 
                       class="w-full px-4 py-3 pl-10 rounded-lg border border-border focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                <svg class="w-5 h-5 text-muted-foreground absolute left-3 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                {% if searchQuery %}
                    <button type="button" 
                            onclick="window.location.href='{{ path('app_front_forum') }}'"
                            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-sm text-gray-500 hover:text-gray-700">
                        ✕
                    </button>
                {% endif %}
            </form>
        </div>

        <!-- Catégories du Forum -->
        {% if not searchQuery %}
        <div class="mb-8" id="categoriesSection">
            <h2 class="text-2xl font-bold mb-6">Catégories du Forum</h2>
            <div class="space-y-3" id="categoriesList">
                {% for categorie in allCategories %}
                    {% if 'analyse' in categorie.titre|lower or 'numérique' in categorie.titre|lower or 'numerique' in categorie.titre|lower %}
                        <!-- Design pour Analyse Numérique -->
                        <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                           class="block bg-gradient-to-r from-purple-50 to-indigo-50 rounded-xl border-2 border-purple-200 p-6 hover:shadow-lg transition-all hover:border-purple-400 group">
                            <div class="flex items-start gap-4">
                                <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-purple-500 to-indigo-600 rounded-2xl flex items-center justify-center">
                                    <i data-lucide="bar-chart-3" class="w-8 h-8 text-white"></i>
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="px-3 py-1 bg-purple-100 text-purple-700 text-xs font-semibold rounded-full">ANALYSE</span>
                                        <h3 class="font-bold text-xl text-purple-900 group-hover:text-purple-600 transition-colors">{{ categorie.titre }}</h3>
                                    </div>
                                    {% if categorie.description %}
                                        <p class="text-gray-600 mb-3">{{ categorie.description }}</p>
                                    {% endif %}
                                    <div class="flex items-center gap-4 text-sm text-purple-600">
                                        <span class="flex items-center gap-1">
                                            <i data-lucide="pie-chart" class="w-4 h-4"></i>
                                            {{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-shrink-0">
                                    <i data-lucide="chevron-right" class="w-6 h-6 text-purple-400 group-hover:text-purple-600 transition-colors"></i>
                                </div>
                            </div>
                        </a>
                    {% elseif 'réseaux' in categorie.titre|lower or 'reseaux' in categorie.titre|lower or 'infrastructure' in categorie.titre|lower or 'ip' in categorie.titre|lower %}
                        <!-- Design pour Infrastructure Réseaux -->
                        <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                           class="block bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl border-2 border-green-200 p-6 hover:shadow-lg transition-all hover:border-green-400 group">
                            <div class="flex items-start gap-4">
                                <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-green-500 to-emerald-600 rounded-full flex items-center justify-center">
                                    <i data-lucide="network" class="w-8 h-8 text-white"></i>
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-full">RÉSEAUX</span>
                                        <h3 class="font-bold text-xl text-green-900 group-hover:text-green-600 transition-colors">{{ categorie.titre }}</h3>
                                    </div>
                                    {% if categorie.description %}
                                        <p class="text-gray-600 mb-3">{{ categorie.description }}</p>
                                    {% endif %}
                                    <div class="flex items-center gap-4 text-sm text-green-600">
                                        <span class="flex items-center gap-1">
                                            <i data-lucide="wifi" class="w-4 h-4"></i>
                                            {{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-shrink-0">
                                    <i data-lucide="arrow-right" class="w-6 h-6 text-green-400 group-hover:text-green-600 transition-colors"></i>
                                </div>
                            </div>
                        </a>
                    {% elseif 'langages' in categorie.titre|lower or 'langage' in categorie.titre|lower or 'théorie' in categorie.titre|lower or 'theorie' in categorie.titre|lower %}
                        <!-- Design pour Théorie des Langages -->
                        <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                           class="block bg-gradient-to-r from-yellow-50 to-amber-50 rounded-xl border-2 border-yellow-200 p-6 hover:shadow-lg transition-all hover:border-yellow-400 group">
                            <div class="flex items-start gap-4">
                                <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-yellow-500 to-amber-600 rounded-lg flex items-center justify-center transform rotate-3">
                                    <i data-lucide="code" class="w-8 h-8 text-white"></i>
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="px-3 py-1 bg-yellow-100 text-yellow-700 text-xs font-semibold rounded-full">LANGAGES</span>
                                        <h3 class="font-bold text-xl text-yellow-900 group-hover:text-yellow-600 transition-colors">{{ categorie.titre }}</h3>
                                    </div>
                                    {% if categorie.description %}
                                        <p class="text-gray-600 mb-3">{{ categorie.description }}</p>
                                    {% endif %}
                                    <div class="flex items-center gap-4 text-sm text-yellow-600">
                                        <span class="flex items-center gap-1">
                                            <i data-lucide="terminal" class="w-4 h-4"></i>
                                            {{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-shrink-0">
                                    <i data-lucide="move-right" class="w-6 h-6 text-yellow-400 group-hover:text-yellow-600 transition-colors"></i>
                                </div>
                            </div>
                        </a>
                    {% elseif 'environnement' in categorie.titre|lower or 'stratégies' in categorie.titre|lower or 'strategies' in categorie.titre|lower or 'entreprise' in categorie.titre|lower %}
                        <!-- Design pour Environnement & Stratégies -->
                        <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                           class="block bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl border-2 border-blue-200 p-6 hover:shadow-lg transition-all hover:border-blue-400 group">
                            <div class="flex items-start gap-4">
                                <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-lg flex items-center justify-center transform -rotate-3">
                                    <i data-lucide="building" class="w-8 h-8 text-white"></i>
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center gap-2 mb-2">
                                        <span class="px-3 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded-full">STRATÉGIE</span>
                                        <h3 class="font-bold text-xl text-blue-900 group-hover:text-blue-600 transition-colors">{{ categorie.titre }}</h3>
                                    </div>
                                    {% if categorie.description %}
                                        <p class="text-gray-600 mb-3">{{ categorie.description }}</p>
                                    {% endif %}
                                    <div class="flex items-center gap-4 text-sm text-blue-600">
                                        <span class="flex items-center gap-1">
                                            <i data-lucide="trending-up" class="w-4 h-4"></i>
                                            {{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-shrink-0">
                                    <i data-lucide="arrow-right-circle" class="w-6 h-6 text-blue-400 group-hover:text-blue-600 transition-colors"></i>
                                </div>
                            </div>
                        </a>
                    {% else %}
                        <!-- Design par défaut -->
                        <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                           class="flex items-center bg-white rounded-lg border border-border p-4 hover:shadow-md transition-all hover:border-primary/30 hover:bg-primary/5 group">
                            <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mr-4">
                                <i data-lucide="folder" class="w-6 h-6 text-white"></i>
                            </div>
                            <div class="flex-1">
                                <h3 class="font-bold text-lg group-hover:text-primary transition-colors mb-1">{{ categorie.titre }}</h3>
                                {% if categorie.description %}
                                    <p class="text-sm text-muted-foreground">{{ categorie.description }}</p>
                                {% endif %}
                            </div>
                            <div class="flex items-center space-x-6 text-sm text-muted-foreground">
                                <div class="flex items-center space-x-1">
                                    <i data-lucide="message-square" class="w-4 h-4"></i>
                                    <span>{{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}</span>
                                </div>
                            </div>
                            <div class="flex-shrink-0 ml-4">
                                <i data-lucide="chevron-right" class="w-5 h-5 text-muted-foreground group-hover:text-primary transition-colors"></i>
                            </div>
                        </a>
                    {% endif %}
                {% else %}
                    <div class="text-center text-muted-foreground py-10">
                        Aucune catégorie disponible.
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- Résultats de recherche -->
        {% if searchQuery %}
        <div class="mb-8">
            <h2 class="text-2xl font-bold mb-6">
                Résultats de recherche pour "{{ searchQuery }}"
                {% if categories|length > 0 or forums|length > 0 %}
                    <span class="text-sm text-gray-500 ml-2">
                        ({{ categories|length + forums|length }} résultat{{ (categories|length + forums|length) > 1 ? 's' : '' }})
                    </span>
                {% endif %}
            </h2>
            
            <!-- Résultats des catégories -->
            {% if categories|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-lg font-semibold text-gray-700 mb-4">Catégories trouvées</h3>
                    <div class="grid gap-4">
                        {% for categorie in categories %}
                            {% if 'analyse' in categorie.titre|lower or 'numérique' in categorie.titre|lower or 'numerique' in categorie.titre|lower %}
                                <!-- Design pour Analyse Numérique -->
                                <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                                   class="block bg-gradient-to-r from-purple-50 to-indigo-50 rounded-xl border-2 border-purple-200 p-6 hover:shadow-lg transition-all hover:border-purple-400 group">
                                    <div class="flex items-start gap-4">
                                        <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-purple-500 to-indigo-600 rounded-2xl flex items-center justify-center">
                                            <i data-lucide="bar-chart-3" class="w-8 h-8 text-white"></i>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2 mb-2">
                                                <span class="px-3 py-1 bg-purple-100 text-purple-700 text-xs font-semibold rounded-full">{{ categorie.titre|split(' ')[0]|upper }}</span>
                                                <h3 class="font-bold text-xl text-purple-900 group-hover:text-purple-600 transition-colors">{{ categorie.titre }}</h3>
                                            </div>
                                            {% if categorie.description %}
                                                <p class="text-gray-600 mb-3">{{ categorie.description }}</p>
                                            {% endif %}
                                            <div class="flex items-center gap-4 text-sm text-purple-600">
                                                <span class="flex items-center gap-1">
                                                    <i data-lucide="pie-chart" class="w-4 h-4"></i>
                                                    {{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i data-lucide="chevron-right" class="w-6 h-6 text-purple-400 group-hover:text-purple-600 transition-colors"></i>
                                        </div>
                                    </div>
                                </a>
                            {% elseif 'réseaux' in categorie.titre|lower or 'reseaux' in categorie.titre|lower or 'infrastructure' in categorie.titre|lower or 'ip' in categorie.titre|lower %}
                                <!-- Design pour Infrastructure Réseaux -->
                                <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                                   class="block bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl border-2 border-green-200 p-6 hover:shadow-lg transition-all hover:border-green-400 group">
                                    <div class="flex items-start gap-4">
                                        <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-green-500 to-emerald-600 rounded-full flex items-center justify-center">
                                            <i data-lucide="network" class="w-8 h-8 text-white"></i>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2 mb-2">
                                                <span class="px-3 py-1 bg-green-100 text-green-700 text-xs font-semibold rounded-full">{{ categorie.titre|split(' ')[0]|upper }}</span>
                                                <h3 class="font-bold text-xl text-green-900 group-hover:text-green-600 transition-colors">{{ categorie.titre }}</h3>
                                            </div>
                                            {% if categorie.description %}
                                                <p class="text-gray-600 mb-3">{{ categorie.description }}</p>
                                            {% endif %}
                                            <div class="flex items-center gap-4 text-sm text-green-600">
                                                <span class="flex items-center gap-1">
                                                    <i data-lucide="wifi" class="w-4 h-4"></i>
                                                    {{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i data-lucide="arrow-right" class="w-6 h-6 text-green-400 group-hover:text-green-600 transition-colors"></i>
                                        </div>
                                    </div>
                                </a>
                            {% elseif 'langages' in categorie.titre|lower or 'langage' in categorie.titre|lower or 'théorie' in categorie.titre|lower or 'theorie' in categorie.titre|lower %}
                                <!-- Design pour Théorie des Langages -->
                                <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                                   class="block bg-gradient-to-r from-yellow-50 to-amber-50 rounded-xl border-2 border-yellow-200 p-6 hover:shadow-lg transition-all hover:border-yellow-400 group">
                                    <div class="flex items-start gap-4">
                                        <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-yellow-500 to-amber-600 rounded-lg flex items-center justify-center transform rotate-3">
                                            <i data-lucide="code" class="w-8 h-8 text-white"></i>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2 mb-2">
                                                <span class="px-3 py-1 bg-yellow-100 text-yellow-700 text-xs font-semibold rounded-full">{{ categorie.titre|split(' ')[0]|upper }}</span>
                                                <h3 class="font-bold text-xl text-yellow-900 group-hover:text-yellow-600 transition-colors">{{ categorie.titre }}</h3>
                                            </div>
                                            {% if categorie.description %}
                                                <p class="text-gray-600 mb-3">{{ categorie.description }}</p>
                                            {% endif %}
                                            <div class="flex items-center gap-4 text-sm text-yellow-600">
                                                <span class="flex items-center gap-1">
                                                    <i data-lucide="terminal" class="w-4 h-4"></i>
                                                    {{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i data-lucide="move-right" class="w-6 h-6 text-yellow-400 group-hover:text-yellow-600 transition-colors"></i>
                                        </div>
                                    </div>
                                </a>
                            {% elseif 'environnement' in categorie.titre|lower or 'entreprise' in categorie.titre|lower %}
                                <!-- Design pour Environnement & Stratégies -->
                                <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                                   class="block bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl border-2 border-blue-200 p-6 hover:shadow-lg transition-all hover:border-blue-400 group">
                                    <div class="flex items-start gap-4">
                                        <div class="flex-shrink-0 w-16 h-16 bg-gradient-to-br from-blue-500 to-cyan-600 rounded-lg flex items-center justify-center transform -rotate-3">
                                            <i data-lucide="building" class="w-8 h-8 text-white"></i>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2 mb-2">
                                                <span class="px-3 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded-full">{{ categorie.titre|split(' ')[0]|upper }}</span>
                                                <h3 class="font-bold text-xl text-blue-900 group-hover:text-blue-600 transition-colors">{{ categorie.titre }}</h3>
                                            </div>
                                            {% if categorie.description %}
                                                <p class="text-gray-600 mb-3">{{ categorie.description }}</p>
                                            {% endif %}
                                            <div class="flex items-center gap-4 text-sm text-blue-600">
                                                <span class="flex items-center gap-1">
                                                    <i data-lucide="trending-up" class="w-4 h-4"></i>
                                                    {{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex-shrink-0">
                                            <i data-lucide="arrow-right-circle" class="w-6 h-6 text-blue-400 group-hover:text-blue-600 transition-colors"></i>
                                        </div>
                                    </div>
                                </a>
                            {% elseif 'stratégies' in categorie.titre|lower or 'strategies' in categorie.titre|lower %}
                            {% else %}
                                <!-- Design par défaut pour les autres catégories -->
                                <a href="{{ path('app_front_categorie_show', {'id': categorie.id}) }}"
                                   class="flex items-center bg-white rounded-lg border border-border p-4 hover:shadow-md transition-all hover:border-primary/30 hover:bg-primary/5 group">
                                    <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center mr-4">
                                        <i data-lucide="folder" class="w-6 h-6 text-white"></i>
                                    </div>
                                    <div class="flex-1">
                                        <h3 class="font-bold text-lg group-hover:text-primary transition-colors mb-1">{{ categorie.titre }}</h3>
                                        {% if categorie.description %}
                                            <p class="text-sm text-muted-foreground">{{ categorie.description }}</p>
                                        {% endif %}
                                    </div>
                                    <div class="flex items-center space-x-6 text-sm text-muted-foreground">
                                        <div class="flex items-center space-x-1">
                                            <i data-lucide="message-square" class="w-4 h-4"></i>
                                            <span>{{ categorie.forums|length }} forum{{ categorie.forums|length > 1 ? 's' : '' }}</span>
                                        </div>
                                    </div>
                                    <div class="flex-shrink-0 ml-4">
                                        <i data-lucide="chevron-right" class="w-5 h-5 text-muted-foreground group-hover:text-primary transition-colors"></i>
                                    </div>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            
            <!-- Résultats des forums -->
            {% if forums|length > 0 %}
                <div class="mb-6">
                    <h3 class="text-lg font-semibold text-gray-700 mb-4">Forums trouvés</h3>
                    <div class="grid gap-6">
                        {% for forum in forums %}
                            <div class="bg-white rounded-lg shadow-md p-6 border border-gray-200 hover:shadow-lg transition-shadow">
                                <div class="flex justify-between items-start mb-4">
                                    <h3 class="text-xl font-semibold text-gray-800">
                                        <a href="{{ path('app_front_forum_show', {'id': forum.id}) }}" 
                                           class="text-primary hover:text-primary/80 transition-colors">
                                            {{ forum.titre }}
                                        </a>
                                    </h3>
                                    <span class="bg-{{ forum.etat == 'actif' ? 'success' : 'danger' }} text-white text-xs px-2 py-1 rounded-full">
                                        {{ forum.etat }}
                                    </span>
                                </div>
                                <p class="text-gray-600 mb-4 line-clamp-3">
                                    {{ forum.description|u.truncate(200, '...') }}
                                </p>
                                <div class="flex items-center justify-between text-sm text-gray-500">
                                    <div class="flex items-center gap-4">
                                        <span class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                            </svg>
                                            {{ forum.createdBy }}
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                                            </svg>
                                            {{ forum.messages|length }} message{{ forum.messages|length > 1 ? 's' : '' }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            
            <!-- Aucun résultat -->
            {% if categories|length == 0 and forums|length == 0 %}
                <div class="bg-gray-50 rounded-lg p-8 text-center">
                    <h3 class="text-lg font-semibold text-gray-700 mb-2">Aucun résultat trouvé</h3>
                    <p class="text-gray-500">Aucun forum ou catégorie ne correspond à votre recherche "{{ searchQuery }}"</p>
                </div>
            {% endif %}
        </div>
        {% endif %}
    </div>
</div>

<!-- Floating Chatbot Button -->
<button id="chatbotToggle" class="fixed bottom-6 right-6 bg-gradient-to-r from-primary to-secondary text-white rounded-full p-4 shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300 z-40">
    <i data-lucide="bot" class="w-6 h-6"></i>
</button>

<!-- Chatbot Modal -->
<div id="chatbotModal" class="fixed inset-0 bg-black/50 z-50 hidden">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-hidden flex flex-col">

            <!-- Header -->
            <div class="bg-gradient-to-r from-primary to-secondary p-6 flex items-center justify-between flex-shrink-0">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-white/20 rounded-full flex items-center justify-center">
                        <i data-lucide="bot" class="w-6 h-6 text-white"></i>
                    </div>
                    <div class="text-white">
                        <h2 class="font-bold text-xl">Assistant Naja7ni</h2>
                        <p class="text-sm opacity-90">Votre assistant IA pour répondre à toutes vos questions</p>
                    </div>
                </div>
                <button id="closeChatbot" class="text-white hover:bg-white/20 rounded-lg p-2 transition-colors">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <!-- Messages area -->
            <div id="chatMessages" class="flex-1 overflow-y-auto p-6 space-y-4 bg-gray-50" style="min-height: 300px; max-height: 400px;">
                <!-- Message de bienvenue initial -->
                <div class="flex gap-3" id="welcomeMessage">
                    <div class="w-8 h-8 bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center flex-shrink-0">
                        <i data-lucide="bot" class="w-4 h-4 text-white"></i>
                    </div>
                    <div class="bg-white rounded-2xl rounded-tl-none p-4 max-w-md shadow-sm">
                        <p>Bonjour ! Je suis votre assistant Naja7ni. Comment puis-je vous aider aujourd'hui ?</p>
                    </div>
                </div>
            </div>

            <!-- Formulaire d'envoi -->
            <div class="border-t border-border p-4 bg-white flex-shrink-0">
                <form id="chatForm" class="flex gap-3">
                    <div class="flex-1 relative">
                        <input type="text" id="messageInput" placeholder="Tapez votre message ici..."
                            class="w-full px-4 py-3 pr-12 bg-input-background rounded-xl border border-transparent focus:bg-white focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10 transition-all" required>
                        <button type="submit"
                            class="absolute right-2 top-1/2 transform -translate-y-1/2 w-8 h-8 bg-primary text-white rounded-lg hover:bg-primary/90 transition-colors flex items-center justify-center">
                            <i data-lucide="send" class="w-4 h-4"></i>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Boutons rapides -->
            <div class="border-t border-border p-4 bg-gray-50 flex-shrink-0">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <button class="quick-action px-4 py-2 bg-white rounded-xl border border-border hover:border-primary hover:bg-primary/5 transition-all text-sm font-medium" data-message="Bonjour">👋 Bonjour</button>
                    <button class="quick-action px-4 py-2 bg-white rounded-xl border border-border hover:border-primary hover:bg-primary/5 transition-all text-sm font-medium" data-message="J'ai besoin d'aide">💬 Aide</button>
                    <button class="quick-action px-4 py-2 bg-white rounded-xl border border-border hover:border-primary hover:bg-primary/5 transition-all text-sm font-medium" data-message="Merci">🙏 Merci</button>
                    <button class="quick-action px-4 py-2 bg-white rounded-xl border border-border hover:border-primary hover:bg-primary/5 transition-all text-sm font-medium" data-message="Au revoir">👋 Au revoir</button>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
/* Animation de frappe du bot */
.typing-indicator {
    display: inline-flex;
    gap: 4px;
    padding: 8px 0;
}
.typing-indicator span {
    width: 6px;
    height: 6px;
    background-color: #6366f1;
    border-radius: 50%;
    animation: typing 1.4s infinite ease-in-out;
}
.typing-indicator span:nth-child(1) { animation-delay: -0.32s; }
.typing-indicator span:nth-child(2) { animation-delay: -0.16s; }
@keyframes typing {
    0%, 80%, 100% { transform: scale(0.8); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    lucide.createIcons();

    
    /* =========================================================
       CHATBOT — OUVERTURE / FERMETURE
    ========================================================= */
    const chatbotToggle = document.getElementById('chatbotToggle');
    const chatbotModal  = document.getElementById('chatbotModal');
    const closeChatbot  = document.getElementById('closeChatbot');

    function openModal() {
        chatbotModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        setTimeout(function() {
            const mi = document.getElementById('messageInput');
            if (mi) mi.focus();
        }, 100);
    }

    function closeModal() {
        chatbotModal.classList.add('hidden');
        document.body.style.overflow = 'auto';
    }

    if (chatbotToggle) chatbotToggle.addEventListener('click', openModal);
    if (closeChatbot)  closeChatbot.addEventListener('click', closeModal);
    if (chatbotModal)  chatbotModal.addEventListener('click', function(e) {
        if (e.target === chatbotModal) closeModal();
    });
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && !chatbotModal.classList.contains('hidden')) closeModal();
    });

    /* =========================================================
       CHATBOT — FONCTIONS D'AFFICHAGE DES MESSAGES
    ========================================================= */
    const chatMessages = document.getElementById('chatMessages');

    function escapeHtml(text) {
        const d = document.createElement('div');
        d.textContent = text;
        return d.innerHTML;
    }

    function scrollToBottom() {
        if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function addMessage(text, sender, isError) {
        isError = isError || false;
        const d = document.createElement('div');

        if (sender === 'user') {
            d.className = 'flex gap-3 flex-row-reverse';
            d.innerHTML =
                '<div class="w-8 h-8 bg-gradient-to-br from-secondary to-accent rounded-full flex items-center justify-center flex-shrink-0">' +
                    '<i data-lucide="user" class="w-4 h-4 text-white"></i>' +
                '</div>' +
                '<div class="bg-primary text-white rounded-2xl rounded-tr-none p-4 max-w-md shadow-sm">' +
                    '<p>' + escapeHtml(text) + '</p>' +
                '</div>';
        } else {
            d.className = 'flex gap-3';
            d.innerHTML =
                '<div class="w-8 h-8 bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center flex-shrink-0">' +
                    '<i data-lucide="bot" class="w-4 h-4 text-white"></i>' +
                '</div>' +
                '<div class="bg-white rounded-2xl rounded-tl-none p-4 max-w-md shadow-sm' + (isError ? ' border border-red-200' : '') + '">' +
                    '<p class="' + (isError ? 'text-red-600' : '') + '">' + escapeHtml(text) + '</p>' +
                '</div>';
        }

        chatMessages.appendChild(d);
        lucide.createIcons();
        scrollToBottom();
    }

    function showTypingIndicator() {
        const d = document.createElement('div');
        d.id = 'typingIndicator';
        d.className = 'flex gap-3';
        d.innerHTML =
            '<div class="w-8 h-8 bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center flex-shrink-0">' +
                '<i data-lucide="bot" class="w-4 h-4 text-white"></i>' +
            '</div>' +
            '<div class="bg-white rounded-2xl rounded-tl-none p-4 shadow-sm">' +
                '<div class="typing-indicator"><span></span><span></span><span></span></div>' +
            '</div>';
        chatMessages.appendChild(d);
        lucide.createIcons();
        scrollToBottom();
    }

    function removeTypingIndicator() {
        const el = document.getElementById('typingIndicator');
        if (el) el.remove();
    }

    /* =========================================================
       CHATBOT — ENVOI DU MESSAGE VIA L'API
    ========================================================= */
    const chatForm    = document.getElementById('chatForm');
    const messageInput = document.getElementById('messageInput');

    if (chatForm && messageInput) {
        chatForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const message = messageInput.value.trim();
            if (!message) return;

            // Afficher le message de l'utilisateur
            addMessage(message, 'user');
            messageInput.value = '';

            // Afficher l'indicateur de frappe
            showTypingIndicator();

            try {
                const response = await fetch('/api/chatbot/send', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ message: message })
                });

                const data = await response.json();
                removeTypingIndicator();

                if (response.ok && data.bot) {
                    addMessage(data.bot, 'bot');
                } else {
                    // Afficher l'erreur retournée par le serveur
                    addMessage(data.error || 'Une erreur est survenue. Veuillez réessayer.', 'bot', true);
                }

            } catch (error) {
                removeTypingIndicator();
                addMessage('Impossible de contacter le serveur. Vérifiez votre connexion.', 'bot', true);
                console.error('Erreur chatbot:', error);
            }
        });
    }

    /* =========================================================
       BOUTONS RAPIDES
    ========================================================= */
    document.querySelectorAll('.quick-action').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const mi = document.getElementById('messageInput');
            if (mi) {
                mi.value = this.getAttribute('data-message');
                mi.focus();
                // Soumettre automatiquement le message rapide
                chatForm.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
            }
        });
    });

});
</script>
{% endblock %}
