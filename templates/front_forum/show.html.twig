    <script>
        // Stockage des compteurs de likes et dislikes
        let likeCounts = {};
        let dislikeCounts = {};

        // Fonction pour incrémenter le compteur de likes
        function incrementLike(messageId) {
            if (!likeCounts[messageId]) {
                likeCounts[messageId] = 0;
            }
            likeCounts[messageId]++;
