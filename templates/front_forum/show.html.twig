{% extends 'forum/Front/base_front.html.twig' %}



{% block title %}{{ forum.titre }}{% endblock %}



{% block body %}

    <!-- Titre du forum -->
    <div class="forum-title-container">
        <h1 class="forum-title">{{ forum.titre }}</h1>
    </div>

    {# <p>{{ forum.description }}</p> #}

    <!-- Formulaire de publication -->
    <div class="form-section">
        <div class="form-container">
            <h2 class="form-section-title"></h2>

            {{ form_start(form) }}

                <div class="form-field-container">
                    <div class="field-label-container">
                        {{ form_label(form.createdBy, 'Votre nom') }}
                    </div>
                    {{ form_widget(form.createdBy, {'attr': {'placeholder': 'Entrez votre nom...', 'class': 'ckeditor-nom'}}) }}
                </div>

                <div class="form-field-container">
                    <div class="field-label-container">
                        {{ form_label(form.contenu, 'Votre message') }}
                    </div>
                    {{ form_widget(form.contenu, {'attr': {'placeholder': 'Écrivez votre commentaire...', 'class': 'ckeditor-contenu'}}) }}
                </div>

                <div class="button-container">
                    <button class="btn btn-primary publish-button">Publier</button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>



