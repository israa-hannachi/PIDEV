<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
            {# Exemple : inclusion de CSS #}
            <link rel="stylesheet" href="{{ asset('css/app.css') }}">
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}

        {% block javascripts %}
            {# Exemple : inclusion de JS #}
            <script src="{{ asset('js/app.js') }}"></script>
        {% endblock %}
    </body>
</html>
