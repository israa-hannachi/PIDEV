{% extends 'template_back/base_admin.html.twig' %}

{% block title %}Admin - Nouvelle catégorie{% endblock %}
{% block page_title %}Nouvelle catégorie{% endblock %}

{% block admin_content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-0">Nouvelle catégorie</h3>
            <small class="text-muted">Créer une catégorie</small>
        </div>
        <a href="{{ path('app_admin_categorie_index') }}" class="btn btn-outline-secondary btn-sm">Retour</a>
    </div>

    <div class="card">
        <div class="card-body">
            {{ include('admin/categorie/_form.html.twig', {form: form, button_label: 'Créer'}) }}
        </div>
    </div>
{% endblock %}
