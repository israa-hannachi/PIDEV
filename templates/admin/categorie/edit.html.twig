{% extends 'template_back/base_admin.html.twig' %}

{% block title %}Admin - Modifier catégorie{% endblock %}
{% block page_title %}Modifier catégorie{% endblock %}

{% block admin_content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-0">Modifier catégorie</h3>
            <small class="text-muted">{{ categorie.nom }}</small>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_admin_categorie_index') }}" class="btn btn-outline-secondary btn-sm">Retour</a>
            {{ include('admin/categorie/_delete_form.html.twig', {categorie: categorie}) }}
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ include('admin/categorie/_form.html.twig', {form: form, button_label: 'Enregistrer'}) }}
        </div>
    </div>
{% endblock %}
