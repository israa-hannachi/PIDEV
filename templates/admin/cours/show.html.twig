{% extends 'template_back/base_admin.html.twig' %}

{% block title %}Admin - Cours{% endblock %}

{% block page_title %}Détails du cours{% endblock %}

{% block admin_content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-0">{{ cour.titre }}</h3>
            <small class="text-muted">{{ cour.module ? cour.module.titre : 'Sans module' }}</small>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_admin_cours_index') }}" class="btn btn-outline-secondary btn-sm">Retour</a>
            <a href="{{ path('app_admin_cours_edit', {'id': cour.id}) }}" class="btn btn-secondary btn-sm">Modifier</a>
            <a href="{{ path('app_admin_cours_pdf', {'id': cour.id}) }}" class="btn btn-primary btn-sm">PDF</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">{{ cour.description ?: '-' }}</dd>

                <dt class="col-sm-3">Durée</dt>
                <dd class="col-sm-9">{{ cour.duree ?: '-' }}</dd>

                <dt class="col-sm-3">Ordre</dt>
                <dd class="col-sm-9">{{ cour.ordre ?: '-' }}</dd>

                <dt class="col-sm-3">Actif</dt>
                <dd class="col-sm-9">{{ cour.actif ? 'Oui' : 'Non' }}</dd>
            </dl>

            <hr />

            {% if cour.contenu %}
                <div class="prose">{{ cour.contenu|raw }}</div>
            {% elseif cour.fichierContenu %}
                {% set _isRemote = cour.fichierContenu starts with 'http://' or cour.fichierContenu starts with 'https://' %}
                {% set fileUrl = _isRemote ? cour.fichierContenu : asset('uploads/cours_fichiers/' ~ cour.fichierContenu) %}
                <div class="alert alert-info mb-0">
                    Ce cours utilise un fichier:
                    <a href="{{ fileUrl }}" target="_blank" rel="noopener" class="alert-link">Ouvrir / Télécharger</a>
                    <div class="small mt-1">{{ cour.fichierContenu }}</div>
                </div>
            {% else %}
                <div class="alert alert-warning mb-0">Aucun contenu.</div>
            {% endif %}
        </div>
    </div>
{% endblock %}
