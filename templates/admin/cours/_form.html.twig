{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {{ form_errors(form) }}

    <div class="row g-3" data-controller="ai-summary" data-ai-summary-url-value="{{ path('app_ai_summary') }}" data-ai-summary-token-value="{{ csrf_token('ai_summary') }}" data-ai-summary-module-id-value="0">
        <div class="col-12">
            {{ form_row(form.titre) }}
        </div>
        <div class="col-12">
            {{ form_row(form.description) }}
        </div>
        <div class="col-12">
            {{ form_row(form.contenu) }}
        </div>
        <div class="col-12">
            {{ form_row(form.fichierContenu) }}
        </div>
        <div class="col-12 d-flex justify-content-end">
            <button type="button" data-action="ai-summary#generate" class="btn btn-outline-primary btn-sm">Générer résumé (IA)</button>
        </div>
        <div class="col-12">
            {{ form_row(form.resumeAi) }}
        </div>
        <div class="col-12 col-md-4">
            {{ form_row(form.duree) }}
        </div>
        <div class="col-12 col-md-4">
            {{ form_row(form.ordre) }}
        </div>
        <div class="col-12 col-md-4">
            {{ form_row(form.actif) }}
        </div>
        <div class="col-12 col-md-4">
            {{ form_row(form.visible) }}
        </div>
        <div class="col-12 col-md-4">
            {{ form_row(form.visibleFrom) }}
        </div>
        <div class="col-12">
            {{ form_row(form.module) }}
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-end gap-2">
        <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
    </div>
{{ form_end(form) }}

{% set _tinymceKey = (tinymce_api_key|default('')|trim) %}
{% if _tinymceKey %}
    <script src="https://cdn.tiny.cloud/1/{{ _tinymceKey }}/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        if (window.tinymce) {
            window.tinymce.init({
                selector: 'textarea.js-richtext',
                height: 320,
                menubar: false,
                plugins: 'lists link image table code autoresize',
                toolbar: 'undo redo | blocks | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image table | code',
                branding: false
            });
        }
    </script>
{% endif %}

<script>
    document.addEventListener('submit', function (e) {
        if (e.target && e.target.tagName === 'FORM' && window.tinymce && typeof window.tinymce.triggerSave === 'function') {
            window.tinymce.triggerSave();
        }
    }, true);
</script>
