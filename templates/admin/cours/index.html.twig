{% extends 'template_back/base_admin.html.twig' %}

{% block title %}Admin - Cours{% endblock %}

{% block page_title %}Cours{% endblock %}

{% block admin_content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-0">Cours</h3>
            <small class="text-muted">Liste des cours</small>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-outline-secondary btn-sm">Dashboard</a>
            <a href="{{ path('app_admin_cours_new') }}" class="btn btn-primary btn-sm">Nouveau cours</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="btn-group" role="group" aria-label="Tri">
                    <a class="btn btn-outline-secondary btn-sm {{ sort == 'date_desc' ? 'active' : '' }}" href="{{ path('app_admin_cours_index', {sort: 'date_desc'}) }}">Date</a>
                    <a class="btn btn-outline-secondary btn-sm {{ sort == 'alpha_asc' ? 'active' : '' }}" href="{{ path('app_admin_cours_index', {sort: 'alpha_asc'}) }}">A → Z</a>
                    <a class="btn btn-outline-secondary btn-sm {{ sort == 'alpha_desc' ? 'active' : '' }}" href="{{ path('app_admin_cours_index', {sort: 'alpha_desc'}) }}">Z → A</a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Titre</th>
                        <th>Module</th>
                        <th>Date</th>
                        <th>Visible</th>
                        <th>Visible à partir de</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for cour in cours %}
                        <tr>
                            <td>{{ cour.id }}</td>
                            <td class="fw-semibold">{{ cour.titre }}</td>
                            <td>{{ cour.module ? cour.module.titre : '-' }}</td>
                            <td>{{ cour.dateCreation ? cour.dateCreation|date('d/m/Y') : '-' }}</td>
                            <td>
                                <form id="cours_visibility_{{ cour.id }}" method="post" action="{{ path('app_admin_cours_visibility', {'id': cour.id}) }}"></form>
                                <input form="cours_visibility_{{ cour.id }}" type="hidden" name="_token" value="{{ csrf_token('cours_visibility' ~ cour.id) }}">
                                <select form="cours_visibility_{{ cour.id }}" name="visible" class="form-select form-select-sm" style="width: 110px;">
                                    <option value="1" {{ cour.visible ? 'selected' : '' }}>Oui</option>
                                    <option value="0" {{ not cour.visible ? 'selected' : '' }}>Non</option>
                                </select>
                            </td>
                            <td>
                                <input form="cours_visibility_{{ cour.id }}" type="datetime-local" name="visibleFrom" value="{{ cour.visibleFrom ? cour.visibleFrom|date('Y-m-d\\TH:i') : '' }}" class="form-control form-control-sm" style="min-width: 190px;">
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <button form="cours_visibility_{{ cour.id }}" type="submit" class="btn btn-success btn-sm">Appliquer</button>
                                    <a class="btn btn-outline-primary btn-sm" href="{{ path('app_admin_cours_show', {'id': cour.id}) }}">Voir</a>
                                    <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_admin_cours_edit', {'id': cour.id}) }}">Modifier</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Aucun cours.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
