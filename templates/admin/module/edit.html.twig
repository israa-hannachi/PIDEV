{% extends 'template_back/base_admin.html.twig' %}

{% block title %}Admin - Modifier module{% endblock %}
{% block page_title %}Modifier module{% endblock %}

{% block admin_content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-0">Modifier module</h3>
            <small class="text-muted">{{ module.titre }}</small>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_admin_module_index') }}" class="btn btn-outline-secondary btn-sm">Retour</a>
            {{ include('admin/module/_delete_form.html.twig', {module: module}) }}
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ include('admin/module/_form.html.twig', {form: form, button_label: 'Enregistrer'}) }}
        </div>
    </div>
{% endblock %}
