{% extends 'forum/Front/base_front.html.twig' %}

{% block title %}{{ forum.titre }} - Forum{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <!-- Navigation -->
    <nav class="mb-8">
        <div class="flex items-center space-x-2 text-sm text-gray-600">
            <a href="{{ path('app_forum_front') }}" class="hover:text-primary transition-colors">
                <i class="fas fa-home"></i> Accueil
            </a>
            <span>/</span>
            <span class="text-gray-900 font-medium">{{ forum.titre }}</span>
        </div>
    </nav>

    <!-- En-tête du forum -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
        <div class="flex items-start justify-between">
            <div class="flex-1">
                <h1 class="text-3xl font-bold text-gray-900 mb-3">{{ forum.titre }}</h1>
                <p class="text-gray-600 mb-4">{{ forum.description }}</p>
                <div class="flex items-center space-x-4 text-sm text-gray-500">
                    <span>
                        <i class="fas fa-user"></i> 
                        Créé par {{ forum.createdBy }}
                    </span>
                    <span>
                        <i class="fas fa-calendar"></i> 
                        {{ forum.dateCreation ? forum.dateCreation|date('d/m/Y') : '' }}
                    </span>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                        {% if forum.etat == 'actif' %}bg-green-100 text-green-800{% else %}bg-gray-100 text-gray-800{% endif %}">
                        {{ forum.etat }}
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulaire pour publier un message -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4">
            <i class="fas fa-comment-dots text-primary"></i> 
            Publier un message
        </h2>
        {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
            <div class="form-group">
                {{ form_label(form.contenu, 'Votre message', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                {{ form_widget(form.contenu, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent', 'rows': 4}}) }}
                {{ form_errors(form.contenu) }}
            </div>
            <div class="flex justify-end">
                <button type="submit" class="bg-primary text-white px-4 py-2 rounded-md hover:bg-primary/90 transition-colors">
                    <i class="fas fa-paper-plane mr-2"></i>Publier
                </button>
            </div>
        {{ form_end(form) }}
    </div>

    <!-- Messages du forum -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-6">
            <i class="fas fa-comments text-primary"></i> 
            Messages ({{ forum.messages|length }})
        </h2>

        {% if forum.messages is not empty %}
            <div class="space-y-4">
                {% for message in forum.messages %}
                    <div class="border-l-4 border-primary pl-4 py-3 hover:bg-gray-50 transition-colors">
                        <div class="flex items-start justify-between mb-2">
                            <div class="flex items-center space-x-2">
                                <div class="w-8 h-8 bg-primary/10 rounded-full flex items-center justify-center">
                                    <i class="fas fa-user text-primary text-sm"></i>
                                </div>
                                <span class="font-medium text-gray-900">{{ message.createdBy }}</span>
                            </div>
                            <span class="text-sm text-gray-500">
                                <i class="fas fa-clock"></i> 
                                {{ message.datePublication ? message.datePublication|date('d/m/Y H:i') : '' }}
                            </span>
                        </div>
                        <div class="text-gray-700 ml-10">
                            <p class="whitespace-pre-wrap">{{ message.contenu }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-8">
                <i class="fas fa-inbox text-gray-400 text-4xl mb-4"></i>
                <p class="text-gray-500">Aucun message publié pour ce forum.</p>
                <p class="text-sm text-gray-400 mt-2">Soyez le premier à participer à la discussion !</p>
            </div>
        {% endif %}
    </div>

    <!-- Actions -->
    <div class="mt-6 flex justify-between items-center">
        <a href="{{ path('app_forum_front') }}" class="inline-flex items-center text-gray-600 hover:text-primary transition-colors">
            <i class="fas fa-arrow-left mr-2"></i>
            Retour à l'accueil
        </a>
        
        {% if is_granted('ROLE_ADMIN') %}
            <div class="flex space-x-2">
                <a href="{{ path('app_forum_edit', {'id': forum.id}) }}" class="inline-flex items-center px-3 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                    <i class="fas fa-edit mr-2"></i>
                    Modifier
                </a>
                {{ include('forum/_delete_form.html.twig') }}
            </div>
        {% endif %}
    </div>
</div>

<!-- Messages flash -->
{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="fixed top-4 right-4 z-50 alert alert-{{ type }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
{% endfor %}

<script>
// Auto-dismiss flash messages
setTimeout(() => {
    const alerts = document.querySelectorAll('.alert');
    alerts.forEach(alert => {
        const bsAlert = new bootstrap.Alert(alert);
        bsAlert.close();
    });
}, 5000);
</script>
{% endblock %}
