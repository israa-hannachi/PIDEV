<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Naja7ni - Accueil{% endblock %}</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Bootstrap CSS pour les alertes -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome pour les icônes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts with Emoji Support -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Color+Emoji&family=Apple+Color+Emoji&family=Segoe+UI+Emoji&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: '#f8fafc',
                        foreground: '#0f172a',
                        sidebar: '#ffffff',
                        'sidebar-border': '#e2e8f0',
                        primary: '#6366f1',
                        secondary: '#ec4899',
                        accent: '#f59e0b',
                        muted: '#f1f5f9',
                        'muted-foreground': '#64748b',
                        border: '#e1e7ef',
                        'input-background': '#f1f5f9',
                    }
                }
            }
        }
    </script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <!-- CSRF Token -->
    <meta name="csrf-token" content="{{ csrf_token('submit') }}">

    {% block stylesheets %}{% endblock %}

    <style>
        /* ---- CORRECTION DOUBLE SCROLLBAR ---- */
        html, body {
            height: 100%;
            overflow: hidden; /* on bloque le scroll natif du body */
        }

        /* Emoji Support CSS */
        body, .message-author, .message-content, .ck-editor__editable, textarea {
            font-family: 'Noto Sans SC', 'Noto Color Emoji', 'Apple Color Emoji', 'Segoe UI Emoji', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        }
        
        /* Force emoji rendering */
        .emoji {
            font-family: 'Noto Color Emoji', 'Apple Color Emoji', 'Segoe UI Emoji', system-ui, sans-serif;
        }
        
        /* Ensure proper emoji display in all elements */
        * { font-family: inherit; }
        *::before, *::after { font-family: inherit; }

        .sidebar {
            min-height: 100vh;
            background-color: #ffffff;
            padding-top: 20px;
            border-right: 1px solid #e2e8f0;
            width: 80px;
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-shrink: 0; /* empêche la sidebar de rétrécir */
        }
        .sidebar .nav-link {
            color: #0f172a;
            padding: 12px;
            border-radius: 12px;
            margin-bottom: 8px;
            transition: all 0.3s;
            font-weight: 500;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            text-decoration: none;
            font-size: 11px;
        }
        .sidebar .nav-link:hover {
            background-color: #f1f5f9;
            color: #0f172a;
        }
        .sidebar .nav-link.active {
            background-color: white;
            color: black;
        }
        .sidebar .nav-link i {
            font-size: 24px;
            margin-right: 0;
        }
        .sidebar-logo {
            margin-bottom: 30px;
        }
        .sidebar-logo img {
            width: 50px;
            height: 50px;
            object-fit: contain;
        }
        .nav-item.active {
            background-color: #6366f1;
            color: white;
        }
        .nav-item:not(.active):hover {
            background-color: #f1f5f9;
        }
        
        .dropdown {
            position: relative;
            display: inline-block;
        }
        .dropdown-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: white;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            min-width: 150px;
            z-index: 1000;
            margin-top: 8px;
        }
        .dropdown.show .dropdown-menu {
            display: block;
        }
        .dropdown-item {
            display: block;
            padding: 8px 16px;
            color: #0f172a;
            text-decoration: none;
            font-size: 14px;
            transition: background-color 0.2s;
        }
        .dropdown-item:hover {
            background-color: #f1f5f9;
            color: #6366f1;
        }

        /* ---- Zone de contenu scrollable UNIQUE ---- */
        #main-wrapper {
            display: flex;
            height: 100vh;        /* occupe tout l'écran */
            overflow: hidden;     /* pas de scroll ici */
        }

        #right-panel {
            display: flex;
            flex-direction: column;
            flex: 1;
            overflow: hidden;     /* pas de scroll ici non plus */
        }

        /* La navbar du haut est fixe en hauteur */
        #top-navbar {
            flex-shrink: 0;
        }

        /* SEULE zone scrollable : le contenu principal */
        #content {
            flex: 1;
            overflow-y: auto;     /* ← UNE SEULE scrollbar ici */
        }
    </style>
</head>

<body class="bg-background text-foreground font-sans">

    <div id="main-wrapper">

        <!-- Sidebar (ne scroll pas) -->
        <aside class="sidebar">
            <!-- Logo -->
            <div class="sidebar-logo">
                <img src="{{ asset('assets/images/logo-small.png') }}" alt="Logo" />
            </div>
            
            <!-- Navigation -->
            <nav class="nav flex-column">
                <a class="nav-link active" href="#">
                    <i data-lucide="home"></i>
                    Accueil
                </a>
                <a class="nav-link" href="#">
                    <i data-lucide="user"></i>
                    Profil
                </a>
                <a class="nav-link" href="#">
                    <i data-lucide="folder"></i>
                    Catégories
                </a>
                <a class="nav-link" href="#">
                    <i data-lucide="video"></i>
                    Meet
                </a>
                <a class="nav-link" href="#">
                    <i data-lucide="gamepad-2"></i>
                    Jeux
                </a>
                <a class="nav-link" href="#">
                    <i data-lucide="calendar"></i>
                    Events
                </a>
                <a class="nav-link" href="http://127.0.0.1:8000/front/forum">
                    <i data-lucide="message-square"></i>
                    Forums
                </a>
                <a class="nav-link" href="{{ path('app_front_stats') }}">
                    <i data-lucide="bar-chart-2"></i>
                    Statistiques
                </a>
            </nav>
        </aside>

        <!-- Panneau droit (navbar + contenu) -->
        <div id="right-panel">

            <!-- Top Navbar (fixe, ne scroll pas) -->
            <nav id="top-navbar" class="h-16 bg-white border-b border-border px-8 flex items-center justify-between shadow-sm z-10">
                <div class="flex items-center gap-8">
                    <a href="{{ path('app_front_forum') }}">
                        <img src="{{ asset('assets/images/logo-full.png') }}" alt="Naja7ni" class="h-10 object-contain">
                    </a>
                </div>

                <!-- Search Bar -->
                <div class="flex-1 max-w-xl mx-8">
                    <div class="relative group">
                        <i data-lucide="search"
                            class="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-muted-foreground group-focus-within:text-primary transition-colors"></i>
                        <input type="text" placeholder="Rechercher des cours, modules..."
                            class="w-full pl-10 pr-4 py-2.5 bg-input-background rounded-xl border border-transparent focus:bg-white focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10 transition-all duration-300" />
                    </div>
                </div>

                <!-- Right Actions -->
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-500 rounded-xl font-semibold cursor-not-allowed opacity-50">
                        <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                        <span class="hidden md:block">Admin</span>
                    </div>
                    <button class="p-2.5 hover:bg-muted rounded-xl transition-colors relative group">
                        <i data-lucide="bell"
                            class="w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"></i>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-accent rounded-full border border-white"></span>
                    </button>
                    <button class="p-2.5 hover:bg-muted rounded-xl transition-colors group">
                        <i data-lucide="settings"
                            class="w-5 h-5 text-muted-foreground group-hover:text-foreground transition-colors"></i>
                    </button>
                    <div class="dropdown">
                        <div
                            class="w-9 h-9 bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center text-white text-sm font-semibold cursor-pointer shadow-md hover:shadow-lg transition-all transform hover:scale-105"
                            onclick="toggleDropdown()">
                            A
                        </div>
                        <ul class="dropdown-menu" id="userDropdown">
                            <li><a class="dropdown-item" href="/logout">Se déconnecter</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Zone de contenu — SEULE zone avec scroll -->
            <div id="content" class="bg-muted/30">
                <div class="p-8 min-h-full">
                    <div class="max-w-7xl mx-auto space-y-8">

                        <!-- Flash Messages -->
                        {% for type, messages in app.flashes %}
                            {% for message in messages %}
                                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                                    {{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </div>
                            {% endfor %}
                        {% endfor %}

                        {% block body %}{% endblock %}
                    </div>
                </div>
            </div>

        </div>
        <!-- fin #right-panel -->

    </div>
    <!-- fin #main-wrapper -->

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        lucide.createIcons();

        function toggleDropdown() {
            const dropdown = document.querySelector('.dropdown');
            dropdown.classList.toggle('show');
        }

        document.addEventListener('click', function(e) {
            const dropdown = document.querySelector('.dropdown');
            if (!dropdown.contains(e.target)) {
                dropdown.classList.remove('show');
            }
        });

        // Debug: Forcer la création des icônes après le chargement de la page
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Création des icônes Lucide...');
            lucide.createIcons();
            
            // Vérifier si l'icône message-circle existe
            const forumIcon = document.querySelector('[data-lucide="message-circle"]');
            if (forumIcon) {
                console.log('Icône Forums trouvée:', forumIcon);
            } else {
                console.log('Icône Forums non trouvée, tentative de création manuelle...');
                // Créer manuellement l'icône si nécessaire
                setTimeout(() => {
                    lucide.createIcons();
                }, 100);
            }
        });
    </script>
    {% block javascripts %}{% endblock %}
</body>

</html>
