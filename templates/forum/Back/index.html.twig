{% extends 'backoffice/layout.html.twig' %}

{% block page_title %}Liste des Forums{% endblock %}

{% block content %}
<div class="action-buttons">
    <a href="{{ path('app_back_forum_new') }}" class="btn btn-primary btn-action">
        <i class="bi bi-plus-circle"></i> Créer un nouveau forum
    </a>
    <a href="{{ path('app_categorie_new') }}" class="btn btn-success btn-action">
        <i class="bi bi-folder-plus"></i> Ajouter une catégorie
    </a>
    <a href="{{ path('app_back_stats_index') }}" class="btn btn-info btn-action">
        <i class="bi bi-bar-chart"></i> Statistiques
    </a>
    <a href="{{ path('app_back_clustering_index') }}" class="btn btn-warning btn-action">
        <i class="bi bi-cpu"></i> Clustering des discussions
    </a>
    <a href="http://127.0.0.1:8000/front/forum" class="btn btn-secondary btn-action">
        <i class="bi bi-arrow-right-circle"></i> Go to Front
    </a>
</div>

<div class="table-container">
    <h3 class="mb-4">Liste des Forums</h3>
    
    <!-- Search and Filter Section -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="input-group">
                <input type="text" id="searchTitle" class="form-control" placeholder="Rechercher par état">
                <button class="btn btn-outline-secondary" type="button" id="searchBtn">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
        <div class="col-md-3">
            <div class="input-group">
                <input type="text" id="searchCreator" class="form-control" placeholder="Rechercher par créateur">
            </div>
        </div>
        <div class="col-md-3">
            <select id="sortOrder" class="form-select">
                <option value="">Trier par date</option>
                <option value="asc">Date croissante</option>
                <option value="desc">Date décroissante</option>
            </select>
        </div>
        <div class="col-md-3">
            <button id="applyFilters" class="btn btn-primary" onclick="applyFiltersFunction()">APPLIQUER</button>
        </div>
    </div>
    
    <div class="table-responsive">
        <table class="table table-striped table-hover" id="forumsTable">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Titre</th>
                    <th>Créateur</th>
                    <th>Date</th>
                    <th>État</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for forum in pagination %}
                    <tr data-title="{{ forum.titre|default('')|lower }}" data-creator="{{ forum.createdBy|default('')|lower }}" data-etat="{{ forum.etat|default('')|lower }}" data-date="{{ forum.dateCreation ? forum.dateCreation|date('Y-m-d') : '' }}">
                        <td>{{ forum.id }}</td>
                        <td>{{ forum.titre }}</td>
                        <td>{{ forum.createdBy ? forum.createdBy }}</td>
                        <td>{{ forum.dateCreation ? forum.dateCreation|date('d/m/Y') : '' }}</td>
                        <td>
                            <span class="badge bg-{{ forum.etat == 'actif' ? 'success' : 'danger' }}">
                                {{ forum.etat }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('app_back_forum_edit', {'id': forum.id}) }}" 
                               class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form method="post" 
                                  action="{{ path('app_back_forum_delete', {'id': forum.id}) }}"
                                  onsubmit="return confirm('Voulez-vous vraiment supprimer ce forum ?');"
                                  style="display:inline;"
                                  data-turbo="false">
                                 <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ forum.id) }}">
                                 <button type="submit" class="btn btn-sm btn-outline-danger">
                                     <i class="bi bi-trash"></i>
                                 </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted p-5">
                            Aucun forum trouvé.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
<div class="d-flex justify-content-center mt-4">
    {% if pagination.getTotalItemCount() > pagination.getItemNumberPerPage() %}
        <div class="pagination-container">
            {% set currentPage = pagination.getCurrentPageNumber() %}
            {% set totalPages = pagination.getPageCount() %}
            
            <!-- Previous button -->
            {% if currentPage > 1 %}
                <a href="{{ path('app_back_forum_index', {page: currentPage - 1}) }}" 
                   class="page-nav-btn">
                    <i class="fas fa-chevron-left"></i>
                </a>
            {% endif %}
            
            <!-- Page numbers -->
            {% for page in max(1, currentPage - 2)..min(totalPages, currentPage + 2) %}
                {% if page == currentPage %}
                    <span class="page-number active">{{ page }}</span>
                {% else %}
                    <a href="{{ path('app_back_forum_index', {page: page}) }}" 
                       class="page-number">{{ page }}</a>
                {% endif %}
            {% endfor %}
            
            <!-- Next button -->
            {% if currentPage < totalPages %}
                <a href="{{ path('app_back_forum_index', {page: currentPage + 1}) }}" 
                   class="page-nav-btn">
                    <i class="fas fa-chevron-right"></i>
                </a>
            {% endif %}
        </div>
        
        <style>
            .pagination-container {
                display: flex;
                justify-content: center;
                align-items: center;
                background-color: #fff;
                border-radius: 25px;
                box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
                padding: 10px 20px;
                gap: 8px;
            }

            .page-number {
                display: flex;
                justify-content: center;
                align-items: center;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                margin: 0 3px;
                color: #666;
                text-decoration: none;
                font-weight: normal;
                font-size: 14px;
                transition: all 0.3s ease;
                background-color: transparent;
                border: none;
                padding: 0;
            }

            .page-number:hover {
                background-color: #f5f5f5;
                color: #333;
                text-decoration: none;
            }

            .page-number.active {
                background-color: #3b82f6;
                color: #fff;
                font-weight: 600;
            }

            .page-nav-btn {
                display: flex;
                justify-content: center;
                align-items: center;
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background-color: transparent;
                color: #999;
                text-decoration: none;
                font-size: 14px;
                transition: all 0.3s ease;
                border: none;
                padding: 0;
            }

            .page-nav-btn:hover {
                background-color: #f5f5f5;
                color: #666;
                text-decoration: none;
            }
        </style>
    {% endif %}
</div>

<script>
// Stocker les données originales des forums au chargement
let originalForumsData = [];

// Debug: Vérifier les attributs data au chargement
document.addEventListener('DOMContentLoaded', function() {
    const rows = document.querySelectorAll('#forumsTable tbody tr[data-title]');
    console.log('Nombre de lignes trouvées avec data-title:', rows.length);
    
    // Stocker les données originales
    rows.forEach((row, index) => {
        const forumData = {
            title: row.dataset.title || '',
            creator: row.dataset.creator || '',
            etat: row.dataset.etat || '',
            date: row.dataset.date || '',
            element: row.cloneNode(true) // Cloner l'élément original
        };
        originalForumsData.push(forumData);
        console.log(`Ligne ${index}:`, forumData);
    });
    
    // Ajouter l'écouteur d'événement pour la recherche instantanée
    const searchInput = document.getElementById('searchTitle');
    const searchCreatorInput = document.getElementById('searchCreator');
    
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            performInstantSearch();
        });
        console.log('Search input instant listener attached');
    }
    
    if (searchCreatorInput) {
        searchCreatorInput.addEventListener('input', function() {
            performInstantSearch();
        });
        console.log('Search creator input instant listener attached');
    }
});

function performInstantSearch() {
    console.log('Instant search triggered!');
    
    const searchInput = document.getElementById('searchTitle');
    const searchCreatorInput = document.getElementById('searchCreator');
    const sortOrderSelect = document.getElementById('sortOrder');
    const tableBody = document.querySelector('#forumsTable tbody');
    const applyBtn = document.getElementById('applyFilters');
    
    // Ajouter un indicateur de chargement
    if (applyBtn) {
        applyBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Recherche...';
        applyBtn.disabled = true;
    }
    
    const searchTerm = searchInput.value.toLowerCase().trim();
    const searchCreatorTerm = searchCreatorInput.value.toLowerCase().trim();
    const sortOrder = sortOrderSelect.value;
    
    console.log('Filter values:', { searchTerm, searchCreatorTerm, sortOrder });
    console.log('Original forums data length:', originalForumsData.length);
    
    // Si pas de recherche, restaurer toutes les lignes originales
    if (!searchTerm && !searchCreatorTerm && !sortOrder) {
        tableBody.innerHTML = '';
        originalForumsData.forEach(forumData => {
            tableBody.appendChild(forumData.element.cloneNode(true));
        });
        console.log('No search terms, showing all rows');
        
        // Restaurer le bouton
        if (applyBtn) {
            applyBtn.innerHTML = 'APPLIQUER';
            applyBtn.disabled = false;
        }
        return;
    }
    
    // Filter rows - recherche insensible à la casse et aux accents
    let filteredRows = originalForumsData.filter(forumData => {
        const etat = forumData.etat;
        const creator = forumData.creator;
        
        console.log('Checking row:', { etat, creator, searchTerm, searchCreatorTerm });
        
        // Normaliser les chaînes pour gérer les accents et la casse
        const normalizeString = (str) => {
            return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        };
        
        const normalizedEtat = normalizeString(etat);
        const normalizedCreator = normalizeString(creator);
        const normalizedSearchTerm = normalizeString(searchTerm);
        const normalizedSearchCreatorTerm = normalizeString(searchCreatorTerm);
        
        // Pour l'état : cherche les états qui commencent par le terme de recherche
        const etatMatch = !normalizedSearchTerm || normalizedEtat.startsWith(normalizedSearchTerm);
        // Pour le créateur : cherche les créateurs qui contiennent le terme de recherche
        const creatorMatch = !normalizedSearchCreatorTerm || normalizedCreator.includes(normalizedSearchCreatorTerm);
        
        console.log('Match results:', { etatMatch, creatorMatch });
        
        return etatMatch && creatorMatch;
    });
    
    console.log('Filtered rows count:', filteredRows.length);
    
    // Sort rows
    if (sortOrder === 'asc' || sortOrder === 'desc') {
        filteredRows.sort((a, b) => {
            const dateA = a.date ? new Date(a.date) : new Date('1970-01-01');
            const dateB = b.date ? new Date(b.date) : new Date('1970-01-01');
            return sortOrder === 'asc' ? dateA - dateB : dateB - dateA;
        });
    }
    
    // Clear table
    tableBody.innerHTML = '';
    
    // Add filtered/sorted rows
    if (filteredRows.length > 0) {
        filteredRows.forEach(forumData => {
            tableBody.appendChild(forumData.element.cloneNode(true));
        });
    } else {
        // Show no results message
        const noResultsRow = document.createElement('tr');
        noResultsRow.innerHTML = '<td colspan="6" class="text-center text-muted p-5">Aucun forum trouvé pour ces critères.</td>';
        tableBody.appendChild(noResultsRow);
    }
    
    console.log('Filter complete, showing', filteredRows.length, 'results');
    
    // Restaurer le bouton et ajouter un feedback
    if (applyBtn) {
        applyBtn.innerHTML = 'APPLIQUER';
        applyBtn.disabled = false;
        
        // Ajouter une classe temporaire pour montrer que la recherche est terminée
        applyBtn.classList.add('btn-success');
        setTimeout(() => {
            applyBtn.classList.remove('btn-success');
        }, 1000);
    }
}

function applyFiltersFunction() {
    console.log('Apply button clicked!');
    performInstantSearch();
}

// Also add event listeners for search buttons and Enter key
document.addEventListener('DOMContentLoaded', function() {
    const searchBtn = document.getElementById('searchBtn');
    const searchInput = document.getElementById('searchTitle');
    const searchCreatorInput = document.getElementById('searchCreator');
    
    if (searchBtn) {
        searchBtn.onclick = applyFiltersFunction;
        console.log('Search button event listener attached');
    } else {
        console.log('Search button not found!');
    }
    
    if (searchInput) {
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                applyFiltersFunction();
            }
        });
        console.log('Search input event listener attached');
    } else {
        console.log('Search input not found!');
    }
    
    if (searchCreatorInput) {
        searchCreatorInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                applyFiltersFunction();
            }
        });
        console.log('Search creator input event listener attached');
    } else {
        console.log('Search creator input not found!');
    }
});
</script>
{% endblock %}
