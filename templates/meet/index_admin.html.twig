{% extends 'base_back.html.twig' %}

{% block title %}Gestion des Réunions{% endblock %}

{% block page_title %}Gestion des Réunions{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1">Administration des Réunions</h4>
            <p class="text-muted mb-0">Voir, modifier et supprimer les réunions existantes</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_user_index') }}" class="btn btn-light">
                <i class="feather-users me-1"></i>
                Participants
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success d-flex align-items-center" role="alert">
            <i class="feather-check-circle me-2"></i>
            <div>{{ message }}</div>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="feather-alert-circle me-2"></i>
            <div>{{ message }}</div>
        </div>
    {% endfor %}

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Total Réunions</div>
                        <div class="h4 mb-0">{{ meets|length }}</div>
                    </div>
                    <div class="avatar-text avatar-lg">
                        <i class="feather-video"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0">Liste des Réunions</h5>
            </div>
        </div>

        <div class="card-body border-bottom">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label class="form-label">Recherche</label>
                    <input id="adminMeetSearchQ" type="text" placeholder="Titre de réunion" class="form-control" />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label">Professeur</label>
                    <input id="adminMeetSearchTeacher" type="text" placeholder="Nom ou prénom" class="form-control" />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label">Tri</label>
                    <div class="d-flex gap-2">
                        <select id="adminMeetSort" class="form-select">
                            <option value="">Date début</option>
                            <option value="titre">Titre</option>
                            <option value="prof">Prof</option>
                            <option value="dateFin">Date fin</option>
                        </select>
                        <select id="adminMeetDir" class="form-select" style="max-width: 110px;">
                            <option value="ASC">Asc</option>
                            <option value="DESC">Desc</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Réunion</th>
                        <th>Enseignant</th>
                        <th>Période</th>
                        <th>Participants</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="adminMeetsTbody">
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">Chargement...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block page_javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const qEl = document.getElementById('adminMeetSearchQ');
            const teacherEl = document.getElementById('adminMeetSearchTeacher');
            const sortEl = document.getElementById('adminMeetSort');
            const dirEl = document.getElementById('adminMeetDir');
            const tbody = document.getElementById('adminMeetsTbody');

            function escapeHtml(str) {
                return String(str)
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            async function loadAdminMeets() {
                if (!tbody) return;
                const params = new URLSearchParams();
                if (qEl && qEl.value.trim() !== '') params.set('q', qEl.value.trim());
                if (teacherEl && teacherEl.value.trim() !== '') params.set('teacher', teacherEl.value.trim());
                if (sortEl && sortEl.value !== '') params.set('sort', sortEl.value);
                if (dirEl && dirEl.value !== '') params.set('dir', dirEl.value);

                const res = await fetch('{{ path('app_admin_meet_data') }}' + '?' + params.toString(), {
                    headers: { 'Accept': 'application/json' },
                });
                if (!res.ok) return;
                const json = await res.json();
                const items = Array.isArray(json.items) ? json.items : [];

                if (items.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">Aucune réunion trouvée</td>
                        </tr>
                    `;
                    return;
                }

                tbody.innerHTML = items.map(m => {
                    const prof = (m.profNom && m.profPrenom) ? `${escapeHtml(m.profNom)} ${escapeHtml(m.profPrenom)}` : '-';
                    const period = `${escapeHtml(m.dateDebut || '-')}` + ' - ' + `${escapeHtml(m.dateFinTime || '-')}`;
                    const deleteToken = m.deleteToken ? escapeHtml(m.deleteToken) : '';

                    return `
                        <tr>
                            <td>
                                <div class="d-flex flex-column">
                                    <div class="fw-semibold">${escapeHtml(m.titre || '')}</div>
                                    <div class="text-muted small">ID: ${escapeHtml(m.id)}</div>
                                </div>
                            </td>
                            <td>${prof}</td>
                            <td class="text-muted">${period}</td>
                            <td>${escapeHtml(m.participantsCount)}</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a href="${escapeHtml(m.showUrl)}" class="btn btn-sm btn-light" title="Voir">
                                        <i class="feather-eye"></i>
                                    </a>
                                    <a href="${escapeHtml(m.editUrl)}" class="btn btn-sm btn-light" title="Modifier">
                                        <i class="feather-edit"></i>
                                    </a>
                                    <form method="post" action="${escapeHtml(m.deleteUrl)}" style="display: inline-block;" onsubmit="return confirm('Voulez-vous vraiment supprimer cette réunion ?');">
                                        <input type="hidden" name="_token" value="${deleteToken}">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                            <i class="feather-trash-2"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');
            }

            let t = null;
            function scheduleLoad() {
                if (t) clearTimeout(t);
                t = setTimeout(loadAdminMeets, 250);
            }

            [qEl, teacherEl, sortEl, dirEl].forEach(el => {
                if (!el) return;
                el.addEventListener('input', scheduleLoad);
                el.addEventListener('change', scheduleLoad);
            });

            loadAdminMeets();
        });
    </script>
{% endblock %}
