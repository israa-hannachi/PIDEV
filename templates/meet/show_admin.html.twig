{% extends 'base_back.html.twig' %}

{% block title %}Détails réunion{% endblock %}

{% block page_title %}Détails réunion{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h4 class="mb-1">{{ meet.titre }}</h4>
            <p class="text-muted mb-0">ID: {{ meet.id }}</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_admin_meet_index') }}" class="btn btn-light">
                <i class="feather-arrow-left me-1"></i>
                Retour
            </a>
            <a href="{{ path('app_admin_meet_edit', {'id': meet.id}) }}" class="btn btn-primary">
                <i class="feather-edit me-1"></i>
                Modifier
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Enseignant responsable</div>
                    <div class="fw-semibold">
                        {% if meet.participant %}
                            {{ meet.participant.nom }} {{ meet.participant.prenom }}
                        {% else %}
                            -
                        {% endif %}
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Participants inscrits</div>
                    <div class="fw-semibold">{{ meet.participants|length }}</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Date de début</div>
                    <div class="fw-semibold">{{ meet.dateDebut ? meet.dateDebut|date('d/m/Y H:i') : '-' }}</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Date de fin</div>
                    <div class="fw-semibold">{{ meet.dateFin ? meet.dateFin|date('d/m/Y H:i') : '-' }}</div>
                </div>
                <div class="col-12">
                    <div class="text-muted small">Description</div>
                    <div class="fw-semibold">{{ meet.description ?: '-' }}</div>
                </div>
                <div class="col-12">
                    <div class="text-muted small">Lien</div>
                    <div class="fw-semibold">
                        {% if meet.lienMeet %}
                            <a href="{{ meet.lienMeet }}" target="_blank" rel="noopener noreferrer">{{ meet.lienMeet }}</a>
                        {% else %}
                            -
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                <form method="post" action="{{ path('app_admin_meet_delete', {'id': meet.id }) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cette réunion ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ meet.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="feather-trash-2 me-1"></i>
                        Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
