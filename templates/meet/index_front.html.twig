{% extends 'base_front.html.twig' %}

{% block title %}Liste des réunions{% endblock %}

{% block body %}
<div class="p-8 min-h-full">
    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
            <div>
                <h1 class="text-3xl font-bold mb-2">Réunions Virtuelles</h1>
                <p class="text-muted-foreground">Participez à vos cours en direct</p>
            </div>
            <div class="flex gap-3">
                <a href="{{ path('app_meet_new') }}" class="bg-primary text-white px-6 py-3 rounded-xl hover:bg-primary/90 transition-all hover:shadow-lg flex items-center gap-2 font-medium">
                    <i data-lucide="plus" class="w-5 h-5"></i>
                    Nouvelle réunion
                </a>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-border p-4 mb-8">
            <div class="flex flex-col gap-3">
                <div class="flex flex-col md:flex-row gap-3 md:items-end">
                    <div class="flex-1">
                        <label class="block text-sm font-medium mb-2">Cours</label>
                        <input id="meetSearchCourse" type="text" value="{{ search_course|default('') }}" placeholder="Rechercher par cours"
                            class="form-control w-full px-4 py-3 rounded-xl focus:ring-4 transition-all" />
                    </div>
                    <div class="flex-1">
                        <label class="block text-sm font-medium mb-2">Professeur</label>
                        <input id="meetSearchTeacher" type="text" value="{{ search_teacher|default('') }}" placeholder="Rechercher par nom de prof"
                            class="form-control w-full px-4 py-3 rounded-xl focus:ring-4 transition-all" />
                    </div>
                    <div class="flex gap-2">
                        <button type="button" id="meetSearchReset" class="btn btn-secondary px-6 py-3 rounded-xl transition-all flex items-center gap-2 font-medium">
                            <i data-lucide="x" class="w-5 h-5"></i>
                            Reset
                        </button>
                    </div>
                </div>
                <div class="flex flex-col md:flex-row gap-3 md:items-end">
                    <div class="w-full md:w-72">
                        <label class="block text-sm font-medium mb-2">Tri</label>
                        <div class="flex gap-2">
                            <select id="meetSort" class="form-control w-full px-4 py-3 rounded-xl focus:ring-4 transition-all">
                                <option value="">Date début</option>
                                <option value="titre">Titre</option>
                                <option value="prof">Prof</option>
                                <option value="dateFin">Date fin</option>
                            </select>
                            <select id="meetDir" class="form-control px-4 py-3 rounded-xl focus:ring-4 transition-all" style="max-width: 110px;">
                                <option value="ASC">Asc</option>
                                <option value="DESC">Desc</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Messages Flash -->
        {% for message in app.flashes('success') %}
            <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-4 flex items-center gap-2">
                <i data-lucide="check-circle" class="w-5 h-5"></i>
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-4 flex items-center gap-2">
                <i data-lucide="alert-circle" class="w-5 h-5"></i>
                {{ message }}
            </div>
        {% endfor %}

        <!-- Quick Join -->
        <div class="bg-gradient-to-r from-primary to-secondary rounded-2xl p-8 text-white mb-8 shadow-xl relative overflow-hidden">
            <div class="absolute inset-0 bg-white/5 pattern-dots"></div>
            <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
                <div>
                    <h2 class="text-2xl font-bold mb-2">Rejoindre une réunion</h2>
                    <p class="text-white/90">Entrez le code de la réunion pour participer</p>
                </div>
                <form method="get" action="{{ path('app_meet_join_code') }}" class="flex gap-3 w-full md:w-auto">
                    <input name="code" type="text" placeholder="Entrer le code (ex: MEET-1)"
                        class="flex-1 md:w-64 px-4 py-3 rounded-xl bg-white/20 backdrop-blur-sm border border-white/30 text-white placeholder-white/60 focus:outline-none focus:ring-2 focus:ring-white/50 transition-all" />
                    <button type="submit" class="bg-white text-primary px-6 py-3 rounded-xl hover:bg-white/90 transition-colors font-bold shadow-lg">Rejoindre</button>
                </form>
            </div>
        </div>

        <!-- Section pour créer une réunion (visible seulement pour les enseignants) -->
        <div id="teacherSection" class="hidden mb-8">
            <div class="bg-gradient-to-r from-green-500 to-emerald-600 rounded-2xl p-8 text-white shadow-xl relative overflow-hidden">
                <div class="absolute inset-0 bg-white/5 pattern-dots"></div>
                <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
                    <div>
                        <h2 class="text-2xl font-bold mb-2 flex items-center gap-2">
                            <i data-lucide="video" class="w-6 h-6"></i>
                            Créer une réunion
                        </h2>
                        <p class="text-white/90">En tant qu'enseignant, vous pouvez créer des réunions virtuelles pour vos étudiants</p>
                    </div>
                    <button id="createMeetingBtn" class="bg-white text-green-600 px-6 py-3 rounded-xl hover:bg-white/90 transition-colors font-bold shadow-lg flex items-center gap-2">
                        <i data-lucide="plus" class="w-5 h-5"></i>
                        Créer une réunion
                    </button>
                </div>
            </div>
        </div>

        <!-- Upcoming Meetings -->
        <h2 class="text-2xl font-bold mb-6">Réunions à venir</h2>
        <div id="meetList" class="space-y-4"></div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Vérifier le rôle de l'utilisateur connecté
        document.addEventListener('DOMContentLoaded', function() {
            const userRole = localStorage.getItem('userRole') || 'etudiant';
            const teacherSection = document.getElementById('teacherSection');
            
            if (teacherSection) {
                if (userRole === 'enseignant') {
                    teacherSection.classList.remove('hidden');
                } else {
                    teacherSection.classList.add('hidden');
                }
            }
            
            // Gestion du bouton créer une réunion
            const createMeetingBtn = document.getElementById('createMeetingBtn');
            if (createMeetingBtn) {
                createMeetingBtn.addEventListener('click', function() {
                    window.location.href = '{{ path('app_meet_new') }}';
                });
            }
            
            // Initialiser Lucide icons
            if (window.lucide) {
                window.lucide.createIcons();
            }

            const courseEl = document.getElementById('meetSearchCourse');
            const teacherEl = document.getElementById('meetSearchTeacher');
            const sortEl = document.getElementById('meetSort');
            const dirEl = document.getElementById('meetDir');
            const resetBtn = document.getElementById('meetSearchReset');
            const listEl = document.getElementById('meetList');

            function escapeHtml(str) {
                return String(str)
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function formatDuration(tsStart, tsEnd) {
                if (!tsStart || !tsEnd) return '-';
                const diff = tsEnd - tsStart;
                const hours = Math.floor(diff / 3600);
                const minutes = Math.floor((diff % 3600) / 60);
                if (hours > 0) return `${hours}h${minutes > 0 ? minutes + 'min' : ''}`;
                return `${minutes}min`;
            }

            function renderMeetCard(m) {
                const profInitial = m.profInitial ? escapeHtml(m.profInitial) : '?';
                const profNom = m.profNom ? escapeHtml(m.profNom) : '';
                const profPrenom = m.profPrenom ? escapeHtml(m.profPrenom) : '';
                const profLine = (profNom || profPrenom) ? `Prof. ${profNom} ${profPrenom}` : 'Prof.';

                const participantsCount = typeof m.participantsCount === 'number' ? m.participantsCount : 0;
                const duration = formatDuration(m.timestampDebut, m.timestampFin);
                const dateDebut = m.dateDebut ? escapeHtml(m.dateDebut) : '-';

                let joinBlock = '';
                if (m.isEnded) {
                    joinBlock = `
                        <span class="w-full md:w-auto bg-muted text-muted-foreground px-8 py-3 rounded-xl shadow-md flex items-center justify-center gap-2 font-medium cursor-not-allowed">
                            <i data-lucide="ban" class="w-5 h-5"></i>
                            Réunion terminée
                        </span>
                    `;
                } else if (m.isNotStarted) {
                    joinBlock = `
                        <span class="w-full md:w-auto bg-muted text-muted-foreground px-8 py-3 rounded-xl shadow-md flex items-center justify-center gap-2 font-medium cursor-not-allowed">
                            <i data-lucide="clock" class="w-5 h-5"></i>
                            Disponible à ${escapeHtml(m.dateDebutTime || '')}
                        </span>
                    `;
                } else {
                    joinBlock = `
                        <a href="${escapeHtml(m.joinUrl)}" class="w-full md:w-auto bg-primary text-white px-8 py-3 rounded-xl hover:bg-primary/90 transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 font-medium">
                            <i data-lucide="video" class="w-5 h-5"></i>
                            Rejoindre la réunion
                        </a>
                    `;
                }

                let teacherActions = '';
                if (userRole === 'enseignant') {
                    const deleteToken = m.deleteToken ? escapeHtml(m.deleteToken) : '';
                    teacherActions = `
                        <a href="${escapeHtml(m.editUrl)}" class="w-full md:w-auto bg-white text-secondary border border-secondary px-8 py-3 rounded-xl hover:bg-secondary/5 transition-all flex items-center justify-center gap-2 font-medium">
                            <i data-lucide="edit" class="w-5 h-5"></i>
                            Modifier
                        </a>
                        <form method="post" action="${escapeHtml(m.deleteUrl)}" style="display: inline-block;">
                            <input type="hidden" name="_token" value="${deleteToken}">
                            <button type="submit" class="w-full md:w-auto bg-white text-yellow-700 border border-yellow-600 px-8 py-3 rounded-xl hover:bg-yellow-50 transition-all flex items-center justify-center gap-2 font-medium">
                                <i data-lucide="trash-2" class="w-5 h-5"></i>
                                Supprimer
                            </button>
                        </form>
                    `;
                }

                return `
                    <div class="bg-white rounded-2xl shadow-sm border border-border p-8 hover:shadow-lg transition-all">
                        <div class="flex flex-col md:flex-row items-start justify-between gap-6">
                            <div class="flex-1">
                                <h3 class="text-xl font-bold mb-3">${escapeHtml(m.titre || '')}</h3>
                                <p class="text-sm text-muted-foreground mb-3 flex items-center gap-2">
                                    <span class="w-8 h-8 rounded-full bg-muted flex items-center justify-center text-xs font-bold">${profInitial}</span>
                                    ${profLine}
                                </p>
                                <div class="flex flex-wrap gap-4 text-sm text-muted-foreground">
                                    <div class="flex items-center gap-2 bg-muted/50 px-3 py-1.5 rounded-lg">
                                        <i data-lucide="calendar" class="w-4 h-4 text-primary"></i>
                                        ${dateDebut}
                                    </div>
                                    <div class="flex items-center gap-2 bg-muted/50 px-3 py-1.5 rounded-lg">
                                        <i data-lucide="clock" class="w-4 h-4 text-primary"></i>
                                        ${duration}
                                    </div>
                                    <div class="flex items-center gap-2 bg-muted/50 px-3 py-1.5 rounded-lg">
                                        <i data-lucide="users" class="w-4 h-4 text-primary"></i>
                                        Participants
                                        <span class="ml-1 inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full bg-primary/10 text-primary text-xs font-bold">${escapeHtml(participantsCount)}</span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex flex-col md:flex-row gap-3">
                                ${joinBlock}
                                <a href="${escapeHtml(m.showUrl)}" class="w-full md:w-auto bg-white text-primary border border-primary px-8 py-3 rounded-xl hover:bg-primary/5 transition-all flex items-center justify-center gap-2 font-medium">
                                    <i data-lucide="eye" class="w-5 h-5"></i>
                                    Voir les détails
                                </a>
                                ${teacherActions}
                            </div>
                        </div>
                    </div>
                `;
            }

            async function loadMeets() {
                if (!listEl) return;
                const params = new URLSearchParams();
                if (courseEl && courseEl.value.trim() !== '') params.set('course', courseEl.value.trim());
                if (teacherEl && teacherEl.value.trim() !== '') params.set('teacher', teacherEl.value.trim());
                if (sortEl && sortEl.value !== '') params.set('sort', sortEl.value);
                if (dirEl && dirEl.value !== '') params.set('dir', dirEl.value);

                const res = await fetch('{{ path('app_meet_data') }}' + '?' + params.toString(), {
                    headers: { 'Accept': 'application/json' },
                });
                if (!res.ok) return;
                const json = await res.json();
                const items = Array.isArray(json.items) ? json.items : [];

                if (items.length === 0) {
                    listEl.innerHTML = `
                        <div class="text-center py-12">
                            <i data-lucide="video" class="w-12 h-12 text-muted-foreground mx-auto mb-4"></i>
                            <h3 class="text-lg font-medium text-muted-foreground mb-2">Aucune réunion trouvée</h3>
                        </div>
                    `;
                } else {
                    listEl.innerHTML = items.map(renderMeetCard).join('');
                }

                if (window.lucide) {
                    window.lucide.createIcons();
                }
            }

            let t = null;
            function scheduleLoad() {
                if (t) clearTimeout(t);
                t = setTimeout(loadMeets, 250);
            }

            [courseEl, teacherEl, sortEl, dirEl].forEach(el => {
                if (!el) return;
                el.addEventListener('input', scheduleLoad);
                el.addEventListener('change', scheduleLoad);
            });

            if (resetBtn) {
                resetBtn.addEventListener('click', () => {
                    if (courseEl) courseEl.value = '';
                    if (teacherEl) teacherEl.value = '';
                    if (sortEl) sortEl.value = '';
                    if (dirEl) dirEl.value = 'ASC';
                    loadMeets();
                });
            }

            loadMeets();
        });
    </script>
{% endblock %}
