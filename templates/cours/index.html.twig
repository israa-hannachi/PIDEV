{% extends 'naja7ni/base.html.twig' %}

{% block title %}Cours index{% endblock %}

{% block body %}
    <div class="mb-8 flex items-start justify-between gap-6">
        <div>
            <h1 class="text-3xl font-bold">Cours</h1>
            <p class="text-sm text-muted-foreground">Liste des cours disponibles.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="{{ path('app_favoris_index') }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-border font-semibold hover:bg-muted transition">
                <i data-lucide="star" class="w-4 h-4"></i>
                Mes favoris
            </a>

            {% set _sort = app.request.query.get('sort')|default('date_desc') %}
            {% set _sortLabel = _sort == 'alpha_asc' ? 'A → Z' : (_sort == 'alpha_desc' ? 'Z → A' : 'Date') %}
            <details class="relative">
                <summary class="list-none cursor-pointer inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-border font-semibold hover:bg-muted transition">
                    <i data-lucide="arrow-up-down" class="w-4 h-4"></i>
                    Trier ({{ _sortLabel }})
                </summary>
                <div class="absolute right-0 mt-2 w-56 bg-white border border-border rounded-xl shadow-lg overflow-hidden z-20">
                    <a class="block px-4 py-2.5 text-sm hover:bg-muted/30 transition" href="{{ path('app_cours_index', app.request.query.all|merge({'sort': 'date_desc'})) }}">Date (récent)</a>
                    <a class="block px-4 py-2.5 text-sm hover:bg-muted/30 transition" href="{{ path('app_cours_index', app.request.query.all|merge({'sort': 'alpha_asc'})) }}">A → Z</a>
                    <a class="block px-4 py-2.5 text-sm hover:bg-muted/30 transition" href="{{ path('app_cours_index', app.request.query.all|merge({'sort': 'alpha_desc'})) }}">Z → A</a>
                </div>
            </details>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-border p-8">
        {% if cours|length > 0 %}
            <div class="space-y-3">
                {% for cour in cours %}
                    <div data-controller="ai-summary-display" data-ai-summary-display-url-value="{{ path('app_ai_summary_cours', {'id': cour.id}) }}" data-ai-summary-display-pdf-url-value="{{ path('app_ai_summary_cours_pdf', {'id': cour.id}) }}" data-ai-summary-display-token-value="{{ csrf_token('ai_summary_cours' ~ cour.id) }}" data-ai-summary-display-pdf-token-value="{{ csrf_token('ai_summary_cours_pdf' ~ cour.id) }}">
                    <div class="flex items-center justify-between gap-4 p-4 bg-muted/30 rounded-xl hover:bg-muted/60 transition-colors">
                        <div class="flex items-start gap-3">
                            <i data-lucide="book-open" class="w-5 h-5 text-primary mt-0.5"></i>
                            <div>
                                <div class="flex items-center gap-2">
                                    <h3 class="font-semibold">{{ cour.titre }}</h3>
                                    <span class="text-xs text-muted-foreground bg-white px-2 py-0.5 rounded border border-border">#{{ cour.id }}</span>
                                </div>
                                {% if cour.description %}
                                    <p class="text-sm text-muted-foreground">{{ cour.description|slice(0, 140) }}{% if cour.description|length > 140 %}...{% endif %}</p>
                                {% endif %}
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            {% set _isFavori = favoris_ids is defined and (cour.id in favoris_ids) %}
                            <form method="post" action="{{ path('app_favoris_toggle', {'id': cour.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_favori' ~ cour.id) }}">
                                <button type="submit" class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-border hover:bg-muted transition" title="{{ _isFavori ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">
                                    <i data-lucide="star" class="w-5 h-5 {{ _isFavori ? 'text-accent' : 'text-muted-foreground' }}"></i>
                                </button>
                            </form>

                            <a href="{{ path('app_cours_show', {'id': cour.id}) }}" class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-white border border-border font-semibold hover:bg-muted transition">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                                Voir
                            </a>
                            <button type="button" data-ai-summary-display-target="button" data-action="ai-summary-display#generate" class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-white border border-border font-semibold hover:bg-muted transition">
                                Résumé IA
                            </button>
                            <button type="button" data-ai-summary-display-target="download" data-action="ai-summary-display#downloadPdf" class="hidden inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-primary text-white font-semibold shadow hover:shadow-md transition">
                                PDF
                            </button>
                            <a href="{{ path('app_cours_edit', {'id': cour.id}) }}" class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-primary text-white font-semibold shadow hover:shadow-md transition">
                                <i data-lucide="pencil" class="w-4 h-4"></i>
                                Modifier
                            </a>
                        </div>
                    </div>
                    <textarea data-ai-summary-display-target="textarea" class="hidden mt-2 w-full min-h-[140px] p-4 rounded-xl border border-border bg-white text-sm" placeholder="Le résumé apparaîtra ici. Tu peux le modifier avant téléchargement."></textarea>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="p-4 rounded-xl border border-border bg-muted/20 text-sm text-muted-foreground">Aucun cours trouvé.</div>
        {% endif %}
    </div>
{% endblock %}
