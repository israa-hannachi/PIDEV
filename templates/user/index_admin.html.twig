{% extends 'base_back.html.twig' %}

{% block title %}Gestion des Participants{% endblock %}

{% block page_title %}Gestion des Participants{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="mb-1">Administration des Participants</h4>
            <p class="text-muted mb-0">Gestion complète des utilisateurs et participants</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_meet_index') }}" class="btn btn-light">
                <i class="feather-arrow-left me-1"></i>
                Retour aux réunions
            </a>
            <a href="{{ path('app_user_new') }}" class="btn btn-primary">
                <i class="feather-user-plus me-1"></i>
                Ajouter un participant
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success d-flex align-items-center" role="alert">
            <i class="feather-check-circle me-2"></i>
            <div>{{ message }}</div>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="feather-alert-circle me-2"></i>
            <div>{{ message }}</div>
        </div>
    {% endfor %}

    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Total Participants</div>
                        <div class="h4 mb-0">{{ participants|length }}</div>
                    </div>
                    <div class="avatar-text avatar-lg">
                        <i class="feather-users"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Enseignants</div>
                        <div class="h4 mb-0">{{ participants|filter(p => p.role == 'enseignant')|length }}</div>
                    </div>
                    <div class="avatar-text avatar-lg">
                        <i class="feather-award"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Étudiants</div>
                        <div class="h4 mb-0">{{ participants|filter(p => p.role == 'etudiant')|length }}</div>
                    </div>
                    <div class="avatar-text avatar-lg">
                        <i class="feather-book"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Admins</div>
                        <div class="h4 mb-0">{{ participants|filter(p => p.role == 'administrateur')|length }}</div>
                    </div>
                    <div class="avatar-text avatar-lg">
                        <i class="feather-shield"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="card-title mb-0">Liste des Participants</h5>
            </div>
        </div>

        <div class="card-body border-bottom">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label class="form-label">Recherche</label>
                    <input id="adminSearchQ" type="text" placeholder="Nom, prénom ou email" class="form-control" />
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label">Rôle</label>
                    <select id="adminSearchRole" class="form-select">
                        <option value="">Tous</option>
                        <option value="enseignant">Enseignant</option>
                        <option value="etudiant">Étudiant</option>
                        <option value="administrateur">Admin</option>
                    </select>
                </div>
                <div class="col-12 col-md-6 col-lg-3">
                    <label class="form-label">Tri</label>
                    <div class="d-flex gap-2">
                        <select id="adminSort" class="form-select">
                            <option value="createdAt">Date</option>
                            <option value="nom">Nom</option>
                            <option value="email">Email</option>
                            <option value="role">Rôle</option>
                        </select>
                        <select id="adminDir" class="form-select" style="max-width: 110px;">
                            <option value="ASC">Asc</option>
                            <option value="DESC">Desc</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>Réunions</th>
                        <th>Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="adminParticipantsTbody">
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">Chargement...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block page_javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const qEl = document.getElementById('adminSearchQ');
            const roleEl = document.getElementById('adminSearchRole');
            const sortEl = document.getElementById('adminSort');
            const dirEl = document.getElementById('adminDir');
            const tbody = document.getElementById('adminParticipantsTbody');

            function escapeHtml(str) {
                return String(str)
                    .replaceAll('&', '&amp;')
                    .replaceAll('<', '&lt;')
                    .replaceAll('>', '&gt;')
                    .replaceAll('"', '&quot;')
                    .replaceAll("'", '&#039;');
            }

            function roleBadge(role) {
                if (role === 'enseignant') {
                    return '<span class="badge bg-success">Enseignant</span>';
                }
                if (role === 'administrateur') {
                    return '<span class="badge bg-dark">Admin</span>';
                }
                return '<span class="badge bg-primary">Étudiant</span>';
            }

            async function loadAdminParticipants() {
                if (!tbody) return;
                const params = new URLSearchParams();
                if (qEl && qEl.value.trim() !== '') params.set('q', qEl.value.trim());
                if (roleEl && roleEl.value !== '') params.set('role', roleEl.value);
                if (sortEl && sortEl.value !== '') params.set('sort', sortEl.value);
                if (dirEl && dirEl.value !== '') params.set('dir', dirEl.value);

                const res = await fetch('{{ path('app_user_data') }}' + '?' + params.toString(), {
                    headers: { 'Accept': 'application/json' },
                });
                if (!res.ok) return;
                const json = await res.json();

                const items = Array.isArray(json.items) ? json.items : [];
                if (items.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">Aucun participant trouvé</td>
                        </tr>
                    `;
                    return;
                }

                tbody.innerHTML = items.map(p => {
                    const createdAt = p.createdAt ? escapeHtml(p.createdAt) : '-';
                    const deleteToken = p.deleteToken ? escapeHtml(p.deleteToken) : '';

                    return `
                        <tr>
                            <td>
                                <div class="d-flex flex-column">
                                    <div class="fw-semibold">${escapeHtml(p.nom)} ${escapeHtml(p.prenom)}</div>
                                    <div class="text-muted small">ID: ${escapeHtml(p.id)}</div>
                                </div>
                            </td>
                            <td>${escapeHtml(p.email)}</td>
                            <td>${roleBadge(p.role)}</td>
                            <td>${escapeHtml(p.meetsCount)}</td>
                            <td class="text-muted">${createdAt}</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a href="{{ path('app_user_show', {'id': '__ID__'}) }}" class="btn btn-sm btn-light" title="Voir">
                                        <i class="feather-eye"></i>
                                    </a>
                                    <a href="{{ path('app_user_edit', {'id': '__ID__'}) }}" class="btn btn-sm btn-light" title="Modifier">
                                        <i class="feather-edit"></i>
                                    </a>
                                    <form method="post" action="{{ path('app_user_delete', {'id': '__ID__'}) }}" style="display: inline-block;" onsubmit="return confirm('Voulez-vous vraiment supprimer ce participant ?');">
                                        <input type="hidden" name="_token" value="${deleteToken}">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                            <i class="feather-trash-2"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    `.replaceAll('__ID__', String(p.id));
                }).join('');
            }

            let t = null;
            function scheduleLoad() {
                if (t) clearTimeout(t);
                t = setTimeout(loadAdminParticipants, 250);
            }

            [qEl, roleEl, sortEl, dirEl].forEach(el => {
                if (!el) return;
                el.addEventListener('input', scheduleLoad);
                el.addEventListener('change', scheduleLoad);
            });

            loadAdminParticipants();
        });
    </script>
{% endblock %}
