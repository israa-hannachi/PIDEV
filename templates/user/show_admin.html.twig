{% extends 'base_back.html.twig' %}

{% block title %}Détails participant{% endblock %}

{% block page_title %}Détails participant{% endblock %}

{% block admin_content %}
<div class="container-fluid">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h4 class="mb-1">{{ participant.nom }} {{ participant.prenom }}</h4>
            <p class="text-muted mb-0">{{ participant.email }}</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_user_index') }}" class="btn btn-light">
                <i class="feather-arrow-left me-1"></i>
                Retour
            </a>
            <a href="{{ path('app_user_edit', {'id': participant.id}) }}" class="btn btn-primary">
                <i class="feather-edit me-1"></i>
                Modifier
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Rôle</div>
                    <div class="fw-semibold">{{ participant.role }}</div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="text-muted small">Date de création</div>
                    <div class="fw-semibold">{{ participant.createdAt ? participant.createdAt|date('d/m/Y H:i') : '-' }}</div>
                </div>
                <div class="col-12">
                    <div class="text-muted small">Réunions associées</div>
                    <div class="fw-semibold">{{ participant.meets|length }}</div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                <form method="post" action="{{ path('app_user_delete', {'id': participant.id }) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce participant ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ participant.id) }}">
                    <button type="submit" class="btn btn-danger">
                        <i class="feather-trash-2 me-1"></i>
                        Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
