<script>
    // Charger CKEditor de manière asynchrone pour améliorer les performances
    function loadCKEditor() {
        const script = document.createElement('script');
        script.src = 'https://cdn.ckeditor.com/ckeditor5/39.0.0/classic/ckeditor.js';
        script.async = true;
        script.onload = initializeCKEditors;
        document.head.appendChild(script);
    }

    // Initialiser les éditeurs seulement après le chargement complet de la page
    function initializeCKEditors() {
        setTimeout(() => {
            initCKEditorInstances();
        }, 100);
    }
</script>

