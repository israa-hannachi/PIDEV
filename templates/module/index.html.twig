{% extends 'naja7ni/base.html.twig' %}

{% block title %}Module index{% endblock %}

{% block body %}
    <div class="mb-8 flex items-start justify-between gap-6">
        <div>
            <h1 class="text-3xl font-bold">Modules</h1>
            <p class="text-sm text-muted-foreground">Liste des modules disponibles.</p>
        </div>

        <div class="flex items-center gap-3">
            {% set _sort = app.request.query.get('sort')|default('date_desc') %}
            {% set _sortLabel = _sort == 'alpha_asc' ? 'A → Z' : (_sort == 'alpha_desc' ? 'Z → A' : 'Date') %}
            <details class="relative">
                <summary class="list-none cursor-pointer inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white border border-border font-semibold hover:bg-muted transition">
                    <i data-lucide="arrow-up-down" class="w-4 h-4"></i>
                    Trier ({{ _sortLabel }})
                </summary>
                <div class="absolute right-0 mt-2 w-56 bg-white border border-border rounded-xl shadow-lg overflow-hidden z-20">
                    <a class="block px-4 py-2.5 text-sm hover:bg-muted/30 transition" href="{{ path('app_module_index', app.request.query.all|merge({'sort': 'date_desc'})) }}">Date (récent)</a>
                    <a class="block px-4 py-2.5 text-sm hover:bg-muted/30 transition" href="{{ path('app_module_index', app.request.query.all|merge({'sort': 'alpha_asc'})) }}">A → Z</a>
                    <a class="block px-4 py-2.5 text-sm hover:bg-muted/30 transition" href="{{ path('app_module_index', app.request.query.all|merge({'sort': 'alpha_desc'})) }}">Z → A</a>
                </div>
            </details>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-border p-8">
        {% if modules|length > 0 %}
            <div class="space-y-3">
                {% for module in modules %}
                    <div class="flex items-center justify-between gap-4 p-4 bg-muted/30 rounded-xl hover:bg-muted/60 transition-colors">
                        <div class="flex items-start gap-3">
                            <i data-lucide="layers" class="w-5 h-5 text-secondary mt-0.5"></i>
                            <div>
                                <h3 class="font-semibold">{{ module.titre }}</h3>
                                {% if module.description %}
                                    <p class="text-sm text-muted-foreground">{{ module.description|slice(0, 140) }}{% if module.description|length > 140 %}...{% endif %}</p>
                                {% endif %}
                                <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                                    <span class="text-muted-foreground bg-white px-2 py-1 rounded border border-border">{{ module.duree }}h</span>
                                    {% if module.niveau %}
                                        <span class="text-muted-foreground bg-white px-2 py-1 rounded border border-border">{{ module.niveau }}</span>
                                    {% endif %}
                                    <span class="text-muted-foreground bg-white px-2 py-1 rounded border border-border">{{ module.actif ? 'Actif' : 'Inactif' }}</span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <a href="{{ path('app_module_show', {'id': module.id}) }}" class="inline-flex items-center gap-2 px-3 py-2 rounded-xl bg-white border border-border font-semibold hover:bg-muted transition">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                                Voir
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="p-4 rounded-xl border border-border bg-muted/20 text-sm text-muted-foreground">Aucun module trouvé.</div>
        {% endif %}
    </div>
{% endblock %}
