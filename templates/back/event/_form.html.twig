{# ======================================================
   JAVASCRIPT - Optimized with Service Pattern
   ====================================================== #}
<script>
(function() {
  'use strict';

  // ===== CONFIGURATION =====
  const CONFIG = {
    routes: {
      aiImprove: '{{ path("back_event_ai_improve") }}',
      predictSuccess: '{{ path("back_ai_predict_success") }}',
      suggestTiming: '{{ path("back_ai_suggest_timing") }}'
    },
    debounceDelay: 800,
    aiHighlightDuration: 4000,
    minDescriptionLength: 10,
    defaultCapacity: 50
  };

  // ===== DOM CACHE =====
  const DOM = {
    // Elements
    magicBtn: document.getElementById('ef-magic-btn'),
    hintBtn: document.getElementById('ef-hint-btn'),
    hintPanel: document.getElementById('ef-hint-panel'),
    hintClose: document.getElementById('ef-hint-close'),
    loadingBar: document.getElementById('ef-loading-bar'),
    insightsEmpty: document.getElementById('ef-insights-empty'),
    insightsContent: document.getElementById('ef-insights-content'),
    scorePill: document.getElementById('ef-score-pill'),
    progressBar: document.getElementById('ef-progress-bar'),
    suggestionsList: document.getElementById('ef-suggestions-list'),
    timingGrid: document.getElementById('ef-timing-grid'),
    autosaveNote: document.getElementById('ef-autosave-note'),

    // Form fields
    fields: {
      titre: document.getElementById('ef-titre'),
      description: document.getElementById('ef-description'),
      lieu: document.getElementById('ef-lieu'),
      categorie: document.getElementById('ef-categorie'),
      capacite: document.getElementById('ef-capacite'),
      prix: document.getElementById('ef-prix'),
      statut: document.getElementById('ef-statut'),
      dateDebut: document.getElementById('ef-dateDebut')
    }
  };

  // ===== UTILITIES =====
  const Utils = {
    debounce(fn, delay) {
      let timer;
      return function(...args) {
        clearTimeout(timer);
        timer = setTimeout(() => fn.apply(this, args), delay);
      };
    },

    async postData(url, data) {
      const formData = new FormData();
      Object.entries(data).forEach(([key, value]) => {
        if (value != null) formData.append(key, value);
      });

      const response = await fetch(url, {
        method: 'POST',
        body: formData
      });

      if (!response.ok) {
        throw new Error(`HTTP error ${response.status}`);
      }
      return response.json();
    },

    highlightField(field) {
      if (!field) return;
      field.classList.add('ai-filled');
      setTimeout(() => {
        field.classList.remove('ai-filled');
      }, CONFIG.aiHighlightDuration);
    },

    setSelectValue(select, value) {
      if (!select || !value) return false;
      
      // Try by value first
      for (const option of select.options) {
        if (option.value === value) {
          select.value = value;
          return true;
        }
      }
      
      // Then by text (case insensitive)
      const searchValue = value.trim().toLowerCase();
      for (const option of select.options) {
        if (option.text.trim().toLowerCase() === searchValue) {
          select.value = option.value;
          return true;
        }
      }
      return false;
    },

    showError(field, message) {
      const existingError = field.parentElement.querySelector('.ef-error');
      if (existingError) existingError.remove();

      const error = document.createElement('div');
      error.className = 'ef-error';
      error.innerHTML = `
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
        ${message}
      `;
      field.parentElement.appendChild(error);
      setTimeout(() => error.remove(), 4000);
    }
  };

  // ===== SERVICES =====
  const AIService = {
    async improveDescription(description) {
      return Utils.postData(CONFIG.routes.aiImprove, { description });
    },

    async predictSuccess(data) {
      return Utils.postData(CONFIG.routes.predictSuccess, data);
    },

    async suggestTiming(category) {
      return Utils.postData(CONFIG.routes.suggestTiming, { category });
    }
  };

  const UIService = {
    setMagicLoading(isLoading) {
      if (!DOM.magicBtn || !DOM.loadingBar) return;

      DOM.magicBtn.disabled = isLoading;
      DOM.loadingBar.classList.toggle('visible', isLoading);

      if (isLoading) {
        DOM.magicBtn.innerHTML = `
          <span class="ef-spinner" style="border-color: rgba(124,58,237,0.3); border-top-color: var(--ef-ai);"></span>
          Analyse...
        `;
      } else {
        DOM.magicBtn.innerHTML = `
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          AI Magic
        `;
      }
    },

    renderScore(score) {
      if (score === undefined) return;

      const isGood = score >= 75;
      const isMedium = score >= 50 && score < 75;

      DOM.scorePill.textContent = `${score}%`;
      DOM.scorePill.className = `ef-gauge-score ${isGood ? 'good' : isMedium ? 'medium' : 'poor'}`;

      DOM.progressBar.style.width = `${score}%`;
      DOM.progressBar.style.background = isGood 
        ? 'var(--ef-success)' 
        : isMedium 
          ? 'var(--ef-warning)' 
          : 'var(--ef-danger)';
    },

    renderSuggestions(suggestions) {
      if (!DOM.suggestionsList) return;

      if (suggestions && suggestions.length > 0) {
        DOM.suggestionsList.innerHTML = `
          <ul class="ef-suggestions-list">
            ${suggestions.map(s => `<li>${s}</li>`).join('')}
          </ul>
        `;
        DOM.suggestionsList.classList.remove('ef-hidden');
      } else {
        DOM.suggestionsList.innerHTML = `
          <div class="ef-success-message">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            Excellent ! Aucun problème détecté.
          </div>
        `;
        DOM.suggestionsList.classList.remove('ef-hidden');
      }
    },

    renderTimingCards(timingData) {
      if (!DOM.timingGrid || !Array.isArray(timingData) || timingData.length === 0) {
        DOM.timingGrid.innerHTML = `
          <div style="grid-column: 1/-1; text-align: center; padding: 1rem; font-size: 0.8rem; color: var(--ef-muted);">
            Aucun créneau recommandé pour cette catégorie
          </div>
        `;
        return;
      }

      DOM.timingGrid.innerHTML = timingData.map((item, index) => {
        const scoreClass = item.score >= 70 ? 'score-high' : item.score >= 40 ? 'score-mid' : 'score-low';
        const conflictHtml = item.conflicts && item.conflicts.length > 0
          ? `<div class="ef-timing-conflict">
               <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                 <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                 <line x1="12" y1="9" x2="12" y2="13" /><line x1="12" y1="17" x2="12.01" y2="17" />
               </svg>
               ${item.conflicts.join(', ')}
             </div>`
          : '';

        return `
          <div class="ef-timing-card ${scoreClass}" style="animation-delay: ${index * 0.05}s">
            <div class="ef-timing-day">${item.day || '—'}</div>
            <div class="ef-timing-slot">${item.slot || '—'}</div>
            <span class="ef-timing-score">Score ${item.score || '—'}</span>
            ${conflictHtml}
          </div>
        `;
      }).join('');
    },

    toggleInsights(hasData) {
      if (!DOM.insightsEmpty || !DOM.insightsContent) return;

      DOM.insightsEmpty.classList.toggle('ef-hidden', hasData);
      DOM.insightsContent.classList.toggle('ef-hidden', !hasData);
    }
  };

  // ===== HANDLERS =====
  const Handlers = {
    async handleMagicClick() {
      const description = DOM.fields.description?.value.trim();

      if (!description || description.length < CONFIG.minDescriptionLength) {
        Utils.showError(
          DOM.fields.description, 
          `Veuillez saisir au moins ${CONFIG.minDescriptionLength} caractères pour l'analyse IA`
        );
        return;
      }

      UIService.setMagicLoading(true);

      try {
        const result = await AIService.improveDescription(description);
        
        // Apply results to fields
        if (result.category) {
          if (Utils.setSelectValue(DOM.fields.categorie, result.category)) {
            Utils.highlightField(DOM.fields.categorie);
          }
        }

        if (result.marketing_hook && DOM.fields.titre?.value.trim().length < 5) {
          DOM.fields.titre.value = result.marketing_hook;
          Utils.highlightField(DOM.fields.titre);
        }

        if (result.suggested_lieu && !DOM.fields.lieu?.value.trim()) {
          DOM.fields.lieu.value = result.suggested_lieu;
          Utils.highlightField(DOM.fields.lieu);
        }

        const currentPrice = parseFloat(DOM.fields.prix?.value);
        if (result.suggested_prix !== undefined && DOM.fields.prix && (!currentPrice || currentPrice === 0)) {
          DOM.fields.prix.value = result.suggested_prix;
          Utils.highlightField(DOM.fields.prix);
        }

        const currentCapacity = parseInt(DOM.fields.capacite?.value);
        if (result.suggested_capacite && DOM.fields.capacite && 
            (!currentCapacity || currentCapacity === CONFIG.defaultCapacity)) {
          DOM.fields.capacite.value = result.suggested_capacite;
          Utils.highlightField(DOM.fields.capacite);
        }

        // Refresh insights after magic
        await Handlers.refreshInsights();
        
        // Show success feedback
        if (DOM.autosaveNote) {
          DOM.autosaveNote.classList.remove('ef-hidden');
          setTimeout(() => DOM.autosaveNote.classList.add('ef-hidden'), 2000);
        }

      } catch (error) {
        console.error('AI Magic error:', error);
        Utils.showError(DOM.fields.description, 'Erreur lors de l\'analyse IA. Veuillez réessayer.');
      } finally {
        UIService.setMagicLoading(false);
      }
    },

    refreshInsights: Utils.debounce(async function() {
      const fields = DOM.fields;
      const hasData = fields.titre?.value.trim().length > 2;

      UIService.toggleInsights(hasData);

      if (!hasData) return;

      // Prepare data for prediction
      const predictionData = {
        titre: fields.titre?.value || '',
        category: fields.categorie?.value || '',
        capacite: fields.capacite?.value || 50,
        prix: fields.prix?.value || 0,
        dateDebut: fields.dateDebut?.value || ''
      };

      try {
        // Parallel API calls
        const [scoreResult, timingResult] = await Promise.allSettled([
          AIService.predictSuccess(predictionData),
          fields.categorie?.value ? AIService.suggestTiming(fields.categorie.value) : Promise.resolve([])
        ]);

        if (scoreResult.status === 'fulfilled' && scoreResult.value) {
          UIService.renderScore(scoreResult.value.total_score);
          UIService.renderSuggestions(scoreResult.value.suggestions);
        }

        if (timingResult.status === 'fulfilled') {
          UIService.renderTimingCards(timingResult.value);
        }

      } catch (error) {
        console.error('Insights refresh error:', error);
      }
    }, CONFIG.debounceDelay)
  };

  // ===== INITIALIZATION =====
  function init() {
    // Magic button
    if (DOM.magicBtn) {
      DOM.magicBtn.addEventListener('click', Handlers.handleMagicClick);
    }

    // Hint modal
    if (DOM.hintBtn && DOM.hintPanel && DOM.hintClose) {
      DOM.hintBtn.addEventListener('click', () => DOM.hintPanel.classList.add('open'));
      DOM.hintClose.addEventListener('click', () => DOM.hintPanel.classList.remove('open'));
      DOM.hintPanel.addEventListener('click', (e) => {
        if (e.target === DOM.hintPanel) DOM.hintPanel.classList.remove('open');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') DOM.hintPanel.classList.remove('open');
      });
    }

    // Watch fields for insights
    const watchFields = [
      DOM.fields.titre,
      DOM.fields.categorie,
      DOM.fields.capacite,
      DOM.fields.prix,
      DOM.fields.dateDebut,
      DOM.fields.statut
    ].filter(Boolean);

    watchFields.forEach(field => {
      field.addEventListener('input', Handlers.refreshInsights);
      field.addEventListener('change', Handlers.refreshInsights);
    });

    // Initial refresh for edit form
    setTimeout(Handlers.refreshInsights, 500);
  }

  // Start when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>