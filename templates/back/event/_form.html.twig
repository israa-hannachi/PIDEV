{# =============================================================
   back/event/_form.html.twig
   Event creation/edit form with integrated AI assistance
   ============================================================= #}

{# ---------- CSS with better organization ---------- #}
<style>
  /* ===== DESIGN TOKENS ===== */
  :root {
    --ef-font: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --ef-primary: #4361ee;
    --ef-primary-hv: #3a56d4;
    --ef-primary-lt: #e9ecfe;
    --ef-success: #10b981;
    --ef-success-lt: #e0f2e9;
    --ef-warning: #f59e0b;
    --ef-warning-lt: #fef3d9;
    --ef-danger: #ef4444;
    --ef-danger-lt: #fee2e2;
    --ef-ai: #7c3aed;
    --ef-ai-lt: #f2ebfe;
    --ef-ai-border: #c7b2fd;
    --ef-text: #1e293b;
    --ef-label: #475569;
    --ef-muted: #64748b;
    --ef-bg: #f8fafc;
    --ef-card: #ffffff;
    --ef-border: #e2e8f0;
    --ef-border-soft: #edf2f7;
    --ef-radius: 16px;
    --ef-radius-sm: 10px;
    --ef-shadow: 0 4px 12px rgba(0,0,0,0.03);
    --ef-shadow-md: 0 8px 20px rgba(0,0,0,0.06);
    --ef-transition: 0.2s ease;
  }

  /* ===== LAYOUT ===== */
  .ef-shell {
    font-family: var(--ef-font);
    color: var(--ef-text);
    background: var(--ef-bg);
    padding: 2rem 0;
  }

  .ef-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .ef-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .ef-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ===== HEADER ===== */
  .ef-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
    padding: 0 1.5rem;
  }

  .ef-header-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--ef-radius-sm);
    background: linear-gradient(135deg, var(--ef-primary), var(--ef-ai));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    box-shadow: 0 8px 16px rgba(67,97,238,0.2);
  }

  .ef-header-content h1 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
  }

  .ef-header-content p {
    font-size: 0.875rem;
    color: var(--ef-muted);
    margin: 0.25rem 0 0;
  }

  /* ===== SECTIONS ===== */
  .ef-section {
    background: var(--ef-card);
    border: 1px solid var(--ef-border);
    border-radius: var(--ef-radius);
    box-shadow: var(--ef-shadow);
    margin-bottom: 1.25rem;
    overflow: hidden;
    transition: box-shadow var(--ef-transition), transform var(--ef-transition);
  }

  .ef-section:hover {
    box-shadow: var(--ef-shadow-md);
  }

  .ef-section:focus-within {
    box-shadow: 0 0 0 3px var(--ef-primary-lt), var(--ef-shadow-md);
  }

  .ef-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--ef-border-soft);
    background: linear-gradient(to right, #fafbfd, #ffffff);
  }

  .ef-section-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
  }

  .ef-section-icon.blue {
    background: var(--ef-primary-lt);
    color: var(--ef-primary);
  }

  .ef-section-icon.green {
    background: var(--ef-success-lt);
    color: var(--ef-success);
  }

  .ef-section-icon.amber {
    background: var(--ef-warning-lt);
    color: var(--ef-warning);
  }

  .ef-section-icon.violet {
    background: var(--ef-ai-lt);
    color: var(--ef-ai);
  }

  .ef-section-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ef-label);
    flex: 1;
  }

  .ef-section-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    background: var(--ef-border-soft);
    border-radius: 100px;
    color: var(--ef-muted);
  }

  .ef-section-body {
    padding: 1.5rem;
  }

  /* ===== FORM CONTROLS ===== */
  .ef-form-group {
    margin-bottom: 1.25rem;
  }

  .ef-form-group:last-child {
    margin-bottom: 0;
  }

  .ef-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ef-label);
    margin-bottom: 0.4rem;
    letter-spacing: 0.01em;
  }

  .ef-label .required {
    color: var(--ef-danger);
    margin-left: 0.2rem;
  }

  .ef-input-wrapper {
    position: relative;
  }

  .ef-input-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ef-muted);
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .ef-input-icon ~ .ef-input {
    padding-left: 2.5rem;
  }

  .ef-input {
    width: 100%;
    background: #fff;
    color: var(--ef-text);
    border: 1.5px solid var(--ef-border);
    border-radius: var(--ef-radius-sm);
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    font-family: var(--ef-font);
    transition: all var(--ef-transition);
    outline: none;
  }

  .ef-input:focus {
    border-color: var(--ef-primary);
    box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.12);
  }

  .ef-input.ai-filled {
    border-color: var(--ef-ai);
    box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.15);
    background-color: var(--ef-ai-lt);
    animation: efPulse 2s infinite ease-in-out;
  }

  @keyframes efPulse {
    0% { box-shadow: 0 0 0 0px rgba(124, 58, 237, 0.3); }
    70% { box-shadow: 0 0 0 10px rgba(124, 58, 237, 0); }
    100% { box-shadow: 0 0 0 0px rgba(124, 58, 237, 0); }
  }

  @keyframes efPop {
    0% { transform: scale(0.98); }
    60% { transform: scale(1.02); }
    100% { transform: scale(1); }
  }

  textarea.ef-input {
    resize: vertical;
    min-height: 120px;
  }

  .ef-error {
    font-size: 0.75rem;
    color: var(--ef-danger);
    margin-top: 0.3rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* ===== AI TOOLBAR ===== */
  .ef-ai-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .ef-ai-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ef-btn-ai {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    background: var(--ef-ai-lt);
    border: 1px solid var(--ef-ai-border);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ef-ai);
    cursor: pointer;
    transition: all var(--ef-transition);
  }

  .ef-btn-ai:hover:not(:disabled) {
    background: var(--ef-ai);
    color: #fff;
    border-color: var(--ef-ai);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);
  }

  .ef-btn-ai:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .ef-btn-ai svg {
    width: 14px;
    height: 14px;
  }

  .ef-btn-help {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--ef-border-soft);
    border: 1px solid var(--ef-border);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--ef-muted);
    cursor: pointer;
    transition: all var(--ef-transition);
  }

  .ef-btn-help:hover {
    background: var(--ef-primary-lt);
    color: var(--ef-primary);
    border-color: var(--ef-primary);
  }

  .ef-loading-indicator {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--ef-ai);
    margin-top: 0.5rem;
    padding: 0.5rem;
    background: var(--ef-ai-lt);
    border-radius: var(--ef-radius-sm);
  }

  .ef-loading-indicator.visible {
    display: flex;
    animation: fadeIn 0.2s ease;
  }

  .ef-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid var(--ef-ai-border);
    border-top-color: var(--ef-ai);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* ===== INSIGHTS PANEL ===== */
  .ef-insights {
    background: var(--ef-card);
    border: 1px solid var(--ef-ai-border);
    border-radius: var(--ef-radius);
    overflow: hidden;
    position: sticky;
    top: 2rem;
  }

  .ef-insights-header {
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, var(--ef-ai-lt) 0%, #fff 100%);
    border-bottom: 1px solid var(--ef-ai-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ef-insights-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--ef-ai);
  }

  .ef-insights-badge {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    background: var(--ef-ai);
    color: #fff;
    border-radius: 100px;
    text-transform: uppercase;
  }

  .ef-insights-body {
    padding: 1.5rem;
  }

  .ef-insights-empty {
    text-align: center;
    padding: 2rem 1rem;
  }

  .ef-insights-empty-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .ef-insights-empty-text {
    font-size: 0.85rem;
    color: var(--ef-muted);
    line-height: 1.6;
  }

  /* Score gauge */
  .ef-gauge {
    margin-bottom: 1.5rem;
  }

  .ef-gauge-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .ef-gauge-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ef-label);
  }

  .ef-gauge-score {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.8rem;
    border-radius: 100px;
  }

  .ef-gauge-score.good {
    background: var(--ef-success-lt);
    color: var(--ef-success);
  }

  .ef-gauge-score.medium {
    background: var(--ef-warning-lt);
    color: var(--ef-warning);
  }

  .ef-gauge-score.poor {
    background: var(--ef-danger-lt);
    color: var(--ef-danger);
  }

  .ef-progress {
    height: 8px;
    background: var(--ef-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .ef-progress-bar {
    height: 100%;
    border-radius: 4px;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.3s ease;
  }

  /* Suggestions */
  .ef-suggestions {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ef-ai-border);
  }

  .ef-suggestions-list {
    margin: 0;
    padding-left: 1.2rem;
    font-size: 0.8rem;
    color: var(--ef-muted);
  }

  .ef-suggestions-list li {
    margin-bottom: 0.4rem;
    line-height: 1.5;
  }

  .ef-suggestions-list li::marker {
    color: var(--ef-ai);
  }

  .ef-success-message {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--ef-success);
  }

  /* Timing cards */
  .ef-timing {
    margin-top: 1.5rem;
  }

  .ef-timing-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ef-label);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .ef-timing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 0.75rem;
  }

  .ef-timing-card {
    background: #fff;
    border: 1.5px solid var(--ef-border);
    border-radius: var(--ef-radius-sm);
    padding: 0.75rem 0.5rem;
    text-align: center;
    transition: all var(--ef-transition);
    animation: fadeInUp 0.3s ease both;
  }

  .ef-timing-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--ef-shadow-md);
  }

  .ef-timing-card.score-high {
    border-color: var(--ef-success);
    background: var(--ef-success-lt);
  }

  .ef-timing-card.score-mid {
    border-color: var(--ef-warning);
    background: var(--ef-warning-lt);
  }

  .ef-timing-card.score-low {
    border-color: var(--ef-danger);
    background: var(--ef-danger-lt);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ef-timing-day {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ef-muted);
    margin-bottom: 0.2rem;
  }

  .ef-timing-slot {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ef-text);
    line-height: 1.3;
  }

  .ef-timing-score {
    display: inline-block;
    margin-top: 0.3rem;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.1rem 0.5rem;
    background: rgba(0, 0, 0, 0.06);
    border-radius: 100px;
  }

  .ef-timing-conflict {
    font-size: 0.65rem;
    color: var(--ef-danger);
    margin-top: 0.3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
  }

  /* ===== ACTIONS ===== */
  .ef-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: linear-gradient(to right, #fafbfd, #ffffff);
    border-top: 1px solid var(--ef-border-soft);
  }

  .ef-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.5rem;
    background: var(--ef-primary);
    color: #fff;
    border: none;
    border-radius: var(--ef-radius-sm);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--ef-transition);
  }

  .ef-btn-primary:hover {
    background: var(--ef-primary-hv);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(67, 97, 238, 0.35);
  }

  .ef-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    background: #fff;
    color: var(--ef-muted);
    border: 1.5px solid var(--ef-border);
    border-radius: var(--ef-radius-sm);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--ef-transition);
    text-decoration: none;
  }

  .ef-btn-secondary:hover {
    border-color: var(--ef-primary);
    color: var(--ef-primary);
    background: var(--ef-primary-lt);
  }

  .ef-autosave-note {
    margin-left: auto;
    font-size: 0.75rem;
    color: var(--ef-muted);
  }

  /* ===== HINT MODAL ===== */
  .ef-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .ef-modal.open {
    display: flex;
    animation: fadeIn 0.2s ease;
  }

  .ef-modal-content {
    background: #fff;
    border-radius: var(--ef-radius);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    padding: 2rem;
    max-width: 440px;
    width: 90%;
    animation: slideUp 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .ef-modal h3 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ef-ai);
  }

  .ef-modal-step {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .ef-step-number {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--ef-ai);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ef-step-text {
    font-size: 0.85rem;
    color: var(--ef-muted);
    line-height: 1.5;
  }

  .ef-step-text strong {
    color: var(--ef-text);
  }

  .ef-modal-close {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    padding: 0.6rem 1.2rem;
    background: var(--ef-ai);
    color: #fff;
    border: none;
    border-radius: var(--ef-radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--ef-transition);
  }

  .ef-modal-close:hover {
    background: #6d28d9;
  }

  /* ===== UTILITIES ===== */
  .ef-row {
    display: grid;
    gap: 1rem;
  }

  .ef-row-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .ef-row-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 640px) {
    .ef-row-2,
    .ef-row-3 {
      grid-template-columns: 1fr;
    }
  }

  .ef-mb-0 {
    margin-bottom: 0;
  }

  .ef-mb-2 {
    margin-bottom: 0.5rem;
  }

  .ef-mb-3 {
    margin-bottom: 1rem;
  }

  .ef-mb-4 {
    margin-bottom: 1.5rem;
  }

  .ef-hidden {
    display: none;
  }
</style>

{# ---------- Google Font import ---------- #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

{# ======================================================
   MAIN FORM
   ====================================================== #}
<div class="ef-shell">
  <div class="ef-container">
    
    {# Header #}
    <div class="ef-header">
      <div class="ef-header-icon">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>
      </div>
      <div class="ef-header-content">
        <h1>{{ button_label is defined and button_label == 'Update' ? 'Modifier l\'événement' : 'Créer un événement' }}</h1>
        <p>Remplissez les informations ci-dessous. L'IA peut vous aider à compléter le formulaire automatiquement.</p>
      </div>
    </div>

    {{ form_start(form, {'attr': {'class': 'ef-form', 'novalidate': 'novalidate', 'id': 'event-form'}}) }}

    <div class="ef-grid">
      
      {# ===== LEFT COLUMN - FORM FIELDS ===== #}
      <div class="ef-form-column">
        
        {# Section: Informations générales #}
        <section class="ef-section">
          <header class="ef-section-header">
            <div class="ef-section-icon blue">
              <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
              </svg>
            </div>
            <h2 class="ef-section-title">Informations générales</h2>
            <span class="ef-section-badge">Étape 1/3</span>
          </header>
          
          <div class="ef-section-body">
            {# Titre #}
            <div class="ef-form-group">
              {{ form_label(form.titre, null, {'label_attr': {'class': 'ef-label'}}) }}
              <div class="ef-input-wrapper">
                <span class="ef-input-icon">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                    <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                  </svg>
                </span>
                {{ form_widget(form.titre, {
                  'attr': {
                    'class': 'ef-input',
                    'placeholder': 'Nom de l\'événement...',
                    'id': 'ef-titre',
                    'data-ai-field': 'title'
                  }
                }) }}
              </div>
              {% if form.titre.vars.errors|length > 0 %}
                <div class="ef-error">
                  <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
