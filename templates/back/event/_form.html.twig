{# =============================================================
   back/event/_form.html.twig
   Premium state-of-the-art form with advanced AI integration
   ============================================================= #}

<style>
    :root {
        --ai-primary: #8b5cf6;
        --ai-primary-soft: rgba(139, 92, 246, 0.1);
        --ai-glow: 0 0 20px rgba(139, 92, 246, 0.2);
    }

    .glass-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 1.25rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .form-control, .form-select {
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        border: 1px solid #e2e8f0;
        transition: all 0.2s;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--ai-primary);
        box-shadow: 0 0 0 3px var(--ai-primary-soft);
    }

    .ai-magic-card {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
        border-radius: 1.25rem;
        color: #fff;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .ai-badge-live {
        background: rgba(139, 92, 246, 0.2);
        color: #a78bfa;
        border: 1px solid rgba(139, 92, 246, 0.3);
        padding: 0.25rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        animation: pulse-live 2s infinite;
    }

    @keyframes pulse-live {
        0% { opacity: 0.8; }
        50% { opacity: 1; box-shadow: 0 0 10px rgba(139, 92, 246, 0.4); }
        100% { opacity: 0.8; }
    }

    .ai-pulse-input {
        animation: ai-glow-pulse 2s infinite ease-in-out;
        border-color: var(--ai-primary) !important;
    }

    @keyframes ai-glow-pulse {
        0% { box-shadow: 0 0 0 0px var(--ai-primary-soft); }
        70% { box-shadow: 0 0 0 10px rgba(139, 92, 246, 0); }
        100% { box-shadow: 0 0 0 0px rgba(139, 92, 246, 0); }
    }

    .progress-ai {
        height: 6px;
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
    }

    .progress-bar-ai {
        border-radius: 10px;
        transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .timing-slot {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 0.75rem;
        padding: 0.75rem;
        transition: all 0.2s;
    }

    .timing-slot:hover {
        background: rgba(255,255,255,0.06);
        border-color: var(--ai-primary);
    }

    .btn-ai-magic {
        background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%);
        color: white;
        border: none;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.3);
        transition: all 0.3s;
    }

    .btn-ai-magic:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(124, 58, 237, 0.4);
        color: white;
    }

    .btn-ai-magic:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .ef-spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(255, 255, 255, 0.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        display: inline-block;
    }

    @keyframes spin { to { transform: rotate(360deg); } }
    
    .hidden-panel { display: none !important; }

    .sticky-panel {
        position: sticky;
        top: 100px;
    }
</style>

{{ form_start(form, {'attr': {'id': 'event-form', 'novalidate': 'novalidate'}}) }}

<div class="row g-4">
    {# Main Form Column #}
    <div class="col-xl-8">
        {# Section 1: Brand & Identity #}
        <div class="glass-card p-4 mb-4 shadow-sm">
            <div class="d-flex align-items-center mb-4">
                <div class="avatar-sm bg-primary-soft text-primary rounded-circle me-3 d-flex align-items-center justify-content-center">
                    <i class="feather-info fs-5"></i>
                </div>
                <h5 class="mb-0 fw-bold">Détails de l'Événement</h5>
            </div>

            <div class="row g-4">
                <div class="col-12">
                    <label class="form-label fw-bold text-dark small text-uppercase">Titre de l'événement</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="feather-type text-muted"></i></span>
                        {{ form_widget(form.titre, {'attr': {'class': 'form-control border-start-0 ps-0', 'id': 'ef-titre', 'placeholder': 'Ex: Sommet de l\'Innovation 2026'}}) }}
                    </div>
                    {{ form_errors(form.titre) }}
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold text-dark small text-uppercase mb-0">Description captivante</label>
                        <button type="button" id="ef-magic-btn" class="btn btn-ai-magic btn-sm rounded-pill px-3">
                            <i class="feather-sparkles me-1"></i> AI Magic Fix
                        </button>
                    </div>
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 6, 'id': 'ef-description', 'placeholder': 'Décrivez votre événement... L\'IA utilisera ces informations pour suggérer le lieu, le prix et prédire la réussite.'}}) }}
                    <div id="ef-loading-bar" class="mt-2 hidden-panel">
                        <div class="d-flex align-items-center text-primary fs-12 italic">
                            <span class="ef-spinner me-2"></span> Analyse sémantique en cours...
                        </div>
                    </div>
                    {{ form_errors(form.description) }}
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small text-uppercase">Localisation / Lieu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="feather-map-pin text-muted"></i></span>
                        {{ form_widget(form.lieu, {'attr': {'class': 'form-control border-x-0 ps-0', 'id': 'ef-lieu', 'placeholder': 'Entrez une adresse ou un lieu'}}) }}
                        <button type="button" id="ef-geocode-btn" class="btn btn-light-brand border-start-0" title="Rechercher les coordonnées">
                            <i class="feather-search"></i>
                        </button>
                    </div>
                    {{ form_errors(form.lieu) }}
                    
                    <div class="row g-2 mt-2">
                        <div class="col-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light fs-10 text-muted">LAT</span>
                                {{ form_widget(form.latitude, {'attr': {'class': 'form-control fs-10 ps-2', 'id': 'ef-latitude'}}) }}
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light fs-10 text-muted">LNG</span>
                                {{ form_widget(form.longitude, {'attr': {'class': 'form-control fs-10 ps-2', 'id': 'ef-longitude'}}) }}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small text-uppercase">Catégorie</label>
                    {{ form_widget(form.categorie, {'attr': {'class': 'form-select', 'id': 'ef-categorie'}}) }}
                    {{ form_errors(form.categorie) }}
                </div>
            </div>
        </div>

        {# Section 2: Logistics & Pricing #}
        <div class="glass-card p-4 shadow-sm">
            <div class="d-flex align-items-center mb-4">
                <div class="avatar-sm bg-success-soft text-success rounded-circle me-3 d-flex align-items-center justify-content-center">
                    <i class="feather-calendar fs-5"></i>
                </div>
                <h5 class="mb-0 fw-bold">Planification & Logistique</h5>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small text-uppercase">Date & Heure de début</label>
                    {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control', 'id': 'ef-dateDebut'}}) }}
                    {{ form_errors(form.dateDebut) }}
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark small text-uppercase">Date & Heure de fin</label>
                    {{ form_widget(form.dateFin, {'attr': {'class': 'form-control', 'id': 'ef-dateFin'}}) }}
                    {{ form_errors(form.dateFin) }}
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold text-dark small text-uppercase">Capacité (Places)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="feather-users text-muted"></i></span>
                        {{ form_widget(form.capacite, {'attr': {'class': 'form-control border-start-0 ps-0', 'id': 'ef-capacite'}}) }}
                    </div>
                    {{ form_errors(form.capacite) }}
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold text-dark small text-uppercase">Prix d'entrée</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">DT</span>
                        {{ form_widget(form.prix, {'attr': {'class': 'form-control border-start-0 ps-0', 'id': 'ef-prix', 'placeholder': '0.00'}}) }}
                    </div>
                    {{ form_errors(form.prix) }}
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold text-dark small text-uppercase">Statut initial</label>
                    {{ form_widget(form.statut, {'attr': {'class': 'form-select', 'id': 'ef-statut'}}) }}
                    {{ form_errors(form.statut) }}
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-4 mb-4">
            <a href="{{ path('back_event_index') }}" class="btn btn-light px-4 rounded-pill">Annuler</a>
            <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm">
                <i class="feather-check-circle me-1"></i> {{ button_label|default('Finaliser l\'Événement') }}
            </button>
        </div>
    </div>

    {# AI Insights Sidebar #}
    <div class="col-xl-4">
        <div class="sticky-panel">
            <div class="ai-magic-card shadow-lg p-0 mb-4">
                <div class="p-4 border-bottom border-white-10">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center">
                            <i class="feather-cpu text-primary me-2 fs-5"></i>
                            <h6 class="mb-0 text-white fw-bold">AI Intelligence</h6>
                        </div>
                        <span class="ai-badge-live">LIVE ANALYTICS</span>
                    </div>
                </div>
                
                <div class="p-4">
                    {# Empty state #}
                    <div id="ef-insights-empty" class="text-center py-5">
                        <div class="display-6 mb-3 text-white-50">🤖</div>
                        <h6 class="text-white mb-2">Assistant IA Prêt</h6>
                        <p class="fs-12 text-white-50 px-4">Saisissez un titre et une description pour activer les prédictions de succès et les conseils stratégiques.</p>
                    </div>

                    {# Active insights #}
                    <div id="ef-insights-content" class="hidden-panel">
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-end mb-2">
                                <span class="fs-11 fw-bold text-white-50 text-uppercase tracking-wider">Score de Réussite Prédit</span>
                                <div class="text-end">
                                    <span id="ef-score-pill" class="display-6 fw-bold text-primary">—</span>
                                    <span class="fs-14 fw-bold text-primary">%</span>
                                </div>
                            </div>
                            <div class="progress progress-ai mb-2">
                                <div id="ef-progress-bar" class="progress-bar progress-bar-ai bg-primary" style="width: 0%"></div>
                            </div>
                            <p class="fs-11 text-white-50 italic">Basé sur l'historique des catégories, le timing et la concurrence.</p>
                        </div>

                        <div id="ef-suggestions-list" class="mb-4 hidden-panel">
                            <h6 class="fs-11 fw-bold text-white-50 mb-3 text-uppercase tracking-wider">
                                <i class="feather-zap text-warning me-1"></i> Optimisations Suggérées
                            </h6>
                            <ul class="list-unstyled mb-0 fs-12" id="ef-suggestions-items"></ul>
                        </div>

                        <div class="timing-section pt-4 border-top border-white-10">
                            <h6 class="fs-11 fw-bold text-white-50 mb-3 text-uppercase tracking-wider">
                                <i class="feather-clock text-info me-1"></i> Créneaux Stratégiques
                            </h6>
                            <div id="ef-timing-grid" class="row g-2">
                                <div class="col-12 text-center py-3 text-white-50 fs-11">
                                    Définissez une catégorie pour voir les créneaux optimaux...
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="glass-card p-3 border-start border-primary border-4 shadow-sm bg-white">
                <div class="d-flex">
                    <div class="flex-shrink-0 avatar-xs bg-primary-soft text-primary rounded d-flex align-items-center justify-content-center">
                        <i class="feather-help-circle fs-13"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h6 class="fs-13 fw-bold mb-1">Besoin d'aide ?</h6>
                        <p class="fs-12 text-muted mb-0">Utilisez <strong>AI Magic Fix</strong> après avoir écrit votre description pour remplir automatiquement les champs techniques.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{ form_end(form) }}

<script>
(function() {
  'use strict';
  
  const CONFIG = {
    routes: {
      aiImprove: '{{ path("back_event_ai_improve") }}',
      predictSuccess: '{{ path("back_ai_predict_success") }}',
      suggestTiming: '{{ path("back_ai_suggest_timing") }}'
    },
    debounceDelay: 1000,
    highlightClass: 'ai-pulse-input',
    highlightDuration: 3000
  };

  const DOM = {
    magicBtn: document.getElementById('ef-magic-btn'),
    loadingBar: document.getElementById('ef-loading-bar'),
    insightsEmpty: document.getElementById('ef-insights-empty'),
    insightsContent: document.getElementById('ef-insights-content'),
    scorePill: document.getElementById('ef-score-pill'),
    progressBar: document.getElementById('ef-progress-bar'),
    suggestionsContainer: document.getElementById('ef-suggestions-list'),
    suggestionsItems: document.getElementById('ef-suggestions-items'),
    timingGrid: document.getElementById('ef-timing-grid'),
    fields: {
      titre: document.getElementById('ef-titre'),
      description: document.getElementById('ef-description'),
      lieu: document.getElementById('ef-lieu'),
      categorie: document.getElementById('ef-categorie'),
      capacite: document.getElementById('ef-capacite'),
      prix: document.getElementById('ef-prix'),
      dateDebut: document.getElementById('ef-dateDebut'),
      latitude: document.getElementById('ef-latitude'),
      longitude: document.getElementById('ef-longitude')
    },
    geocodeBtn: document.getElementById('ef-geocode-btn')
  };

  const API = {
    async post(url, data) {
      const formData = new FormData();
      Object.entries(data).forEach(([k, v]) => v != null && formData.append(k, v));
      
      const res = await fetch(url, { 
        method: 'POST', 
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      
      if (!res.ok) throw new Error('API request failed');
      return res.json();
    }
  };

  const Handlers = {
    highlight(el) {
      if (!el) return;
      el.classList.add(CONFIG.highlightClass);
      setTimeout(() => el.classList.remove(CONFIG.highlightClass), CONFIG.highlightDuration);
    },

    async handleMagic() {
      const desc = DOM.fields.description.value.trim();
      if (desc.length < 2) {
        alert("Veuillez saisir au moins 2 caractères (ex: 'mi', 'dev') pour activer l'IA.");
        return;
      }
      
      DOM.loadingBar.classList.remove('hidden-panel');
      DOM.magicBtn.disabled = true;

      try {
        const res = await API.post(CONFIG.routes.aiImprove, { description: desc });
        
        if (res.titre && DOM.fields.titre.value.trim() === '') {
            DOM.fields.titre.value = res.titre;
            this.highlight(DOM.fields.titre);
        }

        if (res.category && DOM.fields.categorie) {
            for(let opt of DOM.fields.categorie.options) {
                if(opt.text.toLowerCase() === res.category.toLowerCase() || opt.value === res.category) {
                    DOM.fields.categorie.value = opt.value;
                    break;
                }
            }
            this.highlight(DOM.fields.categorie);
        }
        
        if (res.suggested_lieu && DOM.fields.lieu.value.trim() === '') { 
            DOM.fields.lieu.value = res.suggested_lieu; 
            this.highlight(DOM.fields.lieu);
            // Auto-trigger geocoding for the new lieu
            await this.handleGeocode();
        }
        
        if (res.suggested_prix !== undefined && (DOM.fields.prix.value.trim() == '0' || DOM.fields.prix.value.trim() == '')) { 
            DOM.fields.prix.value = res.suggested_prix; 
            this.highlight(DOM.fields.prix); 
        }
        
        if (res.suggested_capacite && (DOM.fields.capacite.value.trim() == '50' || DOM.fields.capacite.value.trim() == '')) { 
            DOM.fields.capacite.value = res.suggested_capacite; 
            this.highlight(DOM.fields.capacite); 
        }

        if (res.suggested_time && DOM.fields.dateDebut) {
            let currentVal = DOM.fields.dateDebut.value;
            let datePart = currentVal && currentVal.includes('T') ? currentVal.split('T')[0] : new Date().toISOString().split('T')[0];
            DOM.fields.dateDebut.value = `${datePart}T${res.suggested_time}`;
            this.highlight(DOM.fields.dateDebut);
            
            if (res.suggested_endtime && DOM.fields.dateFin) {
                DOM.fields.dateFin.value = `${datePart}T${res.suggested_endtime}`;
                this.highlight(DOM.fields.dateFin);
            }
        }
        this.refresh();
      } catch (e) {
        console.error("AI Magic failed", e);
      } finally {
        DOM.loadingBar.classList.add('hidden-panel');
        DOM.magicBtn.disabled = false;
      }
    },

    async handleGeocode() {
      const lieu = DOM.fields.lieu.value.trim();
      if (!lieu) {
        alert("Veuillez saisir un lieu d'abord.");
        return;
      }

      DOM.geocodeBtn.disabled = true;
      const originalHtml = DOM.geocodeBtn.innerHTML;
      DOM.geocodeBtn.innerHTML = '<span class="ef-spinner" style="width: 12px; height: 12px; border-width: 1px;"></span>';

      try {
        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(lieu)}&limit=1`;
        const res = await fetch(url, { headers: { 'Accept-Language': 'fr' } });
        const data = await res.json();

        if (data && data.length > 0) {
          DOM.fields.latitude.value = parseFloat(data[0].lat).toFixed(6);
          DOM.fields.longitude.value = parseFloat(data[0].lon).toFixed(6);
          this.highlight(DOM.fields.latitude);
          this.highlight(DOM.fields.longitude);
          this.refresh();
        } else {
          alert("Lieu non trouvé. Veuillez être plus précis (ex: ville, pays).");
        }
      } catch (e) {
        console.error("Geocoding failed", e);
        alert("Erreur lors de la récupération des coordonnées.");
      } finally {
        DOM.geocodeBtn.innerHTML = originalHtml;
        DOM.geocodeBtn.disabled = false;
      }
    },

    debounce(fn, wait) {
      let t;
      return (...args) => {
        clearTimeout(t);
        t = setTimeout(() => fn.apply(this, args), wait);
      };
    },

    refresh: null // defined in init
  };

  function init() {
    Handlers.refresh = Handlers.debounce(async function() {
      const hasMinData = (DOM.fields.titre.value.trim().length > 3);
      
      DOM.insightsEmpty.classList.toggle('hidden-panel', hasMinData);
      DOM.insightsContent.classList.toggle('hidden-panel', !hasMinData);
      
      if (!hasMinData) return;

      try {
        const [scoreData, timingData] = await Promise.allSettled([
          API.post(CONFIG.routes.predictSuccess, {
            titre: DOM.fields.titre.value,
            category: DOM.fields.categorie.value,
            capacite: DOM.fields.capacite.value,
            prix: DOM.fields.prix.value,
            dateDebut: DOM.fields.dateDebut.value
          }),
          DOM.fields.categorie.value ? API.post(CONFIG.routes.suggestTiming, { category: DOM.fields.categorie.value }) : Promise.reject()
        ]);

        if (scoreData.status === 'fulfilled') {
          const s = scoreData.value;
          DOM.scorePill.textContent = Math.round(s.total_score);
          DOM.progressBar.style.width = s.total_score + '%';
          
          let colorClass = 'bg-danger';
          if (s.total_score > 75) colorClass = 'bg-success';
          else if (s.total_score > 50) colorClass = 'bg-primary';
          else if (s.total_score > 30) colorClass = 'bg-warning';
          
          DOM.progressBar.className = `progress-bar progress-bar-ai ${colorClass}`;

          if (s.suggestions && s.suggestions.length > 0) {
            DOM.suggestionsItems.innerHTML = s.suggestions.map(text => 
              `<li class="mb-2 d-flex align-items-start">
                <i class="feather-chevron-right text-primary me-2 mt-1 fs-10"></i>
                <span class="text-white-50">${text}</span>
              </li>`
            ).join('');
            DOM.suggestionsContainer.classList.remove('hidden-panel');
          } else {
            DOM.suggestionsContainer.classList.add('hidden-panel');
          }
        }

        if (timingData.status === 'fulfilled' && timingData.value.length > 0) {
          DOM.timingGrid.innerHTML = timingData.value.map(t => `
            <div class="col-6">
                <div class="timing-slot">
                    <div class="fs-10 fw-bold text-white-50 mb-1">${t.day.toUpperCase()}</div>
                    <div class="fs-12 fw-bold text-white">${t.slot.charAt(0).toUpperCase() + t.slot.slice(1)}</div>
                    <div class="d-flex align-items-center mt-2">
                        <div class="progress flex-grow-1 progress-ai" style="height: 3px;">
                            <div class="progress-bar bg-info" style="width: ${t.score}%"></div>
                        </div>
                        <span class="fs-9 text-info ms-2">${Math.round(t.score)}%</span>
                    </div>
                </div>
            </div>
          `).join('');
        }
      } catch (e) {
        console.warn("AI refresh partially failed", e);
      }
    }, CONFIG.debounceDelay);

    DOM.magicBtn.addEventListener('click', () => Handlers.handleMagic());
    DOM.geocodeBtn.addEventListener('click', () => Handlers.handleGeocode());

    // Auto-geocode when lieu field loses focus
    if (DOM.fields.lieu) {
      DOM.fields.lieu.addEventListener('blur', () => {
        if (DOM.fields.lieu.value.trim().length > 3) {
          Handlers.handleGeocode();
        }
      });
    }
    
    // Listen for changes
    [DOM.fields.titre, DOM.fields.description, DOM.fields.categorie, DOM.fields.capacite, DOM.fields.prix, DOM.fields.dateDebut].forEach(el => {
      if (!el) return;
      el.addEventListener('input', () => Handlers.refresh());
      el.addEventListener('change', () => Handlers.refresh());
    });

    // Initial check
    setTimeout(() => Handlers.refresh(), 500);
  }

  document.addEventListener('DOMContentLoaded', init);
})();
</script>