</div>

<style>
    .timing-card {
        transition: all 0.2s ease;
        cursor: help;
    }
    .timing-card:hover {
        transform: translateY(-2px);
    }
    .score-green { border-left: 4px solid #10b981 !important; background: #f0fdf4; }
