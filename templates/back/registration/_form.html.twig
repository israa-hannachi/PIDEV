{{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}
    <div class="row g-3">
        <div class="col-md-6">
            <div class="mb-3">
                {{ form_label(form.visitorName, 'Visitor Name', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.visitorName, {'attr': {'class': 'form-control', 'placeholder': 'Enter visitor name'}}) }}
                {{ form_errors(form.visitorName) }}
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                {{ form_label(form.visitorEmail, 'Visitor Email', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.visitorEmail, {'attr': {'class': 'form-control', 'placeholder': 'email@example.com'}}) }}
                {{ form_errors(form.visitorEmail) }}
            </div>
        </div>
        <div class="col-md-12">
            <div class="mb-3">
                {{ form_label(form.paymentMethod, 'Payment Method', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.paymentMethod, {'attr': {'class': 'form-select'}}) }}
                {{ form_errors(form.paymentMethod) }}
            </div>
        </div>
        <div class="col-md-12">
            <div class="mb-3">
                {{ form_label(form.notes, 'Notes', {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.notes, {'attr': {'class': 'form-control', 'placeholder': 'Special requests...', 'rows': 3}}) }}
                {{ form_errors(form.notes) }}
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a href="{{ path('back_registration_index') }}" class="btn btn-light">Cancel</a>
        <button class="btn btn-primary px-4">
            <i class="feather-save me-1"></i> {{ button_label|default('Save Registration') }}
        </button>
    </div>
{{ form_end(form) }}
